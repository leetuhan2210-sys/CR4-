  <div class="mail-card__right">
    <div class="batch-tabs">
      <button class="batch-tab" onclick="pickBatch(this,'c2b1')">Đợt 1</button>
      <button class="batch-tab active" onclick="pickBatch(this,'c2b2')">Đợt 2</button>
    </div>
    <div class="batch-pane" id="c2b1">
      <div class="log-field b1"><label>Phản hồi của khách (AL)</label>
