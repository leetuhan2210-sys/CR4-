    var id = r.ref + '|' + key;
    var bang = m.type === 'log' ? !FG_str(val).trim() : FG_giongNhau(r.v[key], val, m);
    if (bang) { delete FG.dirty[id]; delete FG.conflict[id]; }
    else FG.dirty[id] = { ref: r.ref, key: key, value: val };
    var td = document.getElementById('fgc-' + i + '-' + key);
    if (td) {
      td.classList.toggle('fg-dirty', !bang && !FG.conflict[id]);
      td.classList.toggle('fg-conflict', !!FG.conflict[id]);
    }
    FG_capNhatDem();
