  function nmCopyHeaders() {
    var t = nmVisibleFields().map(function (f) { return f.label; }).join('\t');
    var ok = function () { showToast('Đã copy tiêu đề. Dán vào dòng 1 của Excel, nhập dữ liệu rồi copy cả vùng (kèm tiêu đề) dán lại vào bảng.'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t).then(ok).catch(function () { prompt('Copy dòng dưới đây:', t); });
    } else {
      prompt('Copy dòng dưới đây:', t);
    }
  }

  // ----- Dán từ Excel / Google Sheets -----
  function nmParseTSV(text) {
    text = text.replace(/\r\n?/g, '\n');
    if (text.charAt(text.length - 1) === '\n') text = text.slice(0, -1);
    var rows = [], row = [], cell = '', q = false;
    for (var i = 0; i < text.length; i++) {
      var ch = text.charAt(i);
      if (q) {
        if (ch === '"') {
          if (text.charAt(i + 1) === '"') { cell += '"'; i++; } else q = false;
        } else cell += ch;
      } else if (ch === '"' && cell === '') q = true;
      else if (ch === '\t') { row.push(cell); cell = ''; }
      else if (ch === '\n') { row.push(cell); rows.push(row); row = []; cell = ''; }
      else cell += ch;
    }
    row.push(cell); rows.push(row);
    return rows;
  }

  // Dòng đầu của vùng dán là tiêu đề (>= 2 ô trùng tên cột) → trả về mảng field theo từng cột.
  // Cột tiêu đề không nhận ra (VD "MÃ KM" copy từ sheet) trả về null và bị bỏ qua khi dán.
  function nmHeaderFields(line) {
    var hits = 0;
    var arr = line.map(function (cell) {
      var n = fNorm(cell);
      if (!n) return null;
      var found = null;
      NM.meta.fields.forEach(function (x) {
        if (!found && (fNorm(x.label) === n || (x.header && fNorm(x.header) === n) || fNorm(x.key) === n)) found = x;
      });
      if (found) hits++;
      return found;
    });
    return hits >= 2 ? arr : null;
  }

  function nmOnPaste(e) {
    var t = e.target;
    if (!t.classList || !t.classList.contains('nm-cell')) return;
    var text = (e.clipboardData || window.clipboardData).getData('text');
    if (!text || (text.indexOf('\t') === -1 && text.indexOf('\n') === -1 && text.indexOf('\r') === -1)) return; // 1 ô: để trình duyệt tự dán
    e.preventDefault();

    var matrix = nmParseTSV(text);
    var startIdx = nmRowIndex(t.dataset.id);
    var byHeader = nmHeaderFields(matrix[0]);
    var colFields;
    if (byHeader) {
      matrix.shift();
      colFields = byHeader;
      byHeader.forEach(function (f) { if (f && f.group !== 'core') NM.show[f.group] = true; });
    } else {
      var vis = nmVisibleFields();
      var sc = 0;
      vis.forEach(function (f, i) { if (f.key === t.dataset.key) sc = i; });
      var maxLen = 0;
      matrix.forEach(function (l) { if (l.length > maxLen) maxLen = l.length; });
      colFields = [];
      for (var c = 0; c < maxLen; c++) colFields.push(vis[sc + c] || null);
    }

    while (NM.rows.length < startIdx + matrix.length) NM.rows.push(nmNewRow());
    var dropped = 0;
    matrix.forEach(function (line, r) {
      line.forEach(function (val, c) {
        var f = colFields[c];
        if (!f) { if ((val || '').trim()) dropped++; return; }
        NM.rows[startIdx + r][f.key] = nmMatch(f, val);
      });
    });
    NM.issues = {};
    NM.rows.forEach(function (r) { nmTuDienCap(r, NM.fDanhXung); nmTuDienCap(r, NM.fTitle); nmChuanHoaLV(r); });
    nmEnsureBlankRows(2);
    nmRenderAll();    
    nmSaveDraft();
    showToast('Đã dán ' + matrix.length + ' dòng' + (byHeader ? ' (tự ghép cột theo tiêu đề)' : '') +
      (dropped ? ', bỏ qua ' + dropped + ' ô không khớp cột nào' : '') + '. Bấm "Kiểm tra" trước khi lưu.');
  }

  // ----- Sự kiện chung cho mọi ô trong bảng (đăng ký 1 lần) -----
  document.addEventListener('input', function (e) {
    var t = e.target;
    if (!t.classList || !t.classList.contains('nm-cell')) return;
    var r = nmRowById(t.dataset.id);
    if (!r) return;
    r[t.dataset.key] = t.value;
    var td = t.parentNode;
    if (td) { td.classList.remove('nm-err', 'nm-warn'); td.removeAttribute('title'); }
    if (t.dataset.key === 'pic') {
      var ht = document.querySelector('.nm-cell[data-id="' + t.dataset.id + '"][data-key="hoTro"]');
      if (ht) ht.setAttribute('list', nmHoTroList(r));
    }
    if (t.dataset.key === 'linhVuc' && nmLV()) {
      var sc = document.querySelector('.nm-cell[data-id="' + t.dataset.id + '"][data-key="subSector"]');
      if (sc) { sc.setAttribute('list', nmSubList(r)); sc.placeholder = nmGiaTri({ linhVuc: r.linhVuc }, NM.byKey.subSector); }
    }
    nmDanhDauThieu(t.dataset.id);
    nmSaveDraftSoon();
    nmUpdateCount();
  });
  document.addEventListener('focusout', function (e) {
    var t = e.target;
    if (!t.classList || !t.classList.contains('nm-cell')) return;
    var r = nmRowById(t.dataset.id);
    var f = NM.byKey[t.dataset.key];
    if (!r || !f) return;
    var v = nmMatch(f, t.value);
    if (v !== t.value) { t.value = v; r[t.dataset.key] = v; nmSaveDraftSoon(); }
    nmTuDienCap(r, f);
    if ((f.key === 'linhVuc' || f.key === 'subSector') && nmLV()) {
      if (nmChuanHoaLV(r)) nmSaveDraftSoon();
      nmVeLaiLV(r);
      nmDanhDauThieu(r._id); nmUpdateCount();
    }
  });

  document.addEventListener('paste', nmOnPaste);

  // ----- Bấm vào ô Lĩnh vực / Sub-sector (bảng hoặc Giá trị chung) để chọn nhiều -----
  var NM_O_LV = '.nm-cell[data-key="linhVuc"], .nm-cell[data-key="subSector"], #nmc-linhVuc, #nmc-subSector';
  function nmMoChonLV(el) {
    var lv = nmLV();
    if (!lv) return;
    var key = el.dataset.key || (el.id === 'nmc-linhVuc' ? 'linhVuc' : 'subSector');
    var row = el.dataset.id ? nmRowById(el.dataset.id) : NM.common;
    if (!row) return;
    var groups;
    if (key === 'linhVuc') groups = [{ title: '', opts: lv.sectors }];
    else {
      var secs = waTach(nmGiaTri(row, NM.fLinhVuc || NM.byKey.linhVuc)).filter(function (s) { return lv.subs[s]; });
      if (!secs.length) secs = lv.sectors;               // chưa chọn Lĩnh vực: hiện tất cả, chia theo Lĩnh vực
      groups = secs.map(function (s) { return { title: s, opts: lv.subs[s] || [] }; });
    }
    waMoChonNhieu(el, groups, waTach(el.value), function (arr) {
      var val = arr.join(', ');
      el.value = val;
      if (row === NM.common) { nmCommonChange(key, el); return; }
      row[key] = val;
      if (key === 'linhVuc' && row.subSector) {
        var pool = nmSubsCuaNhieu(nmGiaTri(row, NM.fLinhVuc || NM.byKey.linhVuc));
        row.subSector = waGop(waTach(row.subSector).filter(function (b) { return nmTimTrongDs(pool, b); }));
      }
      if (key === 'subSector') nmChuanHoaLV(row);
      var td = el.parentNode;
      if (td) { td.classList.remove('nm-err', 'nm-warn'); td.removeAttribute('title'); }
      nmVeLaiLV(row); nmDanhDauThieu(row._id); nmUpdateCount(); nmSaveDraftSoon();
    });
  }
  function nmMoSdt(el) {
    var row = nmRowById(el.dataset.id);
    if (!row) return;
    waMoSdt(el, row.sdt || '', function (val) {
      val = val.split('\n').join('; ');
      el.value = val; row.sdt = val;
      var td = el.parentNode;
      if (td) { td.classList.remove('nm-err', 'nm-warn'); td.removeAttribute('title'); }
      nmDanhDauThieu(row._id); nmUpdateCount(); nmSaveDraftSoon();
