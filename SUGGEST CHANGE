  <button class="tab-btn" data-tab="processing">🗂️ Mail đang xử lý <span class="badge warn" id="processingCount" style="display:none">0</span> <span class="kbd-hint">Alt+3</span></button>
  <button class="tab-btn" data-tab="unknown">❓ Chưa xác định <span class="badge muted" id="unknownCount" style="display:none">0</span> <span class="kbd-hint">Alt+4</span></button>
  <button class="tab-btn" data-tab="filter">🎯 Bộ lọc <span class="kbd-hint">Alt+5</span></button>
