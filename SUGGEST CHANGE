  function saveChanges() {
    if (!currentGuest) return;
    var rootSdt = document.getElementById(window.WA_DETAIL_ROOT || 'detailPanel');
    if (rootSdt && rootSdt.querySelector('.sdt-box .sdt-row.loi')) {
      showError('saveError', 'Số điện thoại chưa đúng định dạng (+mã quốc gia) số. Sửa các ô tô đỏ rồi lưu lại.');
      return;
    }    
    var root = '#' + (window.WA_DETAIL_ROOT || 'detailPanel');
    var sel = [' .f.changed input[data-col]:not([type=checkbox])', ' .f.changed textarea[data-col]', ' .f.changed select[data-col]']
      .map(function (s) { return root + s; }).join(', ');
    var changedEls = document.querySelectorAll(sel);
    if (!changedEls.length) { showToast('Không có gì thay đổi.'); return; }
    var updates = Array.prototype.map.call(changedEls, function (el) {
      var u = { col: parseInt(el.dataset.col, 10), value: el.value };
      // Ngày/Giờ phản hồi gần nhất do hệ thống tự tính nên không so xung đột.
      if (!el.closest('.reply-meta')) {
        var goc = currentGuest.original[el.dataset.col];
        u.old = (goc === null || goc === undefined) ? '' : String(goc);
      }
      return u;
    });

    var ref = currentGuest.ref || currentGuest.maKM;
    var trongKhung = window.WA_DETAIL_ROOT === 'drawerBody';
    var btn = document.getElementById('btnSave');
    var originalLabel = btn.innerHTML;
    btn.classList.remove('done');
    btn.classList.add('btn-saving');
    btn.innerHTML = 'Đang lưu…';

    gs('WA_updateGuestFields', ref, updates).then(function (kq) {
      var xung = (kq && kq.conflicts) || [];
      btn.classList.add('done');
      btn.innerHTML = xung.length ? '⚠️ Đã lưu một phần' : '✅ Đã lưu — có thể thoát trang';
      showToast('Đã lưu ' + ((kq && kq.updated) || 0) + ' trường.');
      if (xung.length) {
        alert('Có ' + xung.length + ' trường KHÔNG được lưu vì người khác vừa sửa:\n\n' +
          xung.map(function (c) {
            var cat = function (s) { s = String(s == null ? '' : s); return s.length > 100 ? s.slice(0, 99) + '…' : s; };
            return '• ' + c.label + ': hiện là "' + cat(c.current) + '" (anh/chị định đổi thành "' + cat(c.attempted) + '")';
          }).join('\n') +
          '\n\nHồ sơ sẽ tải lại giá trị mới nhất, anh/chị kiểm tra rồi sửa lại nếu cần.');
      }
      setTimeout(function () {
        if (trongKhung) { openGuestDrawer(ref); FG_lamMoiDong([ref]); }
        else selectGuest(ref);
      }, 600);
    }).catch(function (err) {
      btn.classList.remove('btn-saving', 'done');
      btn.innerHTML = originalLabel;
      showError('saveError', err);
      document.getElementById('saveError').scrollIntoView({behavior:'smooth', block:'center'});
    });
  }

