  </div>
  <div class="mail-card__left">
    <dl class="meta-grid">
      <dt>Khách mời</dt><dd><strong>Dato' Rais Hussin</strong></dd>
      <dt>Đơn vị</dt><dd>MyDigital Corporation</dd>
      <dt>Phụ trách</dt><dd><span class="chip pic">👤 Wendy</span></dd>
