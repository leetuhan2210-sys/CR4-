  // ---------- lưu ----------
  function FG_luu() {
    var ds = Object.keys(FG.dirty).map(function (id) {
      var d = FG.dirty[id], r = FG_timRow(d.ref);
      return { ref: d.ref, hoTen: r ? r.hoTen : '', key: d.key, oldValue: r ? r.v[d.key] : '', newValue: d.value };
    });
    if (!ds.length) { showToast('Không có gì thay đổi.'); return; }
    var btn = document.getElementById('fgSaveBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = 'Đang lưu…'; }

    gs('WA_saveGridEdits', ds).then(function (kq) {
      var giuLai = {};
      FG.conflict = {};
      (kq.conflicts || []).forEach(function (c) { giuLai[c.ref + '|' + c.key] = true; FG.conflict[c.ref + '|' + c.key] = true; });
      (kq.errors || []).forEach(function (e) { giuLai[e.ref + '|' + e.key] = true; });
      Object.keys(FG.dirty).forEach(function (id) { if (!giuLai[id]) delete FG.dirty[id]; });

      var mas = [];
      ds.forEach(function (d) { if (mas.indexOf(d.ref) === -1) mas.push(d.ref); });
      return gs('WA_getGridRows', mas).then(function (rows) {
        FG_thayRows(rows);
        FG.msg = FG_htmlKetQua(kq);
        FG_render();
        showToast('Đã lưu ' + kq.saved + ' ô vào sheet.');
      });
    }).catch(function (err) {
      if (btn) { btn.disabled = false; btn.innerHTML = '💾 Lưu tất cả'; }
      showError('filterError', err);
    });
  }

