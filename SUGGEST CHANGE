/* ===== TAB THÊM KM MỚI ===== */
.nm-toolbar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px; }
.nm-toolbar .spacer { flex:1; }
.nm-toolbar-label { font-size:12px; font-weight:600; color:var(--ink-soft); }
.nm-chip { display:inline-flex; align-items:center; gap:5px; font-size:12.5px; font-weight:600; color:var(--ink); background:#fff; border:1px solid var(--line); border-radius:20px; padding:4px 11px; cursor:pointer; }
.nm-chip:has(input:checked) { background:var(--teal-light); border-color:var(--teal-700); color:var(--teal-800); }
.nm-grid-wrap { overflow:auto; max-height:62vh; border:1px solid var(--line); border-radius:8px; background:#fff; }
