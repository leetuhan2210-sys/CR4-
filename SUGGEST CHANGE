.fchip.clear { background: #fff; color: var(--ink-soft); border-color: var(--line); padding: 5px 13px; cursor: pointer; }
.fchip.clear:hover { border-color: var(--danger); color: var(--danger); }

/* Hộp gợi ý khi lọc ra 0 kết quả */
.f0 { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--warn); border-radius: 10px; padding: 18px 22px; font-size: 15px; }
