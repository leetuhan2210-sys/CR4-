.tab-btn .kbd-hint { font-size: 11px; font-weight: 700; color: var(--ink-soft); background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; margin-left: 5px; }
.tab-btn.active .kbd-hint { color: var(--teal-800); border-color: #BEDCF2; background: var(--teal-light); }
button.btn { padding: 10px 18px; font-size: 15px; border-radius: 7px; }
.btn-sm { padding: 7px 13px; font-size: 13.5px; }
.btn-block { padding: 13px 18px; font-size: 16px; }
.ui-input, .ui-select, textarea.ui-textarea { padding: 10px 12px; font-size: 15.5px; border-radius: 7px; }
.f label { font-size: 13px; }
.f .val, .f .auto-val { font-size: 15.5px; }
.search-bar input { padding: 14px 18px; font-size: 17px; }
.result-item { padding: 15px 18px; }
.result-item .name { font-size: 16.5px; }
.result-item .meta { font-size: 14px; }
.panel-card { padding: 20px 22px; border-radius: 12px; }
.panel-card h2, .panel-card h3 { font-size: 15px; }
.empty-state { font-size: 15px; }

/* Mắt quét NGANG: các ô trong một khối rải đều theo chiều ngang rồi mới xuống dòng */
.grid-2, .grid-3 { grid-template-columns: repeat(auto-fit, minmax(265px, 1fr)); gap: 14px 22px; }
.profile-layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 22px; }
@media (max-width: 1180px) { .profile-layout { grid-template-columns: 1fr; } }
.identity h1 { font-size: 32px; }
.role-line { font-size: 16px; }
.detail-tab-btn { font-size: 15px; padding: 12px 18px; }
.km-chinh-grid { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); font-size: 15px; }
.collapsible.open { max-height: 900px; }

/* ---- BỘ LỌC ---- */
.filter-grid { grid-template-columns: repeat(auto-fit, minmax(235px, 1fr)); gap: 14px 20px; }
.fbatch .filter-grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.ff label, .fm label { font-size: 13px; }
.fm-btn { padding: 10px 12px; font-size: 15px; }
.fp-btn { padding: 9px 16px; font-size: 14px; }
.fsec-head { font-size: 14px; }
.fsec-desc { font-size: 13.5px; }
.filter-stats { font-size: 14px; }
table.ftable { font-size: 14px; }
table.ftable th { padding: 11px 12px; font-size: 13px; }
table.ftable td { padding: 11px 12px; }
.ftable-wrap { max-height: 70vh; }
.fpill { font-size: 12.5px; padding: 2px 9px; }

/* Ô tìm + số lượng trong dropdown nhiều lựa chọn */
.fm-pop { max-width: 430px; max-height: 360px; padding: 8px; }
.fm-tools { display: flex; gap: 6px; margin-bottom: 7px; position: sticky; top: -8px; background: #fff; padding-top: 2px; }
.fm-tools input { flex: 1; min-width: 0; padding: 7px 9px; border: 1px solid var(--line); border-radius: 6px; font-size: 14px; }
.fm-tools button { border: 1px solid var(--line); background: #fff; border-radius: 6px; font-size: 12.5px; font-weight: 600; padding: 0 9px; cursor: pointer; color: var(--ink-soft); white-space: nowrap; }
.fm-tools button:hover { border-color: var(--teal-700); color: var(--teal-800); }
.fm-opt { font-size: 14.5px; padding: 6px 8px; }
.fm-opt span.n { margin-left: auto; padding-left: 12px; font-size: 12.5px; font-weight: 700; color: var(--ink-soft); }
.fm-opt.zero span, .fm-opt.zero span.n { color: #A7B0AA; }
.fm-opt.hid { display: none; }
.fm-opt.trong > span:first-of-type { font-style: italic; color: var(--ink-soft); }

/* Chip tiêu chí đang bật */
.fchips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
.fchips:empty { display: none; }
.fchip { display: inline-flex; align-items: center; gap: 7px; background: var(--teal-light); color: var(--teal-800); border: 1px solid #BEDCF2; border-radius: 20px; padding: 5px 8px 5px 13px; font-size: 13.5px; font-weight: 600; }
.fchip button { border: none; background: rgba(0,0,0,.08); color: inherit; border-radius: 50%; width: 20px; height: 20px; line-height: 1; cursor: pointer; font-size: 13px; padding: 0; }
