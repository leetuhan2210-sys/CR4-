.nm-mgr ul { margin:8px 0 2px; padding-left:20px; }
.nm-mgr li { margin:3px 0; }
.nm-mgr .nm-mgr-h { font-weight:700; margin-top:8px; }
.nm-old { font-size:11px; color:var(--ink-soft); font-style:italic; }

/* ============================================================
   v4 — PHÓNG TO TOÀN BỘ + BỐ CỤC ĐỌC NGANG (TRÁI → PHẢI)
   Khối này nằm CUỐI <style> nên đè lên mọi quy tắc phía trên.
   ============================================================ */
html { font-size: 16px; }
body { font-size: 16px; line-height: 1.55; }
.wrap { max-width: 1760px; padding: 26px 28px 90px; }
