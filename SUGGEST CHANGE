  function FG_apBulk() {
    var m = FG.metaByKey[FG.bulkKey];
    var inp = document.getElementById('fgBulkInput');
    if (!m || !inp) return;
    var val;
    if (m.type === 'checkbox') val = inp.value === '1';
    else if (m.type === 'multi') val = Array.prototype.map.call(inp.querySelectorAll('input:checked'), function (c) { return c.value; }).join(', ');
    else val = inp.value;
    if (m.type === 'log' && !FG_str(val).trim()) { showToast('Nhập nội dung trước khi áp dụng.'); return; }
