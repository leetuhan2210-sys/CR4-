  // Cập nhật TẠI CHỖ, không vẽ lại bảng: sự kiện change chạy đúng lúc user rời ô này để bấm vào
  // 1 ô trong bảng, vẽ lại bảng lúc đó sẽ làm ô vừa bấm mất con trỏ và chữ gõ tiếp bị lạc.
  function nmCommonChange(key, el) {
    var v = nmMatch(NM.byKey[key], el.value);
    el.value = v;
    NM.common[key] = v;
    document.querySelectorAll('.nm-cell[data-key="' + key + '"]').forEach(function (i) { i.placeholder = v; });
