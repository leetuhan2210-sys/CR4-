  }

  function nmIssueMsgs(iss, key, kind) {
    if (!iss) return [];
    return iss[kind].filter(function (x) { return x.key === key; }).map(function (x) { return x.msg; });
  }

  function nmRenderGrid() {
    var el = document.getElementById('nmGrid');
    if (!el) return;
    var cols = nmVisibleFields();
    var tones = cols.map(nmTone);
    // Dải tên nhóm phía trên tiêu đề: gộp các cột liền nhau cùng nhóm màu
    var band = '<tr class="nm-band"><th class="nm-idx"></th>', i0 = 0;
    while (i0 < cols.length) {
      var i1 = i0;
      while (i1 + 1 < cols.length && tones[i1 + 1] === tones[i0]) i1++;
      band += '<th class="tone-' + tones[i0] + '" colspan="' + (i1 - i0 + 1) + '"><span>' + escapeHtml(NM_TONE_LABEL[tones[i0]]) + '</span></th>';
      i0 = i1 + 1;
    }
    band += '<th class="tone-system"></th></tr>';
    var head = band + '<tr class="nm-head"><th class="nm-idx">#</th>' + cols.map(function (f, ci) {
      var tip = (f.hint ? f.hint + ' · ' : '') + 'Cột ' + (f.colLetter || '') + ' trên sheet TEST';
      return '<th class="tone-' + tones[ci] + (f.required ? ' req' : '') + '" title="' + escapeHtml(tip) + '">' + escapeHtml(f.label) +
        '<span class="nm-col">' + escapeHtml(f.colLetter || '') + '</span></th>';
    }).join('') + '<th class="tone-system"></th></tr>';

    var body = NM.rows.map(function (r, i) {
      var iss = NM.issues[r._id] || null;
      var has = nmRowHasData(r);
      var st = '';
      if (iss) {
        if (iss.errors.length) st = '<span class="nm-st err" title="Có lỗi">✖</span>';
        else if (iss.warnings.length) st = '<span class="nm-st warn" title="Có cảnh báo">⚠</span>';
        else st = '<span class="nm-st ok" title="Hợp lệ">✓</span>';
      }
      return '<tr data-id="' + r._id + '"><td class="nm-idx">' + (i + 1) + st + '</td>' +
        cols.map(function (f, ci) {
          var errs = nmIssueMsgs(iss, f.key, 'errors'), warns = nmIssueMsgs(iss, f.key, 'warnings');
          var cls = 'tone-' + tones[ci] + (ci > 0 && tones[ci] !== tones[ci - 1] ? ' nm-grpstart' : '') + ' ' +
            (errs.length ? 'nm-err' : (warns.length ? 'nm-warn' : (has && nmThieu(r, f) ? 'nm-miss' : '')));
          var tip = errs.concat(warns).join(' | ');
          return '<td class="' + cls + '"' + (tip ? ' title="' + escapeHtml(tip) + '"' : '') + '>' +
            '<input class="nm-cell' + (NM_WIDE.indexOf(f.key) !== -1 ? ' w-lg' : '') + '" data-id="' + r._id + '" data-key="' + f.key + '"' +
            ' value="' + escapeHtml(r[f.key] || '') + '"' + nmListAttr(f, r) +
            ' placeholder="' + escapeHtml(f.common ? nmGiaTri({ linhVuc: r.linhVuc }, f) : '') + '" autocomplete="off"></td>';
        }).join('') +
        '<td class="nm-act"><button class="nm-rowbtn" title="Nhân bản dòng này" onclick="nmDupRow(' + r._id + ')">⧉</button>' +
        '<button class="nm-rowbtn" title="Xoá dòng" onclick="nmDelRow(' + r._id + ')">✕</button></td></tr>';
    }).join('');

    el.innerHTML = '<div class="nm-grid-wrap"><table class="nm-grid"><thead>' + head + '</thead><tbody>' + body + '</tbody></table></div>';
    nmRenderIssues();
    nmUpdateCount();
  }

  function nmRenderIssues() {
    var el = document.getElementById('nmIssues');
    if (!el) return;
    var errs = [], warns = [];
    NM.rows.forEach(function (r, i) {
      var iss = NM.issues[r._id];
      if (!iss) return;
      iss.errors.forEach(function (x) { errs.push('<li class="err"><strong>Dòng ' + (i + 1) + ':</strong> ' + escapeHtml(x.msg) + '</li>'); });
      iss.warnings.forEach(function (x) { warns.push('<li class="warn"><strong>Dòng ' + (i + 1) + ':</strong> ' + escapeHtml(x.msg) + '</li>'); });
    });
    var all = errs.concat(warns);
    el.innerHTML = all.length ? '<ul class="nm-issues">' + all.join('') + '</ul>' : '';
  }

  function nmUpdateCount() {
    if (!NM.meta) return;
    var n = NM.rows.filter(nmRowHasData).length;
    var thieu = n ? nmDemThieu() : 0;
