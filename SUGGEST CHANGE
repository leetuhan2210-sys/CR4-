td.fg-ck, th.fg-ck { width:34px; text-align:center; }
.fg-name { color:var(--teal-800); font-weight:600; text-decoration:none; }
.fg-name:hover { text-decoration:underline; }
.fg-more { text-align:center; margin:12px 0; }
.fg-savebar { position:sticky; bottom:0; z-index:20; display:none; align-items:center; gap:10px; background:var(--teal-900); color:#fff; border-radius:10px; padding:10px 14px; margin-top:12px; box-shadow:0 -4px 16px rgba(0,0,0,.12); }
.fg-savebar.show { display:flex; }
.fg-savebar .grow { flex:1; font-size:13px; }
.fg-pop { position:absolute; z-index:60; display:none; min-width:200px; max-width:320px; max-height:260px; overflow-y:auto; background:#fff; border:1px solid var(--line); border-radius:8px; box-shadow:0 8px 20px rgba(0,0,0,.14); padding:6px; }
.fg-pop.show { display:block; }
.note-box { background:var(--teal-light); color:var(--teal-900); border-radius:8px; padding:10px 14px; margin-bottom:10px; font-size:13px; }

/* ===== KHUNG HỒ SƠ BÊN CẠNH ===== */
.drawer-backdrop { display:none; position:fixed; inset:0; background:rgba(18,49,44,.15); z-index:70; }
.drawer-backdrop.show { display:block; }
.drawer { position:fixed; top:0; right:0; bottom:0; width:min(540px,100vw); background:var(--paper); box-shadow:-8px 0 24px rgba(0,0,0,.18); z-index:71; transform:translateX(100%); transition:transform .22s ease; display:flex; flex-direction:column; }
.drawer.show { transform:translateX(0); }
.drawer-head { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#fff; border-bottom:1px solid var(--line); }
