  // Giống hệt WA_vietHoa_ ở WA_Code.gs
  function nmVietHoa(s, kieu) {
    s = (s === null || s === undefined) ? '' : s.toString().replace(/\s+/g, ' ').trim();
    if (!s || !/\p{L}/u.test(s)) return s;
    var toanHoa = (s === s.toUpperCase()), toanThuong = (s === s.toLowerCase());
    if (kieu !== 'ten' && !toanHoa && !toanThuong) return s;
    var noi = (kieu === 'tuEN') ? NM_TU_NOI_EN : (kieu === 'tuVN' ? NM_TU_NOI_VN : {});
    var dem = 0;
    return s.replace(/[\p{L}\p{M}\p{N}]+/gu, function (w) {
      var dau = (dem++ === 0);
      var thuong = w.toLowerCase(), hoa = w.toUpperCase();
      var cap = hoa.charAt(0) + thuong.slice(1);
      if (kieu === 'ten') {
        if (w === hoa || w === thuong) return cap;
        return (w.charAt(0) === w.charAt(0).toLowerCase()) ? cap : w;
      }
      if (NM_GIU_IN_HOA[hoa] || /\d/.test(w)) return hoa;
      if (!dau && noi[thuong]) return thuong;
      return cap;
    });
  }

  // Bỏ qua các cột thuộc nhóm Đợt 1/Đợt 2 (có cột cũng tên "Phụ trách").
  function nmTimTruong(ten) {
    var n = fNorm(ten), kq = null;
    NM.meta.fields.forEach(function (f) {
      if (kq || f.group === 'dot1' || f.group === 'dot2') return;
      if (fNorm(f.header) === n || fNorm(f.label) === n) kq = f;
    });
    return kq;
  }

  function nmNapCap(pairs) {
    if (!pairs || !pairs.length) return null;
    var o = { dxToTitle: {}, titleToDx: {} };
    function them(bang, k, v) { bang[k] = bang[k] || []; if (bang[k].indexOf(v) === -1) bang[k].push(v); }
    pairs.forEach(function (p) { them(o.dxToTitle, fNorm(p[0]), p[1]); them(o.titleToDx, fNorm(p[1]), p[0]); });
    return o;
  }

  function nmCaiQuyTacBoSung() {
    NM_BAT_BUOC_THEM.forEach(function (ten) { var f = nmTimTruong(ten); if (f) f.required = true; });
    Object.keys(NM_VIET_HOA).forEach(function (ten) { var f = nmTimTruong(ten); if (f) f.vietHoa = NM_VIET_HOA[ten]; });
    NM.fDoiTuong = nmTimTruong('Đối tượng');
    NM.fLinhVuc = nmTimTruong('Lĩnh vực');
    NM.fDanhXung = nmTimTruong('Danh xưng');
    NM.fTitle = nmTimTruong('Title');
    if (NM.fLinhVuc) NM.fLinhVuc.hint = 'Bắt buộc, trừ khi Đối tượng là WEF / C4IR / Tổ chức quốc tế / Cơ quan hợp tác và phát triển, hoặc là KM phụ. Bấm vào ô để chọn nhiều.';
    ['linhVuc', 'subSector'].forEach(function (k) { if (NM.byKey[k]) NM.byKey[k].multi = true; });    
  }

  // Tự điền vế còn lại khi cặp chỉ có 1 lựa chọn (VD gõ "Ông" → Title tự thành "Mr.").
  function nmTuDienCap(r, f) {
    if (!NM.capDX || !NM.fDanhXung || !NM.fTitle || !f) return;
    var nguon, dich, bang;
    if (f === NM.fDanhXung) { nguon = NM.fDanhXung; dich = NM.fTitle; bang = NM.capDX.dxToTitle; }
    else if (f === NM.fTitle) { nguon = NM.fTitle; dich = NM.fDanhXung; bang = NM.capDX.titleToDx; }
    else return;
    var v = (r[nguon.key] || '').toString().trim();
    if (!v || (r[dich.key] || '').toString().trim()) return;
    var ds = bang[fNorm(v)];
    if (!ds || ds.length !== 1) return;
    r[dich.key] = ds[0];
    var el = document.querySelector('.nm-cell[data-id="' + r._id + '"][data-key="' + dich.key + '"]');
    if (el) el.value = ds[0];
    nmDanhDauThieu(r._id); nmUpdateCount(); nmSaveDraftSoon();
  }

  function nmLoiCapDanhXung(r) {
    if (!NM.capDX || !NM.fDanhXung || !NM.fTitle) return null;
    var dx = nmGiaTri(r, NM.fDanhXung), tt = nmGiaTri(r, NM.fTitle);
    if (!dx || !tt) return null;
    var hopLe = NM.capDX.dxToTitle[fNorm(dx)];
    if (!hopLe) return null;
    var ok = hopLe.some(function (x) { return fNorm(x) === fNorm(tt); });
    return ok ? null : { key: NM.fTitle.key, msg: 'Danh xưng "' + dx + '" phải đi với Title: ' + hopLe.join(' / ') + ' (đang nhập "' + tt + '")' };
  }

  function nmInit() {
    if (NM.meta) return;
    document.getElementById('nmError').innerHTML = '';
    Promise.all([
      gs('WA_getNewGuestFormMeta'),
      gs('WA_getCapDanhXungTitle').catch(function () { return null; })
    ]).then(function (kq) {
      var meta = kq[0];
      NM.meta = meta;
      NM.byKey = {};
      meta.fields.forEach(function (f) { NM.byKey[f.key] = f; });
      NM.capDX = nmNapCap(kq[1]);
      waGhiNhoLV(meta.linhVucMap);      
      nmCaiQuyTacBoSung();      
      NM.picIdx = {};
      Object.keys(meta.picGroups || {}).forEach(function (p, i) { NM.picIdx[p] = i; });
      var restored = nmLoadDraft();
      nmEnsureBlankRows(restored ? 3 : 5);
      nmRenderAll();
      if (restored) showToast('Đã khôi phục ' + restored + ' dòng nháp chưa lưu.');
    }).catch(function (err) {
      document.getElementById('nmRoot').innerHTML = '';
      showError('nmError', err);
    });
  }

  // ----- Trạng thái dòng -----
  function nmNewRow() { return { _id: NM.nextId++, _uid: nmUid() }; }
  function nmRowHasData(r) {
    return Object.keys(r).some(function (k) { return k !== '_id' && k !== '_uid' && (r[k] || '').toString().trim(); });
  }
  function nmRowById(id) {
    for (var i = 0; i < NM.rows.length; i++) if (NM.rows[i]._id == id) return NM.rows[i];
    return null;
  }
  function nmRowIndex(id) {
    for (var i = 0; i < NM.rows.length; i++) if (NM.rows[i]._id == id) return i;
    return -1;
  }
  function nmEnsureBlankRows(k) {
    var trailing = 0;
    for (var i = NM.rows.length - 1; i >= 0 && !nmRowHasData(NM.rows[i]); i--) trailing++;
    while (trailing < k) { NM.rows.push(nmNewRow()); trailing++; }
  }
  // Thứ tự cột = thứ tự cột thật trên sheet TEST
  function nmByCol(a, b) { return (a.sortCol || a.col) - (b.sortCol || b.col); }
  function nmVisibleFields() {
    return NM.meta.fields.filter(function (f) {
      return f.group === 'core' || f.required || f === NM.fLinhVuc || NM.show[f.group];
    }).sort(nmByCol);    
  }
  function nmOpts(f) { return f.goiY || f.options || []; }

  // Nhân sự hỗ trợ: gợi ý đúng người trong nhóm của Phụ trách đang chọn ở dòng đó (hoặc giá trị chung)
  function nmHoTroList(r) {
    var pic = ((r && r.pic) || NM.common.pic || '').toString().trim();
    var i = NM.picIdx[pic];
    return i === undefined ? 'nmdl-hoTro' : 'nmdl-hoTro-' + i;
  }
  function nmListAttr(f, r) {
    if (f.key === 'hoTro') return ' list="' + nmHoTroList(r) + '"';
    if ((f.key === 'linhVuc' || f.key === 'subSector') && nmLV()) return '';   // dùng hộp chọn nhiều, không dùng datalist    
    return nmOpts(f).length ? ' list="nmdl-' + f.key + '"' : '';
  }

  // Ô bắt buộc đang trống (tính cả giá trị chung). KM phụ tự lấy Đối tượng theo KM chính.
  function nmGiaTri(r, f) {
    if (!f) return '';
    var v = (r[f.key] || '').toString().trim();
    if (!v && f.common) {
      // Sub-sector chung chỉ áp cho dòng dùng đúng Lĩnh vực chung (máy chủ cũng xử lý y hệt).
      if (f.key === 'subSector' && r !== NM.common && (r.linhVuc || '').toString().trim() &&
          fNorm(r.linhVuc) !== fNorm(NM.common.linhVuc)) return '';
      v = (NM.common[f.key] || '').toString().trim();
    }
    return v;
  }

  // ===== LĨNH VỰC → SUB-SECTOR (danh sách chuẩn ở THIẾT LẬP FILE, máy chủ gửi kèm meta) =====
  function nmLV() { return NM.meta && NM.meta.linhVucMap && NM.meta.linhVucMap.sectors ? NM.meta.linhVucMap : null; }
  function nmSubList(r) { return nmLV() ? 'nmdl-khong' : 'nmdl-subSector'; }   // có danh sách chuẩn thì dùng hộp chọn nhiều
  function nmSubsCuaNhieu(secStr) {
    var out = [];
    waTach(secStr).forEach(function (s) { out = out.concat(nmSubsCua(s)); });
    return out;
  }  
  function nmSubsCua(sec) { var lv = nmLV(); return (lv && lv.subs[sec]) || []; }
  function nmTimTrongDs(ds, v) {
    var n = fNorm(v);
    for (var i = 0; i < ds.length; i++) if (fNorm(ds[i]) === n) return ds[i];
    return null;
  }
  // Tách "Lĩnh vực - Sub-sector" / "Lĩnh vực (Sub-sector)" / chỉ "Sub-sector" (giống NM_tachLinhVucGop_ ở máy chủ).
  function nmTachLinhVuc(t) {
    var lv = nmLV(); t = (t || '').toString().replace(/\s+/g, ' ').trim();
    if (!lv || !t) return null;
    var m = t.match(/^(.*\S)\s*\(([^()]+)\)\s*$/);
    if (m) {
      var s1 = nmTimTrongDs(lv.sectors, m[1]), b1 = s1 && nmTimTrongDs(nmSubsCua(s1), m[2]);
      if (b1) return { sec: s1, sub: b1 };
    }
    var re = /\s+[-–—|›>\/]\s+|\s*[|›>]\s*/g, hit;
    while ((hit = re.exec(t)) !== null) {
      var s2 = nmTimTrongDs(lv.sectors, t.slice(0, hit.index));
      var b2 = s2 && nmTimTrongDs(nmSubsCua(s2), t.slice(hit.index + hit[0].length));
      if (b2) return { sec: s2, sub: b2 };
    }
    var ds = lv.sectors.filter(function (s) { return nmTimTrongDs(lv.subs[s] || [], t); });
    return ds.length === 1 ? { sec: ds[0], sub: nmTimTrongDs(lv.subs[ds[0]], t) } : null;
  }
  // Chuẩn hoá Lĩnh vực / Sub-sector NHIỀU GIÁ TRỊ ("A, B") của 1 dòng hoặc của NM.common. Trả về true nếu có đổi.
  function nmChuanHoaLV(r) {
    var lv = nmLV();
    if (!lv) return false;
    var laChung = (r === NM.common);
    var cuSec = (r.linhVuc || '').toString(), cuSub = (r.subSector || '').toString();
    var secs = [], subs = [];
    waTach(cuSec).forEach(function (s) {
      var dung = nmTimTrongDs(lv.sectors, s);
      if (dung) { secs.push(dung); return; }
      var tach = nmTachLinhVuc(s);                       // "Lĩnh vực - Sub-sector" gộp chung 1 ô
      if (tach) { secs.push(tach.sec); subs.push(tach.sub); return; }
      secs.push(nmMatchOne(lv.sectors, s, true));
    });
    var secHL = secs.length ? secs : (laChung ? [] : waTach(NM.common.linhVuc));
    var pool = [];
    secHL.forEach(function (s) { pool = pool.concat(nmSubsCua(s)); });
    waTach(cuSub).forEach(function (b) {
      var trong = nmTimTrongDs(pool, b);
      if (!trong && pool.length) { var p = nmMatchOne(pool, b, true); if (p !== b) trong = p; }
      if (trong) { subs.push(trong); return; }
      if (!secHL.length) {                               // chưa có Lĩnh vực: suy ra từ Sub-sector
        var t = nmTachLinhVuc(b);
        if (t) { secs.push(t.sec); subs.push(t.sub); return; }
      }
      subs.push(b);
    });
    var moiSec = waGop(secs), moiSub = waGop(subs);
    var doi = (moiSec !== cuSec.trim()) || (moiSub !== cuSub.trim());
    if (doi) { r.linhVuc = moiSec; r.subSector = moiSub; }
    return doi;
  }
  function nmLoiSub(r) {
    var lv = nmLV();
    if (!lv) return null;
    var secs = waTach(nmGiaTri(r, NM.fLinhVuc || NM.byKey.linhVuc));
    var la = secs.filter(function (s) { return lv.sectors.indexOf(s) === -1; });
    if (la.length) return { key: 'linhVuc', msg: 'Lĩnh vực không có trong danh sách: "' + la.join('", "') +
      '". Nếu vừa thêm trên sheet, bấm 📚 Lĩnh vực & Sub-sector rồi "Nạp lại từ sheet".' };
    if (!NM.byKey.subSector) return null;
    var subs = waTach(nmGiaTri(r, NM.byKey.subSector));
    if (!secs.length || !subs.length) return null;
    var pool = nmSubsCuaNhieu(secs.join(', '));
    if (!pool.length) return { key: 'subSector', msg: 'Các Lĩnh vực đã chọn không có Sub-sector, để trống ô Sub-sector' };
    var sai = subs.filter(function (b) { return !nmTimTrongDs(pool, b); });
    return sai.length ? { key: 'subSector', msg: 'Sub-sector không thuộc Lĩnh vực đã chọn: "' + sai.join('", "') + '"' } : null;
  }

  // Ghi lại giá trị 2 ô Lĩnh vực / Sub-sector của 1 dòng lên giao diện + đổi danh sách gợi ý Sub-sector.
  function nmVeLaiLV(r) {
    ['linhVuc', 'subSector'].forEach(function (k) {
      var el = document.querySelector('.nm-cell[data-id="' + r._id + '"][data-key="' + k + '"]');
      if (el && el.value !== (r[k] || '')) el.value = r[k] || '';
    });
    var sc = document.querySelector('.nm-cell[data-id="' + r._id + '"][data-key="subSector"]');
    if (sc && nmLV()) sc.setAttribute('list', nmSubList(r));
  }
  function nmMienLinhVuc(doiTuong) {
    var n = fNorm(doiTuong);
    return NM_DOITUONG_MIEN_LINHVUC.some(function (k) { return n.indexOf(k) !== -1; });
  }
  function nmCanNhap(r, f) {
    var laKmPhu = !!(r.kmChinh || '').toString().trim();
    if (f.key === 'subSector') {                 // đã chọn Lĩnh vực có Sub-sector thì phải chọn Sub-sector
      return waTach(nmGiaTri(r, NM.fLinhVuc || NM.byKey.linhVuc)).some(function (s) { return nmSubsCua(s).length > 0; });      
    }
    if (f === NM.fLinhVuc) {
      if (laKmPhu) return false;                 // KM phụ đi theo KM chính
      var dt = nmGiaTri(r, NM.fDoiTuong);
      return !!dt && !nmMienLinhVuc(dt);         // chưa chọn Đối tượng thì chưa đòi
    }
    if (!f.required) return false;
    if ((f === NM.fDoiTuong || f.key === 'doiTuong') && laKmPhu) return false;   // KM phụ lấy Đối tượng theo KM chính    
    return true;
  }
  function nmThieu(r, f) { return nmCanNhap(r, f) && !nmGiaTri(r, f); }

  function nmDemThieu() {
    var n = 0;
    NM.rows.forEach(function (r) {
      if (!nmRowHasData(r)) return;
      NM.meta.fields.forEach(function (f) { if (nmThieu(r, f)) n++; });
    });
    return n;
  }
  function nmDanhDauThieu(id) {
    var r = nmRowById(id);
    if (!r) return;
    var has = nmRowHasData(r);
    document.querySelectorAll('.nm-cell[data-id="' + id + '"]').forEach(function (el) {
      var f = NM.byKey[el.dataset.key];
      if (!f) return;      
      var td = el.parentNode;
      if (td.classList.contains('nm-err') || td.classList.contains('nm-warn')) return;
      td.classList.toggle('nm-miss', has && nmThieu(r, f));
    });
  }

  // Khớp giá trị gõ/dán với danh sách lựa chọn
  function nmMatchOne(opts, v, choPhepMotPhan) {
    v = (v || '').toString().trim();
    if (!v) return v;
    if (opts.indexOf(v) !== -1) return v;
    var n = fNorm(v);
    var exact = null, part = [];
    opts.forEach(function (o) {
      var on = fNorm(o);
      if (on === n) { if (!exact) exact = o; }
      else if (choPhepMotPhan && n && on.indexOf(n) !== -1) part.push(o);
    });
    return exact || (part.length === 1 ? part[0] : v);
  }
  function nmMatch(f, v) {
    v = (v || '').toString().trim();
    if (!v || !f) return v;
    if (f.phone) { var kqS = WA_chuanHoaSdt_(v); return kqS.loi.length ? v : kqS.vals.join('; '); }    
    if ((f.key === 'linhVuc' || f.key === 'subSector') && nmLV()) return v;   // xử lý riêng ở nmChuanHoaLV
    if (f.kind === 'checkbox') {
      var n = fNorm(v);
      if (['co', 'x', 'yes', 'y', 'true', '1', 'v'].indexOf(n) !== -1) return 'Có';
      if (['khong', 'no', 'n', 'false', '0'].indexOf(n) !== -1) return 'Không';
      return v;
    }
    if (f.kind === 'ref' || f.kind === 'text') return v;
    var opts = nmOpts(f);
    if (!opts.length) return v;
    // Danh sách cố định (dropdown): cho khớp 1 phần. Gợi ý từ dữ liệu (Tổ chức, Quốc gia...): chỉ khớp đúng tuyệt đối.
    var motPhan = f.kind === 'list';
    if (f.multi) {
      return v.split(',').map(function (p) { return nmMatchOne(opts, p, motPhan); })
        .filter(function (p) { return p; }).join(', ');
    }
    return nmMatchOne(opts, v, motPhan);
  }

  // ----- Vẽ giao diện -----
  function nmMgrHtml(m) {
    var parts = [];
    if (m.lechCot && m.lechCot.length) {
      parts.push('<div class="nm-mgr-h">Số cột cố định trong script đang lệch với sheet TEST</div>' +
        '<div>Các file dưới đây đọc/ghi theo số cột viết cứng, không theo tiêu đề. Lệch nghĩa là chúng đang đọc nhầm cột. Tab này vẫn ghi đúng vì dò theo tiêu đề.</div>' +
        '<ul>' + m.lechCot.map(function (x) { return '<li>' + escapeHtml(x) + '</li>'; }).join('') + '</ul>');
    }
    if (m.doiTuongKhongMa && m.doiTuongKhongMa.length) {
      parts.push('<div class="nm-mgr-h">Đối tượng có trong dropdown nhưng mã KM.gs chưa có tiền tố mã</div>' +
        '<div>Đã ẩn khỏi gợi ý vì chọn các giá trị này sẽ không sinh được Mã KM. Bổ sung vào MK_PREFIX_MAP để dùng được:</div>' +
        '<ul>' + m.doiTuongKhongMa.map(function (x) { return '<li>' + escapeHtml(x) + '</li>'; }).join('') + '</ul>');
    }
    if (m.skipped && m.skipped.length) {
      parts.push('<div class="nm-mgr-h">Cột đang là công thức, hệ thống tự điền</div><ul><li>' + escapeHtml(m.skipped.join(', ')) + '</li></ul>');
    }
    if (!parts.length) return '';
    var n = (m.lechCot || []).length + (m.doiTuongKhongMa || []).length + ((m.skipped || []).length ? 1 : 0);
    return '<details class="nm-mgr"><summary>⚙️ Thông báo cho quản lý (' + n + ')</summary>' + parts.join('') + '</details>';
  }

  function nmRenderAll() {
    var m = NM.meta;
    var dls = m.fields.filter(function (f) { return nmOpts(f).length; }).map(function (f) {
      return '<datalist id="nmdl-' + f.key + '">' +
        nmOpts(f).map(function (o) { return '<option value="' + escapeHtml(o) + '"></option>'; }).join('') +
      '</datalist>';
    }).join('');
    Object.keys(m.picGroups || {}).forEach(function (p) {
      dls += '<datalist id="nmdl-hoTro-' + NM.picIdx[p] + '">' +
        m.picGroups[p].map(function (o) { return '<option value="' + escapeHtml(o) + '"></option>'; }).join('') + '</datalist>';
    });
    if (nmLV()) nmLV().sectors.forEach(function (sec, i) {
      dls += '<datalist id="nmdl-sub-' + i + '">' +
        nmSubsCua(sec).map(function (o) { return '<option value="' + escapeHtml(o) + '"></option>'; }).join('') + '</datalist>';
    });

    var warn = nmMgrHtml(m);
    if (m.missing && m.missing.length) {
      warn += '<div class="nm-err-box">Không dò được cột: <strong>' + escapeHtml(m.missing.join(' · ')) + '</strong>. Các trường này không có trong bảng nhập.</div>';
    }
    if (m.linhVucNote) warn += '<div class="nm-note">⚠️ Danh sách Lĩnh vực / Sub-sector: ' + escapeHtml(m.linhVucNote) + '</div>';

    // Giá trị chung: gom theo nhóm màu, mỗi nhóm xếp 2 cột
    var theoTone = {};
    m.fields.filter(function (f) { return f.common; }).sort(nmByCol).forEach(function (f) {
      (theoTone[nmTone(f)] = theoTone[nmTone(f)] || []).push(f);
    });
    var commonHtml = NM_TONE_ORDER.filter(function (t) { return theoTone[t]; }).map(function (t) {
      return '<div class="nm-cgroup tone-' + t + '"><div class="nm-cg-head">' + escapeHtml(NM_TONE_LABEL[t]) + '</div>' +
        '<div class="nm-common-grid">' + theoTone[t].map(function (f) {
          return '<div class="ff"><label>' + escapeHtml(f.label) + (f.required ? ' <span style="color:var(--danger)">*</span>' : '') + '</label>' +
            '<input type="text" class="ui-input" id="nmc-' + f.key + '"' + nmListAttr(f, NM.common) +
            ' value="' + escapeHtml(NM.common[f.key] || '') + '" placeholder="(để trống)" autocomplete="off" onchange="nmCommonChange(\'' + f.key + '\', this)"></div>';
        }).join('') + '</div></div>';
    }).join('');

    var chips = Object.keys(NM_GROUP_LABELS).map(function (g) {
      return '<label class="nm-chip tone-' + (NM_TONE_GROUP[g] || 'system') + '"><input type="checkbox"' + (NM.show[g] ? ' checked' : '') +
        ' onchange="nmToggleGroup(\'' + g + '\', this.checked)"><span class="nm-dot"></span>' + escapeHtml(NM_GROUP_LABELS[g]) + '</label>';
    }).join('');

    document.getElementById('nmRoot').innerHTML = dls + warn +
      '<div class="panel-card sec tone-internal"><h2><span class="nm-step">1</span> GIÁ TRỊ CHUNG CHO CẢ ĐỢT NHẬP</h2>' +
        '<p class="panel-desc">Ô nào trong bảng bên dưới để trống sẽ tự lấy giá trị ở đây khi lưu (hiện chữ mờ trong ô). Ô đã gõ trong bảng luôn được ưu tiên. Dấu * là trường bắt buộc: điền ở đây thì cả đợt đều đạt. Sub-sector chung chỉ áp cho dòng không gõ Lĩnh vực khác.</p>' +
        '<div class="nm-cgroups">' + commonHtml + '</div>' +
      '</div>' +
      '<div class="panel-card sec tone-profile"><h2><span class="nm-step">2</span> DANH SÁCH KM MỚI</h2>' +
        '<p class="panel-desc">Cột xếp đúng thứ tự như sheet TEST, trừ <strong>Mã KM</strong> vì hệ thống tự sinh. Cột có * là bắt buộc và luôn hiện. Copy một vùng từ Excel / Google Sheets rồi dán (Ctrl+V) vào ô bất kỳ; nếu vùng copy có <strong>dòng tiêu đề</strong> thì tự ghép đúng cột dù thứ tự khác. Enter xuống ô dưới, Shift+Enter lên trên.</p>' +
        '<div class="nm-toolbar"><span class="nm-toolbar-label">Hiện thêm cột:</span>' + chips +
          '<span class="spacer"></span>' +
          '<button class="btn btn-secondary btn-sm" onclick="nmCopyHeaders()">📋 Copy tiêu đề cột</button>' +
          '<button class="btn btn-secondary btn-sm" onclick="nmAddRows(1)">+ 1 dòng</button>' +
          '<button class="btn btn-secondary btn-sm" onclick="nmAddRows(10)">+ 10 dòng</button>' +
          '<button class="btn btn-secondary btn-sm" onclick="nmRemoveEmpty()">Xoá dòng trống</button>' +
          '<button class="btn btn-secondary btn-sm" onclick="nmClearAll()">Xoá hết</button>' +
