  // ================= XEM DANH SÁCH LĨNH VỰC & SUB-SECTOR (nút góc phải, tab Thêm KM mới) =================
  window.LV = { map: null, luc: '' };
  function lvMo() {
    document.getElementById('lvDrawer').classList.add('show');
    document.getElementById('lvDrawerBackdrop').classList.add('show');
    document.body.classList.add('lv-open');
    lvNapLai();
