table.nm-grid td.nm-warn { background:var(--warn-light); }
table.nm-grid td.nm-miss { background:#FFF6F4; box-shadow:inset 3px 0 0 #E8A89F; }
.nm-st { margin-left:4px; font-size:11px; }
.nm-st.err { color:var(--danger); } .nm-st.warn { color:var(--warn); } .nm-st.ok { color:#16A34A; }
.nm-act { white-space:nowrap; background:#F9FBFD !important; }
.nm-rowbtn { border:none; background:none; cursor:pointer; padding:5px 7px; color:var(--ink-soft); font-size:13px; }
.nm-rowbtn:hover { color:var(--teal-800); }
.nm-issues { margin:10px 0 0; padding:10px 14px 10px 30px; background:#FBFCFD; border:1px solid var(--line); border-radius:8px; font-size:12.5px; max-height:220px; overflow-y:auto; }
.nm-issues li { margin:2px 0; }
.nm-issues li.err { color:var(--danger); }
.nm-issues li.warn { color:#92400E; }
