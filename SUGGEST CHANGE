  // ---------- LĨNH VỰC → SUB-SECTOR (NHIỀU LỰA CHỌN) ----------
  // Danh sách chuẩn đọc từ THIẾT LẬP FILE qua WA_getSectorMap. Quá 2 phút thì tự đọc lại, nên thêm mới trên
  // sheet là web tự thấy (nút "Nạp lại từ sheet" để lấy ngay). Giá trị lưu dạng "A, B, C" như dropdown nhiều lựa chọn.
  // Tách "A, B, C" nhưng không cắt đôi tên có dấu phẩy (VD "1. Nông nghiệp, Lâm nghiệp & Thủy sản").
  // Dựa vào danh sách tên đã biết WA_LV_BIET (nạp từ THIẾT LẬP FILE); chưa nạp thì tách theo dấu phẩy thường.
  function waNapBiet(list) {
    window.WA_LV_BIET = window.WA_LV_BIET || {};
    (list || []).forEach(function (x) { var k = fNorm(x); if (k) window.WA_LV_BIET[k] = true; });
  }
  function waGhiNhoLV(map) {
    if (!map || !map.sectors) return;
    waNapBiet(map.sectors);
    Object.keys(map.subs || {}).forEach(function (s) { waNapBiet(map.subs[s]); });
  }
  function waTach(v) {
    var p = (v === null || v === undefined ? '' : v).toString().split(',')
      .map(function (x) { return x.replace(/\s+/g, ' ').trim(); }).filter(Boolean);
    var biet = window.WA_LV_BIET || {};
    if (!Object.keys(biet).length) return p;
    var dai = function (i) {
      for (var j = p.length; j > i; j--) if (biet[fNorm(p.slice(i, j).join(', '))]) return j;
      return -1;
    };
    var out = [], i = 0;
    while (i < p.length) {
      var j = dai(i);
      if (j !== -1) { out.push(p.slice(i, j).join(', ')); i = j; continue; }
      var k = i + 1;
      while (k < p.length && dai(k) === -1) k++;
      out.push(p.slice(i, k).join(', '));
      i = k;
    }
    return out;
  }

  function waGop(arr) {
    var seen = {}, out = [];
    (arr || []).forEach(function (x) { var k = fNorm(x); if (x && !seen[k]) { seen[k] = true; out.push(x); } });
    return out.join(', ');
  }
  function waLaySectorMap(lamMoi) {
    var cu = Date.now() - (window.WA_SECTOR_MAP_T || 0) > 120000;
    if (lamMoi || cu || !window.WA_SECTOR_MAP_P) {
      window.WA_SECTOR_MAP_T = Date.now();
      window.WA_SECTOR_MAP_P = gs('WA_getSectorMap').then(function (m) {
        if (m && m.sectors && window.NM && NM.meta) NM.meta.linhVucMap = m;   // tab Thêm KM mới dùng luôn bản mới
        waGhiNhoLV(m);        
        return m;
      }).catch(function () { window.WA_SECTOR_MAP_P = null; return null; });
    }
    return window.WA_SECTOR_MAP_P;
  }

  // ---------- HỘP CHỌN NHIỀU DÙNG CHUNG (hồ sơ khách + tab Thêm KM mới) ----------
  // groups = [{ title: 'tên nhóm' hoặc '', opts: [...] }], sel = mảng đang chọn, onDoi(mảng mới) chạy mỗi lần tick.
  window.WA_MPOP = null;
  function waMoChonNhieu(anchor, groups, sel, onDoi) {
    var pop = document.getElementById('waMultiPop');
    if (!pop) {
      pop = document.createElement('div');
      pop.id = 'waMultiPop';
      pop.className = 'fg-pop wa-mpop';
      pop.addEventListener('click', function (e) { e.stopPropagation(); });
      document.body.appendChild(pop);
    }
    var biet = {};
    groups.forEach(function (g) { g.opts.forEach(function (o) { biet[fNorm(o)] = true; }); });
    var st = { anchor: anchor, groups: groups, sel: sel.slice(), onDoi: onDoi, q: '',
      la: sel.filter(function (s) { return !biet[fNorm(s)]; }) };
    window.WA_MPOP = st;
    pop.innerHTML = '<div class="fm-tools"><input type="text" placeholder="Gõ để tìm…">' +
      '<button type="button" data-act="none">Bỏ hết</button><button type="button" data-act="done">✓ Xong</button></div>' +
      '<div class="wa-mpop-list"></div>';
    var q = pop.querySelector('input');
    q.oninput = function () { st.q = q.value; waVeMpop(); };
    pop.querySelector('[data-act="none"]').onclick = function () { st.sel = []; waVeMpop(); waBaoMpop(); };
    pop.querySelector('[data-act="done"]').onclick = waDongMpop;
    waVeMpop();
    pop.classList.add('show');
    var rect = anchor.getBoundingClientRect(), h = pop.offsetHeight;
    var top = (rect.bottom + h + 8 > window.innerHeight && rect.top > h + 8) ? rect.top - h - 2 : rect.bottom + 2;
    var maxLeft = window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 8;
    pop.style.top = (top + window.scrollY) + 'px';
    pop.style.left = Math.max(window.scrollX + 8, Math.min(rect.left + window.scrollX, maxLeft)) + 'px';
  }
  function waVeMpop() {
    var st = window.WA_MPOP, pop = document.getElementById('waMultiPop');
    if (!st || !pop) return;
    var n = fNorm(st.q);
    var khop = function (o) { return !n || fNorm(o).indexOf(n) !== -1; };
    var dangChon = function (o) { return st.sel.some(function (s) { return fNorm(s) === fNorm(o); }); };
    var dong = function (o, la) {
      return '<label class="fm-opt"><input type="checkbox" data-v="' + escapeHtml(o) + '"' + (dangChon(o) ? ' checked' : '') + '>' +
        '<span>' + (la ? '⚠ ' : '') + escapeHtml(o) + '</span></label>';
    };
    var html = '';
    var la = st.la.filter(khop);
    if (la.length) html += '<div class="wa-mpop-h warn">Đang có nhưng không nằm trong danh sách</div>' +
      la.map(function (o) { return dong(o, true); }).join('');
    st.groups.forEach(function (g) {
      var theoTen = !!g.title && khop(g.title);
      var ds = g.opts.filter(function (o) { return theoTen || khop(o); });
      if (!ds.length && (!g.title || (n && !theoTen))) return;
      if (g.title) html += '<div class="wa-mpop-h">' + escapeHtml(g.title) + '</div>';
      html += ds.length ? ds.map(function (o) { return dong(o, false); }).join('') : '<div class="wa-mpop-empty">(không có Sub-sector)</div>';
    });
    var list = pop.querySelector('.wa-mpop-list');
    list.innerHTML = html || '<div class="wa-mpop-empty">Không có lựa chọn phù hợp.</div>';
    list.querySelectorAll('input[type=checkbox]').forEach(function (cb) {
      cb.onchange = function () {
        var v = cb.dataset.v;
        st.sel = st.sel.filter(function (s) { return fNorm(s) !== fNorm(v); });
        if (cb.checked) st.sel.push(v);
        waBaoMpop();
      };
    });
  }
  // Trả kết quả theo đúng thứ tự trong danh sách (giá trị lạ đứng đầu).
  function waBaoMpop() {
    var st = window.WA_MPOP;
    if (!st) return;
    var thuTu = st.la.slice(), kq = [];
    st.groups.forEach(function (g) { thuTu = thuTu.concat(g.opts); });
    thuTu.forEach(function (o) {
      var on = st.sel.some(function (s) { return fNorm(s) === fNorm(o); });
      if (on && !kq.some(function (k) { return fNorm(k) === fNorm(o); })) kq.push(o);
    });
    st.onDoi(kq);
  }
  function waDongMpop() {
    var pop = document.getElementById('waMultiPop');
    if (pop) pop.classList.remove('show');
    window.WA_MPOP = null;
  }
  document.addEventListener('click', function (e) {
    var st = window.WA_MPOP;
    if (st && e.target !== st.anchor && !(st.anchor.contains && st.anchor.contains(e.target))) waDongMpop();
  });
  document.addEventListener('scroll', function (e) {
    if (window.WA_MPOP && e.target && e.target.nodeType === 1 && !e.target.closest('#waMultiPop')) waDongMpop();
  }, true);
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (window.WA_MPOP) { waDongMpop(); return; }
    var d = document.getElementById('lvDrawer');
    if (d && d.classList.contains('show')) lvDong();
  });

  // ---------- GẮN VÀO HỒ SƠ KHÁCH (cả tab Tra cứu lẫn khung bên cạnh của Bộ lọc) ----------
  function waLienKetLinhVucHoSo() {
    var root = document.getElementById(window.WA_DETAIL_ROOT || 'detailPanel');
    if (!root) return;
    var secW = null, subW = null;
    root.querySelectorAll('.f').forEach(function (w) {
      var lb = w.querySelector('label');
      if (!lb) return;
      var t = fNorm(lb.textContent);
      if (t === 'linh vuc') secW = w;
      else if (t === 'sub sector' || t === 'subsector' || t === 'linh vuc con') subW = w;
    });
    if (!secW) return;
    waLaySectorMap().then(function (map) {
      if (!map || !map.sectors || !document.body.contains(secW)) return;
      var sec = waDoiThanhChonNhieu(secW), sub = subW ? waDoiThanhChonNhieu(subW) : null;
      if (!sec) return;
      var nhomSub = function () {
        var secs = waTach(sec.hid.value).filter(function (s) { return map.subs[s]; });
        if (!secs.length) secs = map.sectors;
        return secs.map(function (s) { return { title: s, opts: map.subs[s] || [] }; });
      };
      var ve = function () {
        waVeChip(sec, map.sectors, 'Không có trong danh sách Lĩnh vực hiện tại');
        if (sub) {
          var pool = [];
          nhomSub().forEach(function (g) { pool = pool.concat(g.opts); });
          waVeChip(sub, pool, 'Không thuộc Lĩnh vực đang chọn');
        }
      };
      ve();
      if (sec.btn) sec.btn.onclick = function () {
        waMoChonNhieu(sec.btn, [{ title: '', opts: map.sectors }], waTach(sec.hid.value), function (arr) {
          sec.hid.value = arr.join(', '); markChanged(sec.hid); ve();
        });
      };
      if (sub && sub.btn) sub.btn.onclick = function () {
        waMoChonNhieu(sub.btn, nhomSub(), waTach(sub.hid.value), function (arr) {
          sub.hid.value = arr.join(', '); markChanged(sub.hid); ve();
        });
      };
    });
  }
  // Thay ô Lĩnh vực / Sub-sector (dù đang là ô chữ, dropdown hay checkbox) bằng: chip + nút chọn + ô ẩn data-col.
  function waDoiThanhChonNhieu(w) {
    var src = w.querySelector('input[type=hidden][data-col]') || w.querySelector('select[data-col], input[data-col]');
    if (!src) return null;
    var khoa = !!w.querySelector('[data-col]:disabled, .ms-group input:disabled');
    var nhan = w.querySelector('label').textContent;
    var col = src.dataset.col, val = src.value || '';
    w.classList.add('full');
    w.innerHTML = '<label>' + escapeHtml(nhan) + '</label><div class="lv-chips"></div>' +
      (khoa ? '' : '<div><button type="button" class="btn btn-secondary btn-sm lv-edit">☰ Chọn / bỏ chọn</button></div>') +
      '<input type="hidden" data-col="' + col + '" value="' + escapeHtml(val) + '">';
    return { w: w, hid: w.querySelector('input[type=hidden]'), btn: w.querySelector('.lv-edit') };
  }
  function waVeChip(o, hopLe, loiLa) {
    var vals = waTach(o.hid.value);
    o.w.querySelector('.lv-chips').innerHTML = vals.length ? vals.map(function (v) {
      var ok = hopLe.some(function (h) { return fNorm(h) === fNorm(v); });
      return '<span class="lv-chip' + (ok ? '' : ' la') + '"' + (ok ? '' : ' title="' + escapeHtml(loiLa) + '"') + '>' +
        (ok ? '' : '⚠ ') + escapeHtml(v) + '</span>';
    }).join('') : '<span class="val empty">Chưa chọn</span>';
  }

  // ---------- CHUYỂN TAB ĐỢT 1 / ĐỢT 2 / LỊCH SỬ MAIL ----------
  function switchDetailTab(tabKey) {
    document.querySelectorAll('.detail-tab-btn').forEach(function (btn) {
      btn.classList.toggle('active', btn.dataset.tab === tabKey);
    });
    document.querySelectorAll('.detail-tab-panel').forEach(function (panel) {
      panel.classList.remove('active');
    });
    var target = document.getElementById('detailTab-' + tabKey);
    if (target) target.classList.add('active');

    if (tabKey === 'mail' && currentGuest && !currentGuest.maKM) {
      document.getElementById('mailHistoryContent').innerHTML =
        '<div class="empty-state">Khách này chưa có Mã KM nên chưa gắn được với DATA MAIL. Hãy điền Mã KM trên sheet TEST (hoặc thêm lại qua tab “Thêm KM mới”) rồi mở lại.</div>';
      return;
    }
    if (tabKey === 'mail' && currentGuest && !currentGuest.mailLoaded) {
