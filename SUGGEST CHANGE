      <div class="log-field b2"><label>Phản hồi của khách (AQ)</label>
        <div class="log-list"><div class="log-item"><span class="badge-date">12.9</span><span class="log-text">Xác nhận tham dự ngày 14/10, cử 1 tuỳ tùng đi cùng</span></div></div>
        <input type="text" class="ui-input" placeholder="Thêm phản hồi mới của khách…"></div>
      <div class="log-field b2"><label>Tiến độ làm việc của BTC (AR)</label>
        <div class="log-list"><div class="log-item"><span class="badge-date pic">12.9</span><span class="log-text">Đã chuyển bộ phận lễ tân xếp chỗ</span></div></div>
        <input type="text" class="ui-input" placeholder="Thêm tiến độ làm việc của BTC…"></div>
