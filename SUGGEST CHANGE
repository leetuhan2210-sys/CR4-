<script>
  function gs(fnName) {
    var args = Array.prototype.slice.call(arguments, 1);
    return new Promise(function (resolve, reject) {
      google.script.run
        .withSuccessHandler(resolve)
        .withFailureHandler(function (err) { reject(err); })
        [fnName].apply(null, args);
    });
  }
 
  function showToast(msg) {
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function () { t.classList.remove('show'); }, 2500);
  }
 
  function showError(elId, err) {
    var el = document.getElementById(elId);
    var msg = (err && err.message) ? err.message : (err || 'Có lỗi xảy ra.');
    el.innerHTML = '<div class="error-box">' + escapeHtml(msg) + '</div>';
  }
 
  function classifyBadgeClass(v) {
    var m = { 'Khách mời': 'c-guest', 'VVIP': 'c-vvip', 'VIP': 'c-vip', 'Speaker': 'c-speaker' };
    return m[v] || 'c-guest';
  }

  function escapeHtml(s) {
    return (s || '').toString().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ---------- Ô NHẬP NHIỀU SỐ ĐIỆN THOẠI ----------
  var WA_SDT_GOI_Y = [['84','Việt Nam'],['1','Mỹ / Canada'],['44','Anh'],['65','Singapore'],['81','Nhật Bản'],['82','Hàn Quốc'],['86','Trung Quốc'],['852','Hồng Kông'],['886','Đài Loan'],['61','Úc'],['64','New Zealand'],['33','Pháp'],['49','Đức'],['41','Thụy Sĩ'],['31','Hà Lan'],['39','Ý'],['34','Tây Ban Nha'],['46','Thụy Điển'],['45','Đan Mạch'],['358','Phần Lan'],['47','Na Uy'],['66','Thái Lan'],['60','Malaysia'],['62','Indonesia'],['63','Philippines'],['855','Campuchia'],['856','Lào'],['95','Myanmar'],['91','Ấn Độ'],['971','UAE'],['974','Qatar'],['966','Ả Rập Xê Út'],['972','Israel'],['7','Nga'],['90','Thổ Nhĩ Kỳ']];
  (function () {
    var dl = document.createElement('datalist');
    dl.id = 'dl-sdt-cc';
    dl.innerHTML = WA_SDT_GOI_Y.map(function (x) { return '<option value="+' + x[0] + '">' + x[1] + '</option>'; }).join('');
    document.body.appendChild(dl);
  })();
  var WA_SDT_TACH_RE = /\r?\n|[;,\/|]/;

  function waSdtDongHtml(cc, so) {
    return '<div class="sdt-row">' +
      '<input type="text" class="ui-input sdt-cc" list="dl-sdt-cc" placeholder="+84" inputmode="tel" autocomplete="off" value="' + escapeHtml(cc ? '+' + cc : '') + '">' +
      '<input type="text" class="ui-input sdt-so" placeholder="903123456" inputmode="tel" autocomplete="off" value="' + escapeHtml(so || '') + '">' +
      '<button type="button" class="sdt-del" title="Xoá số này" onclick="waSdtXoa(this)">✕</button></div>';
  }
  function waSdtEditorHtml(value) {
    var ds = [];
    String(value || '').split(WA_SDT_TACH_RE).forEach(function (p) {
      if (!p.trim()) return;
      var r = WA_chuanHoaMotSdt_(p);
      ds.push(r && !r.loi ? { cc: r.cc, so: r.so } : { cc: '', so: p.trim() });
    });
    if (!ds.length) ds.push({ cc: '84', so: '' });
    return '<div class="sdt-list">' + ds.map(function (x) { return waSdtDongHtml(x.cc, x.so); }).join('') + '</div>' +
      '<button type="button" class="sdt-add" onclick="waSdtThem(this)">＋ Thêm số điện thoại</button>' +
      '<div class="sdt-msg"></div>';
  }
  function waSdtChips(value) {
    var html = String(value || '').split(WA_SDT_TACH_RE).map(function (p) {
      if (!p.trim()) return '';
      var r = WA_chuanHoaMotSdt_(p);
      return (r && !r.loi)
        ? '<span class="sdt-chip"><b>+' + r.cc + '</b>' + escapeHtml(r.so) + '</span>'
        : '<span class="sdt-chip la" title="Chưa đúng định dạng (+mã quốc gia) số">⚠ ' + escapeHtml(p.trim()) + '</span>';
    }).join('');
    return html || '<span class="val empty">Chưa có</span>';
  }
  function waSdtDoc(box) {
    var vals = [], loi = [];
    box.querySelectorAll('.sdt-row').forEach(function (row) {
      var cc = row.querySelector('.sdt-cc').value.replace(/\D/g, '');
      var so = row.querySelector('.sdt-so').value.trim();
      row.classList.remove('loi');
      if (!so) return;
      var r = WA_chuanHoaMotSdt_(cc && !/^[(+]|^00/.test(so) ? '(+' + cc + ') ' + so : so);
      if (!r || r.loi) { row.classList.add('loi'); loi.push(r ? r.loi : so); return; }
      if (vals.indexOf(r.v) === -1) vals.push(r.v);
    });
    var msg = box.querySelector('.sdt-msg');
    if (msg) msg.textContent = loi.join(' · ');
    return { giaTri: vals.join('\n'), loi: loi };
  }
  // Hồ sơ khách: ghi kết quả vào ô ẩn data-col để nút Lưu gửi đi.
  function waSdtCapNhat(box) {
    var kq = waSdtDoc(box);
    var hid = box.parentNode.querySelector('input[type=hidden][data-col]');
    if (hid && !kq.loi.length && hid.value !== kq.giaTri) { hid.value = kq.giaTri; markChanged(hid); }
    return kq;
  }
  function waSdtThem(btn) {
    var list = btn.parentNode.querySelector('.sdt-list');
    list.insertAdjacentHTML('beforeend', waSdtDongHtml('84', ''));
    list.lastElementChild.querySelector('.sdt-so').focus();
  }
  function waSdtXoa(btn) {
    var box = btn.closest('.sdt-box'), row = btn.closest('.sdt-row');
    if (box.querySelectorAll('.sdt-row').length > 1) row.remove();
    else { row.querySelector('.sdt-so').value = ''; }
    if (box.closest('#waSdtPop')) waSdtDoc(box); else waSdtCapNhat(box);
  }

  // Hộp nhập nổi, dùng cho bảng Bộ lọc và bảng Thêm KM mới.
  window.WA_SDT_POP = null;
  function waMoSdt(anchor, value, onXong) {
    if (typeof waDongMpop === 'function') waDongMpop();
    var pop = document.getElementById('waSdtPop');
    if (!pop) {
      pop = document.createElement('div');
      pop.id = 'waSdtPop';
      pop.className = 'fg-pop sdt-pop';
      pop.addEventListener('click', function (e) { e.stopPropagation(); });
      document.body.appendChild(pop);
    }
    window.WA_SDT_POP = { anchor: anchor, onXong: onXong };
    pop.innerHTML = '<div class="wa-mpop-h" style="margin:0 0 10px">Số điện thoại · dạng (+mã quốc gia) số</div>' +
      '<div class="sdt-box">' + waSdtEditorHtml(value) + '</div>' +
      '<div class="sdt-pop-actions"><button type="button" class="btn btn-secondary btn-sm" onclick="waDongSdt()">Huỷ</button>' +
      '<button type="button" class="btn btn-primary btn-sm" onclick="waXongSdt()">✓ Xong</button></div>';
    pop.classList.add('show');
    var rect = anchor.getBoundingClientRect(), h = pop.offsetHeight;
    var top = (rect.bottom + h + 8 > window.innerHeight && rect.top > h + 8) ? rect.top - h - 2 : rect.bottom + 2;
    var maxLeft = window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 8;
    pop.style.top = (top + window.scrollY) + 'px';
    pop.style.left = Math.max(window.scrollX + 8, Math.min(rect.left + window.scrollX, maxLeft)) + 'px';
    var o = pop.querySelector('.sdt-so'); if (o) o.focus();
  }
  function waXongSdt() {
    var st = window.WA_SDT_POP, pop = document.getElementById('waSdtPop');
    if (!st || !pop) return;
    var kq = waSdtDoc(pop.querySelector('.sdt-box'));
    if (kq.loi.length) return;
    waDongSdt();
    st.onXong(kq.giaTri);
  }
  function waDongSdt() {
    var pop = document.getElementById('waSdtPop');
    if (pop) pop.classList.remove('show');
    window.WA_SDT_POP = null;
  }
  document.addEventListener('click', function (e) {
    var st = window.WA_SDT_POP;
    if (st && e.target !== st.anchor && !(st.anchor.contains && st.anchor.contains(e.target))) waDongSdt();
  });
  document.addEventListener('keydown', function (e) {
    if (!window.WA_SDT_POP) return;
    if (e.key === 'Escape') { e.stopImmediatePropagation(); waDongSdt(); }
    else if (e.key === 'Enter' && e.target.closest && e.target.closest('#waSdtPop')) { e.preventDefault(); e.stopImmediatePropagation(); waXongSdt(); }
  }, true);
  document.addEventListener('input', function (e) {
    if (window.WA_SDT_POP && e.target === window.WA_SDT_POP.anchor) waDongSdt();
    var box = e.target.closest ? e.target.closest('.sdt-box') : null;
    if (!box) return;
    if (box.closest('#waSdtPop')) waSdtDoc(box); else waSdtCapNhat(box);
  });
 
  document.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
      document.querySelectorAll('.panel').forEach(function (p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
      if (btn.dataset.tab === 'filter') initFilterTab();
      if (btn.dataset.tab === 'newguest') nmInit();
      document.body.classList.toggle('tab-newguest', btn.dataset.tab === 'newguest');      
    });
  }); 

  // ---------- TAB 1: PHẢN HỒI MỚI ----------
  function quetMailMoi() {
    var btn = document.getElementById('btnQuetMail');
    var originalLabel = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Đang quét…';
    document.getElementById('repliesError').innerHTML = '';
    gs('WA_quetMailMoi').then(function (result) {
      btn.disabled = false;
      btn.innerHTML = originalLabel;
      showToast('Đã quét xong: +' + result.mailAdded + ' mail mới, +' + result.otherAdded + ' mail chưa xác định.');
      loadReplies();
    }).catch(function (err) {
      btn.disabled = false;
      btn.innerHTML = originalLabel;
      showError('repliesError', err);
    });
  }

  window.WA_MAIL_BY_ROW = window.WA_MAIL_BY_ROW || {};
  window.WA_ACTIVE_BATCH = window.WA_ACTIVE_BATCH || {};
  window.WA_ACTIVE_PIC_SUBTAB = window.WA_ACTIVE_PIC_SUBTAB || null;
  window.WA_PENDING_SAVE = null;

  function loadReplies() {    
    document.getElementById('repliesError').innerHTML = '';
    document.getElementById('repliesList').innerHTML = '<div class="spinner">Đang tải phản hồi...</div>';
    gs('WA_getReplyStatusOptions').then(function (opts) {
      window.WA_STATUS_OPTIONS = opts.statusOptions;
      window.WA_HANDLER_OPTIONS = opts.handlerOptions;
      window.WA_PIC_GROUPS = opts.picGroups || {};
      return gs('WA_getNewReplies');
    }).then(renderReplies).catch(function (err) {
      document.getElementById('repliesList').innerHTML = '';
      showError('repliesError', err);
    });
  }

  function pickBatch(btn, paneId, rowIndex, batchNum) {
    var card = btn.closest('.mail-card__right');
    card.querySelectorAll('.batch-tab').forEach(function (b) { b.classList.remove('active'); });
    card.querySelectorAll('.batch-pane').forEach(function (p) { p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById(paneId).classList.add('active');
    if (rowIndex !== undefined && batchNum !== undefined) {
      window.WA_ACTIVE_BATCH[rowIndex] = batchNum;
    }
  }

  function buildBatchLogsHTML(logs, rowIndex, idPrefix) {
    function renderLogList(entries, badgeCls) {
      if (!entries || !entries.length) return '<div class="log-list"><div class="log-item empty">Chưa có ghi chú nào.</div></div>';
      return '<div class="log-list">' + entries.map(function (e) {
        return '<div class="log-item"><span class="badge-date' + (badgeCls ? ' ' + badgeCls : '') + '">' + escapeHtml(e.date) + '</span><span class="log-text">' + escapeHtml(e.text) + '</span></div>';
      }).join('') + '</div>';
    }
    var batch = window.WA_ACTIVE_BATCH[rowIndex] || '1';
    
    return '<div class="batch-tabs">' +
        '<button class="batch-tab' + (batch === '1' ? ' active' : '') + '" onclick="pickBatch(this,\'' + idPrefix + 'b1\', ' + rowIndex + ', \'1\')">Đợt 1</button>' +
        '<button class="batch-tab' + (batch === '2' ? ' active' : '') + '" onclick="pickBatch(this,\'' + idPrefix + 'b2\', ' + rowIndex + ', \'2\')">Đợt 2</button>' +
      '</div>' +
      '<div class="batch-pane' + (batch === '1' ? ' active' : '') + '" id="' + idPrefix + 'b1">' +
        '<div class="log-field b1"><label>Phản hồi của khách (AL)</label>' +
          renderLogList(logs.batch1.phanhoi) +
          '<input type="text" class="ui-input" id="phanhoi1-' + rowIndex + '" placeholder="Thêm phản hồi mới của khách (ghi khi bấm Lưu)…"></div>' +
        '<div class="log-field b1"><label>Tiến độ làm việc của BTC (AM)</label>' +
          renderLogList(logs.batch1.btc, 'pic') +
          '<input type="text" class="ui-input" id="btc1-' + rowIndex + '" placeholder="Thêm tiến độ làm việc của BTC (ghi khi bấm Lưu)…"></div>' +
      '</div>' +
      '<div class="batch-pane' + (batch === '2' ? ' active' : '') + '" id="' + idPrefix + 'b2">' +
        '<div class="log-field b2"><label>Phản hồi của khách (AQ)</label>' +
          renderLogList(logs.batch2.phanhoi) +
          '<input type="text" class="ui-input" id="phanhoi2-' + rowIndex + '" placeholder="Thêm phản hồi mới của khách (ghi khi bấm Lưu)…"></div>' +
        '<div class="log-field b2"><label>Tiến độ làm việc của BTC (AR)</label>' +
          renderLogList(logs.batch2.btc, 'pic') +
          '<input type="text" class="ui-input" id="btc2-' + rowIndex + '" placeholder="Thêm tiến độ làm việc của BTC (ghi khi bấm Lưu)…"></div>' +
      '</div>';
  }

  function buildHandlerOptions(pic, currentHandler) {
    var group = (pic && window.WA_PIC_GROUPS && window.WA_PIC_GROUPS[pic]) ? window.WA_PIC_GROUPS[pic] : (window.WA_HANDLER_OPTIONS || []);
    var opts = group.map(function (h) {
      return '<option value="' + escapeHtml(h) + '"' + (h === currentHandler ? ' selected' : '') + '>' + escapeHtml(h) + '</option>';
    }).join('');
    return '<option value="">— chọn người xử lý' + (pic ? (' (nhóm ' + escapeHtml(pic) + ')') : '') + ' —</option>' + opts;
  }

  function renderReplyCard(r) {
    window.WA_MAIL_BY_ROW[r.rowIndex] = { data: r, listKind: 'replies' };
    var kmPhuTag = r.kmChinh ? '<span class="chip km-phu">KM phụ của ' + escapeHtml(r.kmChinh) + '</span> ' : '';
    var statusOpts = (window.WA_STATUS_OPTIONS || ['Mới', 'Đã xử lý', 'Cần follow-up']).map(function (s) {
      return '<option value="' + escapeHtml(s) + '"' + (s === r.status ? ' selected' : '') + '>' + escapeHtml(s) + '</option>';
    }).join('');
    var gmailUrl = r.threadId ? ('https://mail.google.com/mail/u/0/#all/' + encodeURIComponent(r.threadId)) : '';
    var titleName = r.senderName || r.hoTen || ('Mã KM ' + r.maKM);
    var idPrefix = 'replies-' + r.rowIndex;
    var logs = r.batchLogs || { batch1: { phanhoi: [], btc: [] }, batch2: { phanhoi: [], btc: [] } };

    return '<div class="mail-card" id="reply-card-' + r.rowIndex + '">' +
      '<div class="mail-card__head">' +
        '<span class="who">' + escapeHtml(titleName) + '</span>' +
        '<span class="km">' + escapeHtml(r.maKM) + '</span>' +
        kmPhuTag +
        (gmailUrl ? '<a href="' + gmailUrl + '" target="_blank" rel="noopener" class="thread-link">↗ Mở thread trong Gmail</a>' : '') +
        '<span class="spacer"></span>' +
        '<span class="when">' + escapeHtml(r.time) + '</span>' +
      '</div>' +
      '<div class="mail-card__left">' +
        '<dl class="meta-grid">' +
          '<dt>Khách mời</dt><dd><strong>' + escapeHtml(r.hoTen || '') + '</strong></dd>' +
          '<dt>Đơn vị</dt><dd>' + escapeHtml(r.donVi || '') + '</dd>' +
          '<dt>Phụ trách</dt><dd>' + (r.pic ? '<span class="chip pic">👤 ' + escapeHtml(r.pic) + '</span> ' : '') + (r.handler ? '<span class="chip support">🧑‍💼 Hỗ trợ: ' + escapeHtml(r.handler) + '</span>' : '') + '</dd>' +
        '</dl>' +
        (r.subject ? '<div class="subject-line">' + escapeHtml(r.subject) + '</div>' : '') +
        (r.content ? '<div class="mail-body">' + escapeHtml(r.content.substring(0, 500)) + '</div>' : '') +
