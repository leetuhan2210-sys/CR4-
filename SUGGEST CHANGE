.no-code { display: inline-block; font-size: 12px; font-weight: 700; color: #92400E; background: var(--warn-light); border: 1px solid #FCD9A0; border-radius: 5px; padding: 1px 7px; }

/* ---- BẢNG TÍNH THÊM KM MỚI ---- */
table.nm-grid { font-size: 14.5px; }
