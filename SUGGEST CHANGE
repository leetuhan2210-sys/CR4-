  // ---------- LOG HELPER ----------
  function parseLogTextToItems(text, isPic) {
    if (!text || !text.trim()) return '<div class="log-item empty">Chưa có ghi chú</div>';
    var lines = text.split('\n');
    var html = '';
    var dateRegex = /^(\d{1,2}[.\/]\d{1,2})\s*[-:]?\s*(.*)$/;
 
    lines.forEach(function (line) {
      line = line.trim();
      if (!line) return;
      var m = line.match(dateRegex);
      var badgeCls = isPic ? 'badge-date pic' : 'badge-date';
      if (m) {
        html += '<div class="log-item"><span class="' + badgeCls + '">' + escapeHtml(m[1]) + '</span><span class="log-text">' + escapeHtml(m[2]) + '</span></div>';
      } else {
        html += '<div class="log-item"><span class="log-text">' + escapeHtml(line) + '</span></div>';
      }
    });
    return html || '<div class="log-item empty">Chưa có ghi chú</div>';
  }
 
  // ---------- RENDER TỪNG TRƯỜNG DỮ LIỆU ----------
  function renderField(f, accent) {
    var wrapId = 'field-' + f.col;
    var listAttr = '', datalistHtml = '';
    if (f.suggestions && f.suggestions.length) {
      var listId = 'dl-' + f.col;
      listAttr = ' list="' + listId + '"';
      datalistHtml = '<datalist id="' + listId + '">' + f.suggestions.map(function (s) { return '<option value="' + escapeHtml(s) + '">'; }).join('') + '</datalist>';
    }
 
    if (f.type === 'phone') {
      return '<div class="f full" id="' + wrapId + '"><label>' + escapeHtml(f.label) + '</label>' +
        (f.editable ? '<div class="sdt-box">' + waSdtEditorHtml(f.value) + '</div>'
                    : '<div class="sdt-chips">' + waSdtChips(f.value) + '</div>') +
        '<input type="hidden" data-col="' + f.col + '" value="' + escapeHtml(f.value) + '">' +
      '</div>';
    } 
    if (f.type === 'textarea' || f.logHelper) {
      var isPic = f.label && f.label.indexOf('BTC') !== -1;
      var targets = f.autoTargets ? f.autoTargets.join(',') : '';
      var listId = 'logList-' + f.col;
      var inputId = 'logInput-' + f.col;
 
      var parsedLogsHtml = parseLogTextToItems(f.value, isPic);
 
      var inputBlock = '';
      if (f.editable) {
        inputBlock =
          '<div class="log-add">' +
            '<input type="text" class="ui-input" id="' + inputId + '" placeholder="Thêm ghi chú mới…" onkeydown="if(event.key===\'Enter\'){event.preventDefault();addVisualLog(' + f.col + ',\'' + inputId + '\',\'' + listId + '\',[' + targets + '],' + isPic + ');}">' +
          '</div>';
      }
 
      var accentCls = accent ? (' ' + accent) : '';

      return '<div class="f full log-field' + accentCls + '" id="' + wrapId + '">' +
        '<label>' + escapeHtml(f.label) + '</label>' +
        '<input type="hidden" data-col="' + f.col + '" value="' + escapeHtml(f.value) + '">' +
        '<div class="log-list" id="' + listId + '">' + parsedLogsHtml + '</div>' +
        inputBlock +
      '</div>';
    }
 
    if (!f.editable && !f.auto) {
      var displayVal = f.value ? escapeHtml(f.value) : '<span class="val empty">Chưa gán</span>';
      return '<div class="f ' + (isFull ? 'full' : '') + '" id="' + wrapId + '">' +
        '<label>' + escapeHtml(f.label) + '</label>' +
        '<div class="val">' + displayVal + '</div>' +
      '</div>';
    }
 
    if (f.auto) {
      return '<div class="f ' + (isFull ? 'full' : '') + '" id="' + wrapId + '">' +
        '<label>' + escapeHtml(f.label) + '</label>' +
        '<div class="val" id="auto-' + f.col + '">' +
          (f.value ? escapeHtml(f.value) : '<span style="color:var(--ink-soft);font-style:italic">chưa nhận phản hồi</span>') +
          ' <span style="color:var(--ink-soft);font-weight:400;font-size:12.5px;">(tin nhận về gần nhất)</span>' +          
        '</div>' +
        '<input type="hidden" data-col="' + f.col + '" value="' + escapeHtml(f.value) + '">' +
      '</div>';
    }
 
    if (f.type === 'multiselect' && f.options) {
      var checked = f.selectedValues || [];
      var boxesHtml = f.options.map(function (o, idx) {
        var cid = 'ms-' + f.col + '-' + idx;
        var isChecked = checked.indexOf(o) !== -1;
        return '<label style="display:inline-flex;align-items:center;gap:6px;margin:4px 12px 4px 0;font-weight:400;" for="' + cid + '">' +
          '<input type="checkbox" id="' + cid + '" value="' + escapeHtml(o) + '"' +
          (isChecked ? ' checked' : '') + (f.editable ? '' : ' disabled') +
          ' onchange="onMultiSelectChange(' + f.col + ')">' +
          '<span>' + escapeHtml(o) + '</span>' +
        '</label>';
      }).join('');

      return '<div class="f ' + (isFull ? 'full' : '') + '" id="' + wrapId + '">' +
        '<label>' + escapeHtml(f.label) + '</label>' +
        '<div class="ms-group" data-col="' + f.col + '" style="display:flex;flex-wrap:wrap;">' + boxesHtml + '</div>' +
        '<input type="hidden" data-col="' + f.col + '" value="' + escapeHtml(f.value) + '">' +
      '</div>';
    }
    
    if (f.type === 'select' && f.options) {
      var hasCustom = f.value && f.options.indexOf(f.value) === -1;
      var selectHtml = '<select class="ui-select" data-col="' + f.col + '" ' + (f.editable ? '' : 'disabled') + ' onchange="markChanged(this)">' +
        '<option value="">— chọn —</option>' +
        (hasCustom ? '<option value="' + escapeHtml(f.value) + '" selected>' + escapeHtml(f.value) + '</option>' : '') +
        f.options.map(function (o) { return '<option value="' + escapeHtml(o) + '"' + (o === f.value ? ' selected' : '') + '>' + escapeHtml(o) + '</option>'; }).join('') +
        '</select>';
 
      return '<div class="f ' + (isFull ? 'full' : '') + '" id="' + wrapId + '">' +
        '<label>' + escapeHtml(f.label) + '</label>' +
        selectHtml +
      '</div>';
    }
 
    return '<div class="f ' + (isFull ? 'full' : '') + '" id="' + wrapId + '">' +
      '<label>' + escapeHtml(f.label) + '</label>' +
      '<input type="text" class="ui-input" data-col="' + f.col + '"' + listAttr + ' value="' + escapeHtml(f.value) + '" ' + (f.editable ? '' : 'disabled') + ' oninput="markChanged(this)">' + datalistHtml +
    '</div>';
  }
 
  // ---------- RENDER PANEL/SECTION TÁCH BIỆT ----------
  function renderSectionPanel(s) {
    if (s.collapsedByDefault) {
      var vnFields = s.fields.map(renderField).join('');
      return '<div class="vn-toggle-row">' +
        '<button type="button" class="vn-toggle" id="vnToggleBtn" onclick="toggleSection(\'' + s.key + '\')">Hiện thêm bản tiếng Việt ▾</button>' +
        '<div class="collapsible" id="sec-' + s.key + '"><div class="grid-2">' + vnFields + '</div></div>' +
      '</div>';
    }
 
    var isBatch = s.accent;
    var panelCls = 'panel-card sec ' + waToneHoSo(s);
    var gridCls = (s.columns === 3) ? 'grid-3' : 'grid-2';

    var normalFields = [], logFields = [];
    s.fields.forEach(function (f) {
      if (f.logHelper) logFields.push(f);
      else normalFields.push(f);
    });

    var html = '<div class="' + panelCls + '">' +
      (s.title ? '<h2>' + escapeHtml(s.title) + '</h2>' : '') +
      (s.desc ? '<p class="panel-desc">' + escapeHtml(s.desc) + '</p>' : '') +
      '<div class="' + gridCls + '">' + normalFields.map(function(f){ return renderField(f); }).join('') + '</div>';

    if (logFields.length > 0) {
      html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px">' +
        logFields.map(function(f) {
           var originalType = f.type;
           f.type = 'textarea';
           return renderField(f, isBatch);
        }).join('') +
      '</div>';
    }
    html += '</div>';
    return html;
  }
 
  // ---------- RENDER TOÀN BỘ HỒ SƠ DETAIL ----------
  function renderDetail(detail, targetId) {
    var target = targetId || 'detailPanel';
    // Chỉ 1 hồ sơ được vẽ tại 1 thời điểm (tránh trùng id giữa tab Tra cứu và khung bên cạnh).
    if (target === 'detailPanel') closeGuestDrawer(true);
    else document.getElementById('detailPanel').innerHTML = '';
    window.WA_DETAIL_ROOT = target;
    currentGuest = { ref: detail.ref || detail.maKM, maKM: detail.maKM, thieuMaKM: !!detail.thieuMaKM, rowIndex: detail.rowIndex, original: {} };
    detail.sections.forEach(function (s) { s.fields.forEach(function (f) { currentGuest.original[f.col] = f.value; }); });
 
    var mainName = '', roleDesc = '', orgName = '', supportStaff = '', phuTrach = '';
    detail.sections.forEach(function (s) {
      s.fields.forEach(function (f) {
        var lbl = (f.label || '').toLowerCase();
