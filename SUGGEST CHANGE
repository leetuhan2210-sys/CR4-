        var poolC = nmSubsCuaNhieu(NM.common.linhVuc);
        NM.common.subSector = waGop(waTach(NM.common.subSector).filter(function (b) { return nmTimTrongDs(poolC, b); }));
      }      
      ['linhVuc', 'subSector'].forEach(function (k) { var c = document.getElementById('nmc-' + k); if (c) c.value = NM.common[k] || ''; });
      var cs = document.getElementById('nmc-subSector');
      if (cs) cs.setAttribute('list', nmSubList(NM.common));
      document.querySelectorAll('.nm-cell[data-key="linhVuc"]').forEach(function (i) { i.placeholder = NM.common.linhVuc || ''; });
      document.querySelectorAll('.nm-cell[data-key="subSector"]').forEach(function (i) {
        var rr = nmRowById(i.dataset.id) || {};
