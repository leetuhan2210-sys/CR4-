</div>
 
<div class="modal-backdrop" id="helpModal" onclick="if(event.target===this) toggleHelp()">
  <div class="modal" style="max-width:1000px">
    <div class="modal-header"><strong>Phím tắt</strong><button class="btn btn-secondary btn-sm" onclick="toggleHelp()">Đóng</button></div>
