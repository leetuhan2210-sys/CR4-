  }
  // Luôn đọc mới từ sheet, đồng thời cập nhật danh sách cho hộp chọn của tab Thêm KM mới.
  function lvNapLai() {
    document.getElementById('lvBang').innerHTML = '<div class="spinner">Đang đọc THIẾT LẬP FILE...</div>';
    waLaySectorMap(true).then(function (map) {
      if (!map || !map.sectors) {
        document.getElementById('lvBang').innerHTML = '<div class="error-box">Không đọc được danh sách Lĩnh vực / Sub-sector từ THIẾT LẬP FILE.</div>';
        return;
      }
      LV.map = map;
      var d = new Date();
      LV.luc = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
      lvVe();
    });
  }
  function lvDanhDau(text, q) {
    var s = String(text || ''), i = q ? s.toLowerCase().indexOf(q) : -1;
    if (i === -1) return escapeHtml(s);
    return escapeHtml(s.slice(0, i)) + '<mark>' + escapeHtml(s.slice(i, i + q.length)) + '</mark>' + escapeHtml(s.slice(i + q.length));
  }

  function lvVe() {
    var map = LV.map;
    if (!map) return;
    var qRaw = (document.getElementById('lvTim').value || '').trim(), q = qRaw.toLowerCase(), n = fNorm(qRaw);
    var tongSub = 0, html = '';
    map.sectors.forEach(function (sec, i) {
      var subs = map.subs[sec] || [];
      tongSub += subs.length;
      var trungSec = !n || fNorm(sec).indexOf(n) !== -1;
      var ds = trungSec ? subs : subs.filter(function (b) { return fNorm(b).indexOf(n) !== -1; });
      if (!trungSec && !ds.length) return;
      var span = Math.max(ds.length, 1);
      var oSec = '<td class="nowrap lv-sec-o" rowspan="' + span + '">' + (i + 1) + '</td>' +
        '<td class="lv-sec-o" rowspan="' + span + '"><strong>' + lvDanhDau(sec, q) + '</strong>' +
        '<div class="lv-dem">' + subs.length + ' Sub-sector</div></td>';
      if (!ds.length) {
        html += '<tr class="lv-dau">' + oSec + '<td><span class="lv-none">(không có Sub-sector)</span></td></tr>';
        return;
      }
      ds.forEach(function (b, k) {
        html += '<tr' + (k === 0 ? ' class="lv-dau"' : '') + '>' + (k === 0 ? oSec : '') +
          '<td class="lv-sub-o" data-v="' + escapeHtml(b) + '" title="Bấm để copy">' + lvDanhDau(b, q) + '</td></tr>';
      });
    });
    document.getElementById('lvMeta').innerHTML = '<strong>' + map.sectors.length + '</strong> Lĩnh vực · <strong>' + tongSub +
      '</strong> Sub-sector · đọc từ sheet lúc ' + LV.luc + (n ? ' · đang lọc theo “' + escapeHtml(qRaw) + '”' : '');
    document.getElementById('lvBang').innerHTML = html
      ? '<div class="ftable-wrap" style="max-height:none;overflow:visible"><table class="ftable lv-bang"><thead><tr><th>#</th><th>Lĩnh vực</th><th>Sub-sector</th></tr></thead><tbody>' +
        html + '</tbody></table></div>'
      : '<div class="empty-state">Không có Lĩnh vực / Sub-sector nào khớp.</div>';
  }
  document.addEventListener('click', function (e) {
    var s = e.target && e.target.closest ? e.target.closest('#lvBang [data-v]') : null;    
    if (!s) return;
    var v = s.dataset.v;
    if (navigator.clipboard) navigator.clipboard.writeText(v).then(function () { showToast('Đã copy: ' + v); }).catch(function () {});
  });  
  // ================= ĐIỀU HƯỚNG BÀN PHÍM TRONG BẢNG TÍNH =================
  // ←/→ chỉ nhảy ô khi con trỏ đã ở đầu/cuối chữ, nên vẫn gõ sửa chữ bình thường.
  function nmColKeys() { return nmVisibleFields().map(function (f) { return f.key; }); }

  function nmFocusCell(rowIdx, colIdx) {
    var keys = nmColKeys();
    if (rowIdx < 0 || rowIdx >= NM.rows.length || colIdx < 0 || colIdx >= keys.length) return false;
    var el = document.querySelector('.nm-cell[data-id="' + NM.rows[rowIdx]._id + '"][data-key="' + keys[colIdx] + '"]');
    if (!el) return false;
    el.focus();
    try { el.setSelectionRange(0, el.value.length); } catch (err) {}
    if (el.scrollIntoView) el.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    return true;
  }

  function nmMove(t, dRow, dCol, denCuoi) {
    var keys = nmColKeys();
    var r = nmRowIndex(t.dataset.id);
    var c = keys.indexOf(t.dataset.key);
    if (r < 0 || c < 0) return;
    if (denCuoi) {
      if (dRow > 0) r = NM.rows.length - 1; else if (dRow < 0) r = 0;
      if (dCol > 0) c = keys.length - 1; else if (dCol < 0) c = 0;
    } else { r += dRow; c += dCol; }
    if (c < 0) c = 0;
    if (c > keys.length - 1) c = keys.length - 1;
    if (r < 0) r = 0;
    if (r > NM.rows.length - 1) {          // xuống quá dòng cuối -> tự thêm dòng mới
      nmAddRows(1, true); nmRenderGrid();
      r = Math.min(r, NM.rows.length - 1);
    }
    nmFocusCell(r, c);
  }

  // Tô viền ô đang đứng để không bị lạc khi bảng rộng
  document.addEventListener('focusin', function (e) {
    var t = e.target;
    document.querySelectorAll('td.nm-focus').forEach(function (td) { td.classList.remove('nm-focus'); });
    if (t.classList && t.classList.contains('nm-cell') && t.parentNode) t.parentNode.classList.add('nm-focus');
  });

  document.addEventListener('keydown', function (e) {
    var t = e.target;
    if (!t.classList || !t.classList.contains('nm-cell')) return;
    var ctrl = e.ctrlKey || e.metaKey;
    var dau = true, cuoi = true;
    try { dau = (t.selectionStart === 0 && t.selectionEnd === 0); cuoi = (t.selectionStart === t.value.length && t.selectionEnd === t.value.length); } catch (err) {}

    if (e.key === 'Enter' && e.altKey) { e.preventDefault(); nmAddRows(1); return; }
    if (e.key === 'Enter') { e.preventDefault(); nmMove(t, e.shiftKey ? -1 : 1, 0); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); nmMove(t, 1, 0, ctrl); return; }
    if (e.key === 'ArrowUp') { e.preventDefault(); nmMove(t, -1, 0, ctrl); return; }
    if (e.key === 'ArrowRight' && (cuoi || ctrl)) { e.preventDefault(); nmMove(t, 0, 1, ctrl); return; }
    if (e.key === 'ArrowLeft' && (dau || ctrl)) { e.preventDefault(); nmMove(t, 0, -1, ctrl); return; }
    if (e.key === 'Home' && ctrl) { e.preventDefault(); nmMove(t, 0, -1, true); return; }
    if (e.key === 'End' && ctrl) { e.preventDefault(); nmMove(t, 0, 1, true); return; }
    if (ctrl && (e.key === 'd' || e.key === 'D')) {      // chép ô ngay trên xuống
      e.preventDefault();
      var r = nmRowIndex(t.dataset.id);
      if (r > 0) {
        var tren = NM.rows[r - 1][t.dataset.key] || '';
        t.value = tren; NM.rows[r][t.dataset.key] = tren;
        nmSaveDraftSoon();
      }
      return;
    }
  });

  // ----- Bản nháp: lưu trên trình duyệt, tách riêng theo tài khoản đăng nhập -----
  function nmSaveDraft() {
    try {
      localStorage.setItem(nmDraftKey(), JSON.stringify({
        rows: NM.rows.filter(nmRowHasData), common: NM.common, show: NM.show
      }));
    } catch (e) {}
  }
  function nmSaveDraftSoon() {
    clearTimeout(nmDraftTimer);
    nmDraftTimer = setTimeout(nmSaveDraft, 600);
  }
  function nmLoadDraft() {
    try {
      var raw = localStorage.getItem(nmDraftKey());
      if (!raw) { // chuyển nháp của bản trước (nếu có) sang bản này
        raw = localStorage.getItem('WA_NM_DRAFT_v2');
        if (raw) localStorage.removeItem('WA_NM_DRAFT_v2');
      }
      var d = JSON.parse(raw || 'null');
      if (!d) return 0;
      NM.common = d.common || {};
      if (d.show) Object.keys(NM.show).forEach(function (g) { if (d.show[g] !== undefined) NM.show[g] = d.show[g]; });
      (d.rows || []).forEach(function (r) {
        r._id = NM.nextId++;
        if (!r._uid) r._uid = nmUid();
        NM.rows.push(r);
      });
      return (d.rows || []).length;
    } catch (e) { return 0; }
  }

  // ----- Gửi lên server -----
  function nmCollect() {
    return NM.rows.filter(nmRowHasData).map(function (r) {
      var o = { _id: r._id, _uid: r._uid };
      Object.keys(r).forEach(function (k) {
        if (k === '_id' || k === '_uid' || !NM.byKey[k]) return;
        var v = (r[k] || '').toString().trim();
        if (v && NM.byKey[k].vietHoa) v = nmVietHoa(v, NM.byKey[k].vietHoa);
        if (v) o[k] = v;        
      });
      return o;
    });
  }

  // Chặn ngay trên trình duyệt nếu còn ô bắt buộc trống (máy chủ vẫn kiểm tra lại lần nữa).
  function nmChanBatBuoc() {
    var issues = {}, n = 0;
    NM.rows.forEach(function (r) {
      if (!nmRowHasData(r)) return;
      var errs = [];
      NM.meta.fields.forEach(function (f) {
        if (!nmThieu(r, f)) return;
        errs.push({ key: f.key, msg: (f === NM.fLinhVuc)
          ? 'Bắt buộc chia Lĩnh vực (Đối tượng "' + nmGiaTri(r, NM.fDoiTuong) + '" không thuộc nhóm được miễn)'
          : (f.key === 'subSector'
            ? 'Bắt buộc chọn Sub-sector cho Lĩnh vực "' + nmGiaTri(r, NM.fLinhVuc || NM.byKey.linhVuc) + '"'
            : 'Bắt buộc nhập: ' + f.label) });
      });
      var cap = nmLoiCapDanhXung(r);
      if (cap) errs.push(cap);
      var loiSub = nmLoiSub(r);
      if (NM.byKey.sdt && (r.sdt || '').toString().trim()) {
        WA_chuanHoaSdt_(r.sdt).loi.forEach(function (x) { errs.push({ key: 'sdt', msg: 'Số điện thoại: ' + x }); });
      }      
      if (errs.length) { issues[r._id] = { errors: errs, warnings: [] }; n += errs.length; }
    });
    if (!n) return false;
    NM.issues = issues;
    nmRenderGrid();
    showToast('Còn ' + n + ' lỗi (ô tô đỏ, chi tiết dưới bảng). Chưa gửi lên máy chủ.');
    nmCuonToiLoi();
    return true;
  }

  function nmApplyResults(results) {
    NM.issues = {};
    (results || []).forEach(function (res) {
      NM.issues[res.id] = { errors: res.errors || [], warnings: res.warnings || [] };
      var r = nmRowById(res.id);
      if (r && res.norm) Object.keys(res.norm).forEach(function (k) { r[k] = res.norm[k]; });
    });
    nmRenderGrid();
    nmSaveDraft();
  }

  function nmCountIssues(results) {
    var e = 0, w = 0;
    (results || []).forEach(function (x) { e += (x.errors || []).length; w += (x.warnings || []).length; });
    return { e: e, w: w };
  }

  function nmCheck() {
    var rows = nmCollect();
    if (!rows.length) { showToast('Chưa có dòng nào có dữ liệu.'); return; }
    if (nmChanBatBuoc()) return;
    document.getElementById('nmError').innerHTML = '';
    var btn = document.getElementById('nmBtnCheck');
    var label = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = 'Đang kiểm tra…';
    gs('WA_checkNewGuests', rows, NM.common).then(function (res) {
      btn.disabled = false; btn.innerHTML = label;
      if (res.nextRow) NM.meta.nextRow = res.nextRow;
      nmApplyResults(res.results);
      var c = nmCountIssues(res.results);
      showToast(c.e || c.w ? ('Có ' + c.e + ' lỗi, ' + c.w + ' cảnh báo. Xem danh sách dưới bảng.') : 'Không phát hiện lỗi, có thể lưu.');
      if (c.e || c.w) nmCuonToiLoi();
    }).catch(function (err) {
      btn.disabled = false; btn.innerHTML = label;
      showError('nmError', err);
    });
  }

  function nmSave(force) {
    var rows = nmCollect();
    if (!rows.length) { showToast('Chưa có dòng nào có dữ liệu.'); return; }
    if (rows.length > NM.meta.maxRows) { showError('nmError', 'Mỗi lần lưu tối đa ' + NM.meta.maxRows + ' dòng. Hãy lưu thành nhiều đợt.'); return; }
    if (nmChanBatBuoc()) return;
    document.getElementById('nmError').innerHTML = '';
    var btn = document.getElementById('nmBtnSave');
    btn.disabled = true;
    btn.classList.remove('done');
    btn.classList.add('btn-saving');
    btn.innerHTML = 'Đang lưu ' + rows.length + ' dòng…';
    var finish = function () { btn.disabled = false; btn.classList.remove('btn-saving', 'done'); nmUpdateCount(); };

    gs('WA_addNewGuests', rows, NM.common, !!force).then(function (res) {
      finish();
      nmApplyResults(res.results);
      if (res.ok) { nmOnSaved(res); return; }
      var c = nmCountIssues(res.results);
      if (res.needConfirm) {
        setTimeout(function () {
          nmCuonToiLoi();
          if (confirm('Có ' + c.w + ' cảnh báo (tô vàng, chi tiết ngay dưới bảng).\n\n' +
            'Nếu vẫn lưu, các cảnh báo này sẽ được ghi kèm vào nhật ký WA_Log_Chinh_Sua để quản lý xem lại.\n\nVẫn lưu tất cả?')) nmSave(true);
        }, 60);
        return;
      }
      showError('nmError', 'Có ' + c.e + ' lỗi cần sửa (ô tô đỏ, xem danh sách dưới bảng). Chưa có dòng nào được lưu.');
      nmCuonToiLoi();
    }).catch(function (err) {
      finish();
      showError('nmError', err);
    });
  }

  function nmOnSaved(res) {
    var ids = {};
    res.created.forEach(function (c) { ids[c.id] = true; });
    NM.rows = NM.rows.filter(function (r) { return !ids[r._id]; });
    NM.issues = {};
    if (res.nextRow) NM.meta.nextRow = res.nextRow;
    nmEnsureBlankRows(5);
    nmRenderGrid();
    nmSaveDraft();
    window.WA_FILTER_OPTIONS = null; // để tab Bộ lọc nạp lại lựa chọn mới
    showToast('Đã thêm ' + res.created.length + ' KM mới.');

    var notes = (res.notes || []).map(function (t) { return '<div class="nm-note">⚠️ ' + escapeHtml(t) + '</div>'; }).join('');
    document.getElementById('nmResult').innerHTML =
      '<div class="panel-card"><h2>✅ VỪA THÊM ' + res.created.length + ' KM (bấm vào dòng để mở hồ sơ)</h2>' + notes +
      '<div class="ftable-wrap"><table class="ftable"><thead><tr><th>Mã KM</th><th>Họ tên</th><th>Đơn vị</th><th>Dòng trong TEST</th></tr></thead><tbody>' +
      res.created.map(function (c) {
        var _ref = c.maKM || ('#' + c.row);
        var click = ' onclick="jumpToGuest(\'' + String(_ref).replace(/'/g, "\\'") + '\')"';
        return '<tr' + click + '>' +
          '<td class="nowrap"><strong>' + (c.maKM ? escapeHtml(c.maKM) : '<span style="color:var(--danger)">chưa có mã</span>') + '</strong></td>' +
          '<td>' + escapeHtml(c.fullName) + (c.daLuuTruoc ? ' <span class="nm-old">(đã lưu ở lần bấm trước)</span>' : '') + '</td>' +
          '<td>' + escapeHtml(c.org) + '</td>' +
          '<td>' + c.row + '</td></tr>';
      }).join('') +
      '</tbody></table></div></div>';
  }

  // ================= PHÍM TẮT TOÀN TRANG =================
  var WA_TAB_ORDER = ['search', 'replies', 'processing', 'unknown', 'filter', 'newguest'];

  function waDangGo(el) {
    if (!el) return false;
    var t = (el.tagName || '').toLowerCase();
    return t === 'input' || t === 'textarea' || t === 'select' || el.isContentEditable;
  }
  function waTabDangMo(key) {
    var p = document.getElementById('panel-' + key);
    return !!(p && p.classList.contains('active'));
  }
  function toggleHelp() {
    var m = document.getElementById('helpModal');
    if (m) m.classList.toggle('show');
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var m = document.querySelector('.modal-backdrop.show');
      if (m) { m.classList.remove('show'); return; }
      var p = document.querySelector('.fm-pop.show');
      if (p) { p.classList.remove('show'); return; }
      var ml = document.getElementById('miniLookupPanel');
      if (ml && ml.classList.contains('show')) { ml.classList.remove('show'); return; }
      if (waDangGo(e.target)) e.target.blur();
      return;
    }

    if (e.altKey && !e.ctrlKey && !e.metaKey && e.key >= '1' && e.key <= '6') {
      var btn = document.querySelector('.tab-btn[data-tab="' + WA_TAB_ORDER[parseInt(e.key, 10) - 1] + '"]');
      if (btn) { e.preventDefault(); btn.click(); }
      return;
    }
    if (e.altKey && (e.key === 'r' || e.key === 'R') && waTabDangMo('filter')) {
      e.preventDefault(); resetFilter(); return;
    }
    if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
      var sv = document.getElementById('btnSave');
      if (sv && waTabDangMo('search')) { e.preventDefault(); sv.click(); }
      return;
    }
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && waTabDangMo('filter')) {
      e.preventDefault(); runFilter(); return;
    }

    if (waDangGo(e.target)) return;
    if (e.key === '/') {
      e.preventDefault();
      document.querySelector('.tab-btn[data-tab="search"]').click();
      var si = document.getElementById('searchInput');
      if (si) { si.focus(); si.select(); }
      return;
    }
    if (e.key === '?') { e.preventDefault(); toggleHelp(); }
  });

  // ---------- KHỞI ĐỘNG ----------
  loadReplies();  
  loadProcessing();
  loadUnknown();
</script>
 
<!-- Nút tròn góc phải dưới -->
<button class="mini-lookup-btn" onclick="toggleMiniLookup()" title="Tra cứu nhanh mã KM">
  🔍
</button>
 
<!-- Panel tra cứu nhanh -->
<div class="mini-lookup-panel" id="miniLookupPanel">
  <h4>Tra cứu nhanh Mã KM</h4>
  <div style="display: flex; flex-direction: column; gap: 8px;">
    <input type="text" id="miniSearchName" placeholder="Nhập tên (VD: Nguyễn Văn A)..." onkeyup="if(event.key === 'Enter') runMiniLookup()">
    <input type="text" id="miniSearchOrg" placeholder="Nhập tổ chức (VD: World Economic Forum)..." onkeyup="if(event.key === 'Enter') runMiniLookup()">
  </div>
  <button class="btn btn-primary btn-sm" onclick="runMiniLookup()">Tìm kiếm</button>
  <div class="mini-results" id="miniResults"></div>
</div>
 
<script>
function toggleMiniLookup() {
  const panel = document.getElementById('miniLookupPanel');
  panel.classList.toggle('show');
  if(panel.classList.contains('show')) {
    document.getElementById('miniSearchName').focus();
  }
}
 
function runMiniLookup() {
  const nameQuery = document.getElementById('miniSearchName').value.trim();
  const orgQuery = document.getElementById('miniSearchOrg').value.trim();
  const resDiv = document.getElementById('miniResults');
  
  if(!nameQuery && !orgQuery) return;

  resDiv.innerHTML = '<div style="text-align:center; padding: 10px;">Đang tìm...</div>';
  
  google.script.run.withSuccessHandler(function(data) {
    resDiv.innerHTML = '';
    
    if (data.exact.length > 0) {
      renderMiniItems(data.exact, resDiv);
    } else if (data.fuzzy.length > 0) {
      resDiv.innerHTML = '<div class="mini-fuzzy-msg">⚠️ Không tìm thấy chính xác. Có phải bạn muốn tìm:</div>';
      renderMiniItems(data.fuzzy, resDiv);
    } else {
      resDiv.innerHTML = '<div style="color:red; text-align:center; padding: 10px;">Không tìm thấy kết quả nào phù hợp.</div>';
    }
  }).withFailureHandler(function(err) {
    resDiv.innerHTML = '<div style="color:red;">Lỗi: ' + err.message + '</div>';
  }).WA_miniLookup(nameQuery, orgQuery);
}
 
function renderMiniItems(list, container) {
  list.forEach(function(item) {
    const div = document.createElement('div');
    div.className = 'mini-item';
    div.style.display = 'flex';
    div.style.justifyContent = 'space-between';
    div.style.alignItems = 'center';
    
    const infoDiv = document.createElement('div');
    infoDiv.innerHTML = `<span class="ma">[${item.maKM}]</span> <strong>${item.hoTen}</strong><br><span style="color:#666">${item.donVi}</span>`;
    
    const copyBtn = document.createElement('button');
    copyBtn.innerHTML = '📋';
    copyBtn.title = 'Copy riêng Mã KM';
    copyBtn.style.background = 'none';
    copyBtn.style.border = 'none';
    copyBtn.style.cursor = 'pointer';
    copyBtn.style.fontSize = '16px';
    copyBtn.style.padding = '4px 8px';
    
    copyBtn.onclick = function(e) {
      e.stopPropagation(); 
      navigator.clipboard.writeText(item.maKM);
      alert('Đã copy mã KM: ' + item.maKM);
    };
    
    div.onclick = function() {
      const mainSearchInput = document.getElementById('searchInput'); 
      if (mainSearchInput) {
        mainSearchInput.value = item.maKM;
      }
      
      if (typeof selectGuest === 'function') {
        document.querySelector('.tab-btn[data-tab="search"]').click();
        selectGuest(item.ref || item.maKM);
      } else {
        const mainSearchBtn = document.querySelector('.search-bar button');
        if (mainSearchBtn) {
           mainSearchBtn.click();
        } else {
           console.warn("Vui lòng cập nhật đúng tên hàm load hồ sơ khách mời!");
        }
      }
      
      document.getElementById('miniLookupPanel').classList.remove('show');
    };
    
    div.appendChild(infoDiv);
    div.appendChild(copyBtn);
    container.appendChild(div);
  });
}
</script>
</body>
