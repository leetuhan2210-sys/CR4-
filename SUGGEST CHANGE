/* ---- BẢNG PHÍM TẮT ---- */
.kbd { display: inline-block; min-width: 24px; text-align: center; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12.5px; font-weight: 700; color: var(--ink); background: #fff; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; padding: 2px 7px; }
.help-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 20px 32px; }
.help-grid h4 { margin: 0 0 10px; font-size: 13.5px; color: var(--teal-800); text-transform: uppercase; letter-spacing: .03em; }
.help-grid table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
.help-grid td { padding: 5px 0; vertical-align: top; }
.help-grid td:first-child { width: 165px; white-space: nowrap; }
.btn-help { border: 1px solid var(--line); background: #fff; border-radius: 50%; width: 32px; height: 32px; font-size: 16px; font-weight: 700; color: var(--ink-soft); cursor: pointer; }
.btn-help:hover { color: var(--teal-800); border-color: var(--teal-700); }

/* ============================================================
   v5 — MÀU PHÂN BIỆT TỪNG NHÓM THÔNG TIN (dùng chung cho Hồ sơ, Bộ lọc, Thêm KM mới)
   Một màu = một nhóm dữ liệu, ở tab nào cũng giống nhau:
     Hồ sơ khách = xanh thép · Nội bộ/phân công = tím · Liên hệ = xanh ngọc
     Liên hệ đại diện = hồng · Đợt 1 = xanh WEF · Đợt 2 = vàng đồng · Hệ thống/tự động = xám
   ============================================================ */
:root {
  --c-profile: #1F5FA8;  --c-profile-bg: #F1F6FC;  --c-profile-line: #CFE0F3;
  --c-internal: #6D28D9; --c-internal-bg: #F6F2FF; --c-internal-line: #DDD0FA;
  --c-contact: #0F766E;  --c-contact-bg: #EDF8F6;  --c-contact-line: #C4E6E1;
  --c-proxy: #BE185D;    --c-proxy-bg: #FDF1F6;    --c-proxy-line: #F5CADB;
  --c-dot1: #0074C7;     --c-dot1-bg: #EEF6FD;     --c-dot1-line: #C6E0F5;
  --c-dot2: #B26B00;     --c-dot2-bg: #FFF7EA;     --c-dot2-line: #F2DDB6;
  --c-system: #5B6B7C;   --c-system-bg: #F4F6F9;   --c-system-line: #DCE2E9;
  --c-time: #0E7490;     --c-time-bg: #ECF8FB;     --c-time-line: #C3E6EE;
}
.tone-profile  { --sc: var(--c-profile);  --sb: var(--c-profile-bg);  --sl: var(--c-profile-line); }
.tone-internal { --sc: var(--c-internal); --sb: var(--c-internal-bg); --sl: var(--c-internal-line); }
.tone-contact  { --sc: var(--c-contact);  --sb: var(--c-contact-bg);  --sl: var(--c-contact-line); }
.tone-proxy    { --sc: var(--c-proxy);    --sb: var(--c-proxy-bg);    --sl: var(--c-proxy-line); }
.tone-dot1     { --sc: var(--c-dot1);     --sb: var(--c-dot1-bg);     --sl: var(--c-dot1-line); }
.tone-dot2     { --sc: var(--c-dot2);     --sb: var(--c-dot2-bg);     --sl: var(--c-dot2-line); }
.tone-system   { --sc: var(--c-system);   --sb: var(--c-system-bg);   --sl: var(--c-system-line); }
.tone-time     { --sc: var(--c-time);     --sb: var(--c-time-bg);     --sl: var(--c-time-line); }

/* Khối (panel) có màu: viền trái đậm + dải nền nhạt ở đầu + tiêu đề cùng màu */
.panel-card.sec { border-color: var(--sl); border-left: 5px solid var(--sc); background: linear-gradient(180deg, var(--sb) 0, var(--sb) 52px, #fff 52px); }
.panel-card.sec > h2 { color: var(--sc); display: flex; align-items: center; gap: 9px; text-transform: uppercase; letter-spacing: .04em; min-height: 26px; margin-bottom: 16px; }
.panel-card.sec > h2::before { content: ""; width: 10px; height: 10px; border-radius: 3px; background: var(--sc); flex-shrink: 0; }
.sec .ui-input:focus, .sec .ui-select:focus, .sec textarea.ui-textarea:focus { border-color: var(--sc); box-shadow: 0 0 0 3px var(--sb); outline: none; }
.sec .f label { color: var(--sc); opacity: .9; }
.sec .vn-toggle { color: var(--sc); }
.sec .collapsible.open { background: var(--sb); border-radius: 8px; padding: 12px; }

/* Tab Đợt 1 / Đợt 2 trong hồ sơ: gạch chân đúng màu đợt */
.detail-tab-btn[data-tab="batch1"].active { color: var(--c-dot1); border-bottom-color: var(--c-dot1); }
.detail-tab-btn[data-tab="batch2"].active { color: var(--c-dot2); border-bottom-color: var(--c-dot2); }

/* ---- BỘ LỌC: mỗi nhóm điều kiện là 1 khối màu ---- */
.fsec.sec { background: var(--sb); border: 1px solid var(--sl); border-left: 5px solid var(--sc); border-radius: 10px; padding: 16px 18px 18px; margin-bottom: 14px; }
.fsec.sec:first-child { padding-top: 16px; border-top: 1px solid var(--sl); }
.fsec.sec .fsec-head { color: var(--sc); }
.fsec.sec .fsec-idx { background: var(--sc); }
.fsec.sec .fm-btn.active { border-color: var(--sc); color: var(--sc); background: #fff; }
.fbatch.b1 { background: var(--c-dot1-bg); border-color: var(--c-dot1-line); }
.fbatch.b2 { background: var(--c-dot2-bg); border-color: var(--c-dot2-line); }
.fbatch.b1 h4 { color: var(--c-dot1); } .fbatch.b2 h4 { color: var(--c-dot2); }
.fbatch.b1::before { background: var(--c-dot1); } .fbatch.b2::before { background: var(--c-dot2); }

/* ---- THÊM KM MỚI ---- */
.nm-step { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--sc); color: #fff; font-size: 13px; letter-spacing: 0; }
.panel-card.sec > h2:has(.nm-step)::before { display: none; }
/* Giá trị chung: chia theo nhóm màu, mỗi nhóm 2 cột */
.nm-cgroups { display: flex; flex-direction: column; gap: 12px; }
.nm-cgroup { background: var(--sb); border: 1px solid var(--sl); border-left: 4px solid var(--sc); border-radius: 9px; padding: 10px 14px 14px; }
.nm-cg-head { font-size: 12.5px; font-weight: 700; color: var(--sc); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 8px; }
.nm-common-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 18px; }
@media (max-width: 760px) { .nm-common-grid { grid-template-columns: 1fr; } }
.nm-common-grid .ff label { color: var(--sc); }
.nm-common-grid .ui-input { background: #fff; }
.nm-common-grid .ui-input:focus { border-color: var(--sc); box-shadow: 0 0 0 3px rgba(0,0,0,.04); outline: none; }
.nm-common-grid .ff .nm-hint { font-size: 12px; color: var(--ink-soft); }
/* Chip bật/tắt nhóm cột mang đúng màu nhóm */
.nm-chip .nm-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--sc); }
.nm-chip:has(input:checked) { background: var(--sb); border-color: var(--sc); color: var(--sc); }
/* Bảng nhập: dải tên nhóm + tiêu đề cột + nền ô theo màu nhóm */
table.nm-grid tr.nm-band th { top: 0; height: 30px; padding: 4px 10px; font-size: 11.5px; letter-spacing: .05em; text-transform: uppercase; background: var(--sc); color: #fff; border-right: 2px solid #fff; }
table.nm-grid tr.nm-band th > span { position: sticky; left: 76px; }
table.nm-grid tr.nm-head th { top: 30px; background: var(--sb); color: var(--sc); border-bottom: 2px solid var(--sc); }
table.nm-grid tr.nm-head th .nm-col { color: var(--ink-soft); opacity: .8; }
table.nm-grid tr.nm-head th.req::after { color: var(--danger); }
table.nm-grid tr th.nm-idx { background: var(--teal-900); color: #fff; }
table.nm-grid td.tone-internal, table.nm-grid td.tone-contact, table.nm-grid td.tone-proxy,
table.nm-grid td.tone-dot1, table.nm-grid td.tone-dot2, table.nm-grid td.tone-system, table.nm-grid td.tone-profile { background: #fff; }
table.nm-grid td.tone-internal { background: #FBF9FF; } table.nm-grid td.tone-contact { background: #F7FCFB; }
table.nm-grid td.tone-proxy { background: #FEF8FB; } table.nm-grid td.tone-dot1 { background: #F7FBFE; }
table.nm-grid td.tone-dot2 { background: #FFFBF4; } table.nm-grid td.tone-system { background: #F8F9FB; }
table.nm-grid td.nm-grpstart { border-left: 2px solid var(--sl); }
table.nm-grid td.nm-err { background: #FDECEA; }
table.nm-grid td.nm-warn { background: var(--warn-light); }
table.nm-grid td.nm-miss { background: #FFF6F4; box-shadow: inset 3px 0 0 #E8A89F; }
table.nm-grid td.nm-focus { box-shadow: inset 0 0 0 2px var(--focus); }

/* ===== LĨNH VỰC / SUB-SECTOR NHIỀU LỰA CHỌN + BẢNG XEM DANH SÁCH ===== */
.lv-chips { display:flex; flex-wrap:wrap; gap:6px; margin:2px 0 6px; }
.lv-chip { font-size:13.5px; font-weight:600; padding:3px 11px; border-radius:20px; background:var(--c-profile-bg); color:var(--c-profile); border:1px solid var(--c-profile-line); }
.lv-chip.la { background:var(--warn-light); color:#92400E; border-color:#FCD9A0; }
.fg-pop.wa-mpop { z-index:90; width:410px; max-width:calc(100vw - 16px); max-height:420px; padding:8px; }
.wa-mpop-h { font-size:11.5px; font-weight:700; color:var(--c-profile); text-transform:uppercase; letter-spacing:.03em; margin:10px 6px 3px; }
.wa-mpop-h.warn { color:#92400E; }
.wa-mpop-empty { font-size:13px; color:var(--ink-soft); font-style:italic; padding:3px 8px; }
.nm-cell[data-key="linhVuc"], .nm-cell[data-key="subSector"], #nmc-linhVuc, #nmc-subSector { cursor:pointer; }

.lv-fab { position:fixed; right:86px; bottom:30px; z-index:100; display:none; align-items:center; gap:6px; height:42px; padding:0 18px; border:none; border-radius:21px; background:var(--c-profile); color:#fff; font-size:14px; font-weight:600; box-shadow:0 4px 12px rgba(0,0,0,.2); cursor:pointer; }
.lv-fab:hover { filter:brightness(1.08); }
body.tab-newguest .lv-fab { display:inline-flex; }
body.tab-newguest.lv-open .lv-fab { display:none; }
#lvDrawerBackdrop { z-index:72; }
#lvDrawer { z-index:73; width:min(720px,100vw); }
.lv-meta { font-size:13.5px; color:var(--ink-soft); margin:10px 0 12px; }
table.lv-bang td { vertical-align:top; }
table.lv-bang tbody tr:hover { background:transparent; }
.lv-subs { display:flex; flex-wrap:wrap; gap:6px; }
.lv-sub { font-size:13.5px; padding:3px 11px; border-radius:20px; background:var(--c-profile-bg); border:1px solid var(--c-profile-line); color:var(--c-profile); cursor:pointer; }
.lv-sub:hover { background:#fff; }
.lv-bang mark { background:#FFE58A; color:inherit; padding:0; }
.lv-dem { font-size:12px; color:var(--ink-soft); font-weight:400; }
.lv-none { font-size:13px; color:var(--ink-soft); font-style:italic; }
table.lv-bang tr.lv-dau > td { border-top:2px solid var(--c-profile-line); }
table.lv-bang td.lv-sec-o { background:var(--c-profile-bg); color:var(--c-profile); min-width:180px; }
table.lv-bang td.lv-sub-o { cursor:pointer; }
table.lv-bang td.lv-sub-o:hover { background:#F2F7FC; color:var(--c-profile); }

/* ===== SỐ ĐIỆN THOẠI NHIỀU SỐ ===== */
.sdt-list { display:flex; flex-direction:column; gap:8px; }
.sdt-row { display:grid; grid-template-columns:120px minmax(0,1fr) 40px; gap:8px; align-items:center; }
.sdt-row .ui-input { font-variant-numeric:tabular-nums; }
.sdt-row .sdt-so { letter-spacing:.03em; }
.sdt-row.loi .ui-input { border-color:var(--danger); background:#FDECEA; }
.sdt-del { height:40px; border:1px solid var(--line); background:#fff; border-radius:7px; cursor:pointer; color:var(--ink-soft); font-size:14px; }
.sdt-del:hover { color:var(--danger); border-color:var(--danger); }
.sdt-add { margin-top:8px; background:none; border:1px dashed var(--c-contact-line); border-radius:7px; padding:7px 12px; font-size:13.5px; font-weight:600; color:var(--c-contact); cursor:pointer; }
.sdt-add:hover { background:var(--c-contact-bg); border-style:solid; }
.sdt-msg { margin-top:6px; font-size:12.5px; color:var(--danger); }
.sdt-msg:empty { display:none; }
.sdt-chips { display:flex; flex-wrap:wrap; gap:6px; }
.sdt-chip { font-variant-numeric:tabular-nums; font-size:13.5px; padding:3px 11px; border-radius:20px; background:var(--c-contact-bg); color:var(--ink); border:1px solid var(--c-contact-line); white-space:nowrap; }
.sdt-chip b { color:var(--c-contact); font-weight:700; margin-right:5px; }
.sdt-chip.la { background:var(--warn-light); color:#92400E; border-color:#FCD9A0; }
.fg-pop.sdt-pop { z-index:90; width:440px; max-width:calc(100vw - 16px); max-height:none; padding:12px; }
.sdt-pop-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:12px; }
</style>
</head>
