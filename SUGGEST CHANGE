        '<div id="nmGrid"></div>' +
        '<div id="nmIssues"></div>' +
        '<div class="filter-actions">' +
          '<button class="btn btn-secondary" id="nmBtnCheck" onclick="nmCheck()">🔍 Kiểm tra trùng &amp; lỗi</button>' +
