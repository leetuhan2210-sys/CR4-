      if (fVal(p[0])) items.push({ loai: 'o', id: p[0], nhan: p[1], hien: fVal(p[0]) });
    });
    [['fltMode', 'Tình trạng'], ['fltDaiTho', 'Đài thọ'], ['fltLienHe', 'Liên hệ'], ['fltNote1', 'Ghi chú Đợt 1'], ['fltNote2', 'Ghi chú Đợt 2']].forEach(function (p) {      
      var v = fVal(p[0]);
      if (v && v !== 'all') items.push({ loai: 'o', id: p[0], nhan: p[1], hien: fText(p[0]), macDinh: (p[0] === 'fltMode' ? 'all' : '') });
    });
    window.WA_FILTER_CHIPS = items;
    box.innerHTML = items.map(function (it, i) {
      return '<span class="fchip"><b>' + escapeHtml(it.nhan) + ':</b> ' + escapeHtml(it.hien) +
        '<button type="button" data-idx="' + i + '" title="Bỏ tiêu chí này">×</button></span>';
    }).join('') + (items.length > 1 ? '<span class="fchip clear" onclick="resetFilter()">Xoá tất cả tiêu chí</span>' : '');
  }

  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest ? e.target.closest('.fchip button[data-idx]') : null;
    if (!b) return;
    var it = (window.WA_FILTER_CHIPS || [])[parseInt(b.dataset.idx, 10)];
    if (!it) return;
    if (it.loai === 'multi') {
      fmSet(it.k, fmValues(it.k).filter(function (x) { return x !== it.v; }));
    } else {
      var el = document.getElementById(it.id);
      if (el) el.value = it.macDinh || '';
    }
    renderFilterChips();
    runFilter();
  });
  function fmSet(key, vals) {
    vals = vals || [];
    document.querySelectorAll('#fmpop-' + key + ' input').forEach(function (cb) { cb.checked = vals.indexOf(cb.value) !== -1; });
    fmUpdate(key);
  }
  function fmPick(key, patterns) {
    var vals = [];
    document.querySelectorAll('#fmpop-' + key + ' input').forEach(function (cb) {
      var n = fNorm(cb.value);
      for (var i = 0; i < patterns.length; i++) if (n.indexOf(patterns[i]) !== -1) { vals.push(cb.value); break; }
    });
    fmSet(key, vals);
    return vals;
  }
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.fm')) document.querySelectorAll('.fm-pop.show').forEach(function (x) { x.classList.remove('show'); });
  });

  function noteSelect(id, label) {
    return '<div class="ff"><label>' + label + '</label><select class="ui-select" id="' + id + '" onchange="renderFilterChips()">' +
      '<option value="">Tất cả</option>' +
      '<option value="has">Đã có ghi chú phản hồi</option>' +
      '<option value="empty">Chưa có ghi chú phản hồi</option>' +
    '</select></div>';
  }

  function lienHeSelect(o) {
    var lh = (o && o.lienHe) || {};
    function opt(v, t) { return '<option value="' + v + '">' + t + (lh[v] === undefined ? '' : ' (' + lh[v] + ')') + '</option>'; }
    return '<div class="ff"><label>Thông tin liên hệ</label><select class="ui-select" id="fltLienHe" onchange="renderFilterChips()">' +
      '<option value="">Tất cả</option>' +
      opt('mot', 'Thiếu email HOẶC SĐT') + opt('email', 'Thiếu email chính') + opt('emailSai', 'Email sai định dạng') +
      opt('sdt', 'Thiếu số điện thoại') + opt('ca2', 'Thiếu cả email lẫn SĐT') +
    '</select></div>';
  }

  function renderFilterForm(o) {    
    document.getElementById('fgridTime').innerHTML =
      '<div class="ff"><label>Nhận phản hồi TỪ ngày</label><input type="date" class="ui-input" id="fltFrom" onchange="renderFilterChips()"></div>' +
      '<div class="ff"><label>ĐẾN ngày</label><input type="date" class="ui-input" id="fltTo" onchange="renderFilterChips()"></div>' +
      '<div class="ff wide"><label>Tình trạng phản hồi</label><select class="ui-select" id="fltMode" onchange="onModeChange()">' +
        '<option value="all">Tất cả</option>' +
        '<option value="inRange">Có mail nhận về trong khoảng ngày</option>' +
        '<option value="noReply1">Chưa phản hồi — Đợt 1</option>' +
        '<option value="noReply2">Chưa phản hồi — Đợt 2</option>' +
        '<option value="noReplyBoth">Chưa phản hồi — cả 2 đợt</option>' +
        '<option value="declined">Đã từ chối tham dự</option>' +
      '</select></div>' +
      '<div class="ff"><label>Từ khoá (tên / đơn vị / email / chức vụ)</label><input type="text" class="ui-input" id="fltKeyword" onchange="renderFilterChips()" onkeydown="if(event.key===\'Enter\') runFilter()"></div>';

    document.getElementById('fgridB1').innerHTML =
      fmBlock('tienDo1', 'Tiến độ liên hệ', o.tienDo1) +
      fmBlock('xacNhan1', 'Phản hồi tham dự', o.xacNhan1) +
      noteSelect('fltNote1', 'Ghi chú phản hồi (AL)');

    document.getElementById('fgridB2').innerHTML =
      fmBlock('tienDo2', 'Tiến độ liên hệ', o.tienDo2) +
      fmBlock('xacNhan2', 'Phản hồi tham dự', o.xacNhan2) +
      noteSelect('fltNote2', 'Ghi chú phản hồi (AQ)');

    document.getElementById('fgridProfile').innerHTML =
      fmBlock('doiTuong', 'Đối tượng', o.doiTuong) +
      fmBlock('phanLoai', 'Phân loại khách', o.phanLoai) +
      '<div class="ff"><label>Đài thọ</label><select class="ui-select" id="fltDaiTho" onchange="renderFilterChips()">' +
        '<option value="">Tất cả</option><option value="yes">Có đài thọ</option><option value="no">Không đài thọ</option></select></div>' +
      lienHeSelect(o) +        
      fmBlock('kenhMoi', 'Kênh mời', o.kenhMoi) +
      fmBlock('quocGia', 'Quốc gia', o.quocGia) +
      fmBlock('linhVuc', 'Lĩnh vực', o.linhVuc) +
      fmBlock('subSector', 'Sub-sector', o.subSector) +      
      fmBlock('pic', 'Phụ trách (PIC)', o.pic);

    var canhBao = '';
    if (o.missing && o.missing.length) {
      canhBao += '<div class="error-box">Không dò được các cột: <strong>' + escapeHtml(o.missing.join(', ')) +
        '</strong>. Lọc theo những cột này sẽ luôn ra 0 kết quả — kiểm tra lại tiêu đề dòng 4/5 của sheet TEST.</div>';
    }
    if (o.thieuMa) {
      canhBao += '<div class="nm-note">⚠️ Có <strong>' + o.thieuMa + '</strong> khách chưa có Mã KM. Họ vẫn hiện trong kết quả lọc và vẫn mở/sửa được hồ sơ, nhưng chưa ghép được với mail trong DATA MAIL.</div>';
    }
    document.getElementById('filterWarn').innerHTML = canhBao;
    renderFilterChips();
  }

  // Trước đây đổi "Tình trạng phản hồi" sẽ TỰ ĐỘNG tích thêm Tiến độ = "Đã gửi Mail".
  // Người dùng không thấy, nên lọc ra 0 dòng mà không hiểu vì sao. Nay chỉ đổi đúng thứ được chọn.
  function onModeChange() { renderFilterChips(); }

  function collectCriteria() {
    var c = {
      from: document.getElementById('fltFrom').value,
      to: document.getElementById('fltTo').value,
      replyMode: document.getElementById('fltMode').value,
      batchJoin: document.getElementById('fltBatchJoin').value,
      note1: document.getElementById('fltNote1').value,
      note2: document.getElementById('fltNote2').value,
      daiTho: document.getElementById('fltDaiTho').value,
      lienHe: document.getElementById('fltLienHe').value,      
      keyword: document.getElementById('fltKeyword').value
    };
    window.WA_FILTER_MULTI.forEach(function (k) { c[k] = fmValues(k); });
    return c;
  }

  function ymd(d) {
    return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
  }

  function resetFilter() {
    if (!window.WA_FILTER_OPTIONS) return;
    if (!FG_xacNhanBoSua()) return false;
    FG.criteria = null; FG.rows = []; FG.selected = {}; FG.msg = '';    
    ['fltFrom','fltTo','fltKeyword'].forEach(function (id) { document.getElementById(id).value = ''; });
    document.getElementById('fltMode').value = 'all';
    document.getElementById('fltBatchJoin').value = 'and';
    document.getElementById('fltNote1').value = '';
    document.getElementById('fltNote2').value = '';
    document.getElementById('fltDaiTho').value = '';
    document.getElementById('fltLienHe').value = '';    
    window.WA_FILTER_MULTI.forEach(function (k) { fmSet(k, []); });
    renderFilterChips();
    document.getElementById('filterStats').innerHTML = '';
    document.getElementById('filterResult').innerHTML = '<div class="empty-state">Chọn điều kiện rồi bấm “Lọc”.</div>';
  }

  function applyPreset(kind) {
    if (!window.WA_FILTER_OPTIONS) { initFilterTab(); showToast('Đang tải bộ lọc, bấm lại sau 1 giây.'); return; }
    if (resetFilter() === false) return;
    if (kind === 'week') {      
      var to = new Date(), from = new Date(); from.setDate(from.getDate() - 6);
      document.getElementById('fltFrom').value = ymd(from);
      document.getElementById('fltTo').value = ymd(to);
      document.getElementById('fltMode').value = 'inRange';
    } else if (kind === 'resend') {
      document.getElementById('fltMode').value = 'noReply1';
      showToast('Đang tính theo Đợt 1 — đổi dropdown “Tình trạng phản hồi” nếu muốn Đợt 2.');
    } else if (kind === 'contactissue') {
      document.getElementById('fltBatchJoin').value = 'or';
      fmPick('tienDo1', ['bi loi', 'chua lien he']);
      fmPick('tienDo2', ['bi loi', 'chua lien he']);
    } else if (kind === 'declined') {
      document.getElementById('fltMode').value = 'declined';
    } else if (kind === 'thieuLienHe') {
      document.getElementById('fltLienHe').value = 'mot';
    }    
    runFilter();
  }

// ================= BẢNG KẾT QUẢ LỌC + SỬA NHANH + KHUNG HỒ SƠ =================
  var FG = {
    meta: [], metaByKey: {}, groups: [], showGroups: {},
    rows: [], total: 0, stats: null, criteria: null,
    editMode: false, dirty: {}, conflict: {}, selected: {}, bulkKey: '', msg: ''
  };
  var FG_PAGE = 100;

  function FG_initMeta(o) {
    FG.meta = (o.grid || []).filter(function (m) { return m.co; });
    FG.metaByKey = {};
    FG.meta.forEach(function (m) {
      FG.metaByKey[m.key] = m;
      if (m.key === 'linhVuc' || m.key === 'subSector') waNapBiet(m.options);
    });    
    FG.groups = o.gridGroups || [];
  }

  function FG_soSua() { return Object.keys(FG.dirty).length; }
  function FG_soChon() { return Object.keys(FG.selected).length; }

  // Hỏi trước khi bỏ các ô đã sửa mà chưa lưu. Trả về false nếu người dùng chọn giữ lại.
  function FG_xacNhanBoSua() {
    var n = FG_soSua();
    if (n && !confirm('Có ' + n + ' ô đã sửa trên bảng nhưng chưa lưu. Bỏ các thay đổi này?')) return false;
    FG.dirty = {}; FG.conflict = {};
    return true;
  }

  function runFilter() {
    if (!FG_xacNhanBoSua()) { FG_render(); return; }
    document.getElementById('filterError').innerHTML = '';
    document.getElementById('filterResult').innerHTML = '<div class="spinner">Đang lọc dữ liệu...</div>';
    window.WA_LAST_CRITERIA = collectCriteria();
    FG.criteria = window.WA_LAST_CRITERIA;
    gs('WA_filterGuests', FG.criteria, 0, FG_PAGE).then(function (res) {
      FG.rows = res.rows; FG.total = res.total; FG.stats = res;
      FG.selected = {}; FG.msg = '';
      FG_renderStats();
      FG_render();
    }).catch(function (err) {
      document.getElementById('filterResult').innerHTML = '';
      showError('filterError', err);
    });
  }

  function FG_hienThem() {
    var btn = document.getElementById('fgMoreBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Đang tải…'; }
    gs('WA_filterGuests', FG.criteria, FG.rows.length, FG_PAGE).then(function (res) {
      var co = {};
      FG.rows.forEach(function (r) { co[r.ref] = true; });
      res.rows.forEach(function (r) { if (!co[r.ref]) FG.rows.push(r); });
      FG.total = res.total;
      FG_renderStats();
      FG_render();
    }).catch(function (err) { showError('filterError', err); FG_render(); });
  }

  function FG_renderStats() {
    var res = FG.stats || {};
    document.getElementById('filterStats').innerHTML =
      '<strong>' + FG.total + '</strong> khách khớp' +
      (res.hasRange ? ' · <strong>' + res.guestInRange + '</strong> khách có mail nhận về trong khoảng · <strong>' + res.mailInRange + '</strong> mail nhận về' : '') +
      (res.tongKhach ? ' / ' + res.tongKhach + ' khách trên TEST' : '') +
      ' · đang hiện <strong>' + FG.rows.length + '</strong>';
  }

  // ---------- tiện ích ----------
  function FG_val(r, key) { var d = FG.dirty[r.ref + '|' + key]; return d ? d.value : r.v[key]; }
  function FG_str(v) { return (v === null || v === undefined) ? '' : String(v); }
  function FG_dongDau(v) { var s = FG_str(v).trim(); return s ? s.split('\n')[0] : ''; }
  function FG_rutGon(s, n) { s = FG_str(s); return s.length > n ? s.slice(0, n - 1) + '…' : s; }
  function FG_tachMulti(v) { return FG_str(v).split(',').map(function (x) { return x.trim(); }).filter(Boolean); }
  function FG_warnCls(v) { var n = fNorm(v); return (n.indexOf('bi loi') !== -1 || n.indexOf('chua lien he') !== -1) ? 'warn' : ''; }
  function FG_giongNhau(a, b, m) {
    if (m.type === 'checkbox') return (a === true) === (b === true);
    return FG_str(a) === FG_str(b);
  }
  function FG_timRow(ref) {
    for (var i = 0; i < FG.rows.length; i++) if (FG.rows[i].ref === ref) return FG.rows[i];
    return null;
  }
  function FG_cotHien() {
    return FG.meta.filter(function (m) { return m.group === 'base' || FG.showGroups[m.group]; });
  }
  function FG_thCls(m) { return m.batch === 1 ? 'b1' : (m.batch === 2 ? 'b2' : ''); }

  // ---------- hiển thị ô (chế độ xem) ----------
  function FG_viewHtml(r, m) {
    var v = r.v[m.key];
    if (m.type === 'phone') return v ? '<div class="sdt-chips">' + waSdtChips(v) + '</div>' : '<span class="fdot no">—</span>';
    if (m.type === 'checkbox') return v === true ? '<span class="fdot yes">✓</span>' : '<span class="fdot no">—</span>';
    if (m.type === 'log') {
      var d = FG_dongDau(v);
      return d ? '<span class="fg-log" title="' + escapeHtml(FG_str(v)) + '">' + escapeHtml(d) + '</span>' : '<span class="fdot no">—</span>';
    }
    if (m.key === 'tienDo1' || m.key === 'tienDo2') return v ? '<span class="fpill ' + FG_warnCls(v) + '">' + escapeHtml(v) + '</span>' : '';
    if (m.key === 'phanLoai') return v ? '<span class="fpill">' + escapeHtml(v) + '</span>' : '';
    return escapeHtml(FG_rutGon(v, 80));
  }

  // ---------- ô sửa (chế độ sửa nhanh) ----------
  function FG_editorHtml(r, i, m) {
    var val = FG_val(r, m.key);
    var k = '\'' + m.key + '\'';
    if (m.type === 'phone') {
      return '<button type="button" class="fg-in fg-multi" onclick="FG_moSdt(event,' + i + ',' + k + ')">' +
        escapeHtml(FG_str(val).split('\n').join('; ') || '— thêm số —') + '</button>';
    }
    if (m.type === 'checkbox') {
      return '<input type="checkbox"' + (val === true ? ' checked' : '') + ' onchange="FG_sua(' + i + ',' + k + ',this.checked)">';
    }
    if (m.type === 'select') {
      var opts = m.options || [], s = FG_str(val);
      return '<select class="fg-in" onchange="FG_sua(' + i + ',' + k + ',this.value)"><option value="">—</option>' +
        (s && opts.indexOf(s) === -1 ? '<option value="' + escapeHtml(s) + '" selected>' + escapeHtml(s) + '</option>' : '') +
        opts.map(function (o) { return '<option value="' + escapeHtml(o) + '"' + (o === s ? ' selected' : '') + '>' + escapeHtml(o) + '</option>'; }).join('') +
        '</select>';
    }
    if (m.type === 'multi') {
      return '<button type="button" class="fg-in fg-multi" onclick="FG_moMulti(event,' + i + ',' + k + ')">' +
        escapeHtml(FG_str(val) || '— chọn —') + '</button>';
    }
    if (m.type === 'log') {
      var goc = r.v[m.key], dau = FG_dongDau(goc);
      return '<div class="fg-logcell">' +
        (dau ? '<span class="fg-log" title="' + escapeHtml(FG_str(goc)) + '">' + escapeHtml(dau) + '</span>' : '<span class="fg-log">(chưa có)</span>') +
        '<input class="fg-in" placeholder="+ thêm mới (tự ghi dd.MM)" value="' + escapeHtml(FG_str(FG.dirty[r.ref + '|' + m.key] ? val : '')) + '" oninput="FG_sua(' + i + ',' + k + ',this.value)">' +
        '</div>';
    }
    if (m.type === 'longtext') {
      return '<textarea class="fg-in fg-ta" rows="1" oninput="FG_sua(' + i + ',' + k + ',this.value)">' + escapeHtml(FG_str(val)) + '</textarea>';
    }
    return '<input class="fg-in" value="' + escapeHtml(FG_str(val)) + '" oninput="FG_sua(' + i + ',' + k + ',this.value)">';
  }

  function FG_rowHtml(r, i, cols) {
    var cells = cols.map(function (m) {
      var id = r.ref + '|' + m.key;
      var cls = (FG.conflict[id] ? 'fg-conflict' : (FG.dirty[id] ? 'fg-dirty' : ''));
      return '<td class="' + cls + '" id="fgc-' + i + '-' + m.key + '">' + (FG.editMode ? FG_editorHtml(r, i, m) : FG_viewHtml(r, m)) + '</td>';
    }).join('');
    return '<tr>' +
      (FG.editMode ? '<td class="fg-ck"><input type="checkbox"' + (FG.selected[r.ref] ? ' checked' : '') + ' onchange="FG_chon(' + i + ',this.checked)"></td>' : '') +
      '<td class="nowrap">' + (r.maKM ? '<strong>' + escapeHtml(r.maKM) + '</strong>' : '<span class="no-code" title="Dòng ' + r.rowIndex + ' trên TEST">chưa có mã</span>') + '</td>' +
      '<td><a href="#" class="fg-name" title="Mở hồ sơ để sửa" onclick="openGuestDrawer(FG.rows[' + i + '].ref);return false;">' + escapeHtml(r.hoTen || '(chưa có tên)') + '</a></td>' +
      '<td>' + escapeHtml(FG_rutGon(r.donVi, 60)) + '</td>' +
      cells +
      '<td class="nowrap">' + (r.lastReply ? escapeHtml(r.lastReply) : '<span style="color:var(--ink-soft);font-style:italic">chưa có</span>') + '</td>' +
      '<td class="nowrap">' + (r.replyInRange ? r.replyInRange + '/' : '') + r.replyTotal + '</td>' +
    '</tr>';
  }

  function FG_bulkValHtml() {
    var m = FG.metaByKey[FG.bulkKey];
    if (!m) return '';
    if (m.type === 'select') {
      return '<select class="ui-select" id="fgBulkInput"><option value="">(để trống)</option>' +
        (m.options || []).map(function (o) { return '<option value="' + escapeHtml(o) + '">' + escapeHtml(o) + '</option>'; }).join('') + '</select>';
    }
    if (m.type === 'checkbox') return '<select class="ui-select" id="fgBulkInput"><option value="1">✓ Có</option><option value="0">Không</option></select>';
    if (m.type === 'multi') {
      return '<span class="fg-bulk-multi" id="fgBulkInput">' + (m.options || []).map(function (o) {
        return '<label><input type="checkbox" value="' + escapeHtml(o) + '"> ' + escapeHtml(o) + '</label>';
      }).join('') + '</span>';
    }
    if (m.type === 'log') return '<input class="ui-input" id="fgBulkInput" placeholder="Nội dung (tự thêm dd.MM phía trước)">';
    return '<input class="ui-input" id="fgBulkInput" placeholder="Giá trị mới (để trống = xoá ô)">';
  }

  function FG_render() {
    var el = document.getElementById('filterResult');
    if (!FG.criteria) return;
    if (!FG.rows.length) { el.innerHTML = (FG.msg || '') + FG_htmlGoiY(); return; }

    var cols = FG_cotHien();
    var nSel = FG_soChon(), nDirty = FG_soSua();

    var toolbar = '<div class="fg-toolbar">' +
      '<div class="fg-groups"><span class="fg-lbl">Hiện thêm cột:</span>' +
        FG.groups.map(function (g) {
          return '<button type="button" class="fg-chip' + (FG.showGroups[g.key] ? ' on' : '') + '" onclick="FG_toggleGroup(\'' + g.key + '\')">' +
            (FG.showGroups[g.key] ? '✓ ' : '+ ') + escapeHtml(g.label) + '</button>';
        }).join('') +
      '</div>' +
      '<button type="button" class="btn ' + (FG.editMode ? 'btn-primary' : 'btn-secondary') + ' btn-sm" onclick="FG_toggleEdit()">' +
        (FG.editMode ? '✓ Đang sửa nhanh · bấm để thoát' : '✏️ Sửa nhanh trên bảng') + '</button>' +
    '</div>';

    var bulk = '';
    if (FG.editMode) {
      bulk = '<div class="fg-bulk">' +
        '<span class="fg-lbl">Điền hàng loạt cho <strong id="fgSelCount">' + nSel + '</strong> dòng đã tick:</span>' +
        '<select class="ui-select" id="fgBulkKey" onchange="FG_doiCotBulk(this.value)"><option value="">— chọn cột —</option>' +
          FG.meta.map(function (m) { return '<option value="' + m.key + '"' + (FG.bulkKey === m.key ? ' selected' : '') + '>' + escapeHtml(m.label) + '</option>'; }).join('') +
        '</select>' +
        '<span id="fgBulkVal">' + FG_bulkValHtml() + '</span>' +
        '<button type="button" class="btn btn-secondary btn-sm" id="fgBulkBtn" onclick="FG_apBulk()"' + (nSel && FG.bulkKey ? '' : ' disabled') + '>Áp dụng</button>' +
