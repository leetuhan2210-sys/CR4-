      ? ('<strong>' + n + '</strong> dòng có dữ liệu · sẽ ghi từ dòng ' + NM.meta.nextRow + ' của sheet TEST' +
         (thieu ? ' · <span class="nm-miss-count">còn ' + thieu + ' ô bắt buộc chưa điền</span>' : ''))
      : 'Chưa có dòng nào có dữ liệu.';
