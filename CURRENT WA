function WA_getGuestNameMap_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  var map = {};
  if (!sheet) return map;
  
  var hmap = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2));
  var maKMCol = WA_firstCol_(hmap, WA_CONFIG.COL_MAKM);
  var hoTenCol = WA_firstCol_(hmap, WA_CONFIG.COL_HOTEN);
  var fullNameCol = WA_firstCol_(hmap, WA_CONFIG.COL_FULLNAME);
  var donViCol = WA_firstCol_(hmap, WA_CONFIG.COL_ORGANIZATION);
  var kmChinhCol = WA_firstCol_(hmap, WA_CONFIG.COL_KM_CHINH);
  var phuTrachCol = WA_firstCol_(hmap, WA_CONFIG.COL_PHUTRACH);
  var hoTroCol = WA_firstCol_(hmap, WA_CONFIG.COL_NHANSU_HOTRO);
  
  if (!maKMCol) return map;
  
  var startRow = WA_CONFIG.DATA_START_ROW;
  var lastRow = sheet.getLastRow();
  if (lastRow < startRow) return map;
  
  var cols = [maKMCol, hoTenCol, fullNameCol, donViCol, kmChinhCol, phuTrachCol, hoTroCol].filter(Boolean);
  var minCol = Math.min.apply(null, cols), maxCol = Math.max.apply(null, cols);
  var values = sheet.getRange(startRow, minCol, lastRow - startRow + 1, maxCol - minCol + 1).getValues();
  
  values.forEach(function (row) {
    var maKM = row[maKMCol - minCol];
    if (maKM === '' || maKM === null) return;
    var name = (fullNameCol ? row[fullNameCol - minCol] : '') || (hoTenCol ? row[hoTenCol - minCol] : '');
    map[maKM.toString().trim().toLowerCase()] = {
      hoTen: name,
      donVi: donViCol ? row[donViCol - minCol] : '',
      kmChinh: kmChinhCol ? row[kmChinhCol - minCol] : '',
      phuTrach: phuTrachCol ? row[phuTrachCol - minCol] : '',
      nhanSuHoTro: hoTroCol ? row[hoTroCol - minCol] : ''
    };
  });
  return map;
}

// Đọc log dạng "dd.MM - nội dung\ndd.MM - nội dung..." (do WA_updateReplyStatus ghi) thành mảng {date, text}, mới nhất trước.
function WA_parseLogLines_(raw) {
  var text = (raw || '').toString().trim();
  if (!text) return [];
  return text.split('\n').map(function (line) {
    var idx = line.indexOf(' - ');
    if (idx === -1) return { date: '', text: line.trim() };
    return { date: line.substring(0, idx).trim(), text: line.substring(idx + 3).trim() };
  });
}

// Đọc 4 cột Phản hồi của khách / Tiến độ BTC (Đợt 1 + Đợt 2) của 1 khách theo Mã KM, dùng cho card mail.
function WA_getBatchLogsForGuest_(maKM) {
  var empty = { batch1: { phanhoi: [], btc: [] }, batch2: { phanhoi: [], btc: [] } };
  if (!maKM) return empty;
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) return empty;
  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var map = WA_buildHeaderMap_(labels);
  var maKMCol = WA_firstCol_(map, WA_CONFIG.COL_MAKM);
  if (!maKMCol) return empty;
  var row = WA_findRowByValue_(sheet, maKMCol, WA_CONFIG.DATA_START_ROW, maKM);
  if (row === -1) return empty;

  var dot1Range = WA_findMergedGroupRange_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.GROUP_DOT1);
  var dot2Range = WA_findMergedGroupRange_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.GROUP_DOT2);
  var dot1PhanHoiCol = WA_findColInRange_(labels, dot1Range, WA_CONFIG.DOT1_COL_PHANHOI_KHACH);
  var dot1BtcCol = WA_findColInRange_(labels, dot1Range, WA_CONFIG.DOT1_COL_TIENDO_BTC);
  var dot2PhanHoiCol = WA_findColInRange_(labels, dot2Range, WA_CONFIG.DOT2_COL_PHANHOI_KHACH);
  var dot2BtcCol = WA_findColInRange_(labels, dot2Range, WA_CONFIG.DOT2_COL_TIENDO_BTC);

  var val = function (col) { return col ? sheet.getRange(row, col).getValue() : ''; };
  return {
    batch1: { phanhoi: WA_parseLogLines_(val(dot1PhanHoiCol)), btc: WA_parseLogLines_(val(dot1BtcCol)) },
    batch2: { phanhoi: WA_parseLogLines_(val(dot2PhanHoiCol)), btc: WA_parseLogLines_(val(dot2BtcCol)) }
  };
}

// ĐỌC GỘP 1 LẦN cho TẤT CẢ khách (thay cho việc gọi WA_getBatchLogsForGuest_ lặp lại cho từng dòng
// mail trong WA_getNewReplies()/WA_getMailDangXuLy() — cách cũ mỗi dòng mail lại quét lại toàn bộ
// header + toàn bộ cột Mã KM của TEST, rất chậm khi TEST có hàng nghìn dòng và DATA MAIL có hàng trăm
