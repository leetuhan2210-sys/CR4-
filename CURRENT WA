  var col = WA_firstCol_(map, WA_CONFIG.COL_SDT);
  var start = WA_CONFIG.DATA_START_ROW, last = sheet.getLastRow();
  if (!col || last < start) return;
  var rg = sheet.getRange(start, col, last - start + 1, 1);
