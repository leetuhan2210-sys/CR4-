function WA_updateGuestFields_NoiBo_(ref, updates) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_DATA + '".');

  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var map = WA_buildHeaderMap_(labels);
  var maKMCol = WA_firstCol_(map, WA_CONFIG.COL_MAKM);
  var rowIndex = WA_giaiMaRef_(sheet, ref, map);
  if (rowIndex === -1) throw new Error('Không lưu được: không còn tìm thấy dòng "' + ref + '" trên sheet ' + WA_CONFIG.SHEET_DATA + '. Hãy mở lại hồ sơ rồi sửa.');
  var maKM = maKMCol ? (sheet.getRange(rowIndex, maKMCol, 1, 1).getValue() || '').toString().trim() : '';
  if (!maKM) maKM = '(chưa có mã) dòng ' + rowIndex;

  // Chuẩn hoá in hoa trước khi ghi: TEST là nguồn gửi thư hàng loạt.
  var kieuVietHoa = {};
  kieuVietHoa[WA_CONFIG.COL_HOTEN] = 'ten';
  kieuVietHoa[WA_CONFIG.COL_FULLNAME] = 'ten';
  kieuVietHoa[WA_CONFIG.COL_CHUCVU] = 'tuVN';
  kieuVietHoa[WA_CONFIG.COL_POSITION] = 'tuEN';
  kieuVietHoa[WA_CONFIG.COL_DONVI] = 'tuVN';
  kieuVietHoa[WA_CONFIG.COL_ORGANIZATION] = 'tuEN';
  var colSdt = WA_firstCol_(map, WA_CONFIG.COL_SDT);
  updates.forEach(function (u) {
    if (!colSdt || u.col !== colSdt) return;
    var kq = WA_chuanHoaSdt_(u.value);
    if (kq.loi.length) throw new Error('Số điện thoại chưa đúng định dạng (+mã quốc gia) số: ' + kq.loi.join(' · ') + '. Chưa lưu thay đổi nào.');
    u.value = kq.giaTri;
  });
  var logSheet = WA_getOrCreateEditLog_(ss);
  var user = Session.getActiveUser().getEmail() || 'không rõ';
  var saved = 0, conflicts = [];  
  updates.forEach(function (u) {
    if (u.col === maKMCol) return;    
    var cell = sheet.getRange(rowIndex, u.col);
    var oldValue = cell.getValue();
    var nhan = labels[u.col - 1] || ('Cột ' + WA_colLetter_(u.col));
    // Web gửi kèm "old" = giá trị lúc mở hồ sơ. Ô trên sheet đã bị người khác đổi → không ghi đè.
    if (Object.prototype.hasOwnProperty.call(u, 'old') && String(WA_giaTriRaClient_(oldValue)) !== String(u.old)) {
      conflicts.push({ label: nhan, current: WA_giaTriRaClient_(oldValue), attempted: u.value });
      return;
    }
    var giaTri = u.value;
    if (kieuVietHoa[nhan]) giaTri = WA_vietHoa_(giaTri, kieuVietHoa[nhan]);
    if (nhan === WA_CONFIG.COL_LINHVUC || nhan === WA_CONFIG.COL_SUBSECTOR) giaTri = WA_gopDaGiaTri_(giaTri);
    cell.clearContent();
    if (u.col === colSdt) cell.setNumberFormat('@');
    cell.setValue(giaTri);    
    logSheet.appendRow([new Date(), user, maKM, nhan, oldValue, giaTri]);    
    saved++;
  });

  return { success: true, updated: saved, conflicts: conflicts };  
}

