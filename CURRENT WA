    if (kq.giaTri !== String(r[0])) doi++;
    return [kq.giaTri];
  });
  rg.setNumberFormat('@').setValues(out);
  Logger.log('Đã chuẩn hoá %s ô. %s ô cần sửa tay:\n%s', doi, loi.length, loi.join('\n'));
