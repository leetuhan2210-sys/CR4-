// Giá trị ô → dạng gửi về web (ngày = dd/MM/yyyy, checkbox giữ true/false, còn lại là chuỗi).
// Dùng CHUNG khi đọc và khi so xung đột lúc lưu, nên 2 bên luôn so cùng 1 kiểu.
function WA_giaTriRaClient_(v) {
  if (v === null || v === undefined) return '';
  if (v instanceof Date) return Utilities.formatDate(v, Session.getScriptTimeZone(), 'dd/MM/yyyy');
  if (typeof v === 'boolean') return v;
  return v.toString();
}

// Kiểu nhập của 1 cột: checkbox / dropdown (1 hoặc nhiều lựa chọn) / null (ô chữ).
// Ưu tiên danh sách ở THIẾT LẬP FILE (WA_DROPDOWN_MAP) giống hồ sơ khách, rồi mới tới Data Validation.
function WA_kieuNhapCot_(sheet, col, tieuDe) {
  try {
    var rule = sheet.getRange(WA_CONFIG.DATA_START_ROW, col).getDataValidation();
    if (rule && rule.getCriteriaType() === SpreadsheetApp.DataValidationCriteria.CHECKBOX) return { type: 'checkbox' };
  } catch (e) { /* bỏ qua, coi như ô chữ */ }
  if (typeof WA_dropdownTheoTieuDe_ === 'function') {
    var d = WA_dropdownTheoTieuDe_(tieuDe);
    if (d) return { type: d.multi ? 'multi' : 'select', options: d.options };
  }
  var opts = WA_getColumnDropdownOptions_(sheet, WA_CONFIG.DATA_START_ROW, col);
  return (opts && opts.length) ? { type: 'select', options: opts } : null;
}

// Đọc TEST đúng 1 lần. Giữ cả dòng CHƯA CÓ Mã KM miễn là có tên (mở/sửa bằng ref '#<dòng>').
function WA_readFilterTable_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_DATA + '".');

  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var COLS = WA_colsBoLoc_(sheet, labels);
  if (!COLS.maKM) throw new Error('Không tìm thấy cột "MÃ KM" trong sheet "' + WA_CONFIG.SHEET_DATA + '".');

  var missingMap = {
    tienDo1: 'Tiến độ Đợt 1', tienDo2: 'Tiến độ Đợt 2',
    phanHoi1: 'Phản hồi của Khách (1)', phanHoi2: 'Phản hồi của Khách (2)',
    xacNhan1: 'Phản hồi tham dự Đợt 1', xacNhan2: 'Phản hồi tham dự Đợt 2',
    doiTuong: 'Đối tượng', phanLoai: 'Phân loại', daiTho: 'Đài thọ',
    email: 'Thư điện tử chính', sdt: 'Số điện thoại', subSector: 'Sub-sector'
  };
  var missing = [];
  Object.keys(missingMap).forEach(function (k) { if (!COLS[k]) missing.push(missingMap[k]); });

  var base = { rows: [], missing: missing, cols: COLS, sheet: sheet, labels: labels };
  var startRow = WA_CONFIG.DATA_START_ROW;
  var lastRow = sheet.getLastRow();
  if (lastRow < startRow) return base;

  var keys = Object.keys(COLS).filter(function (k) { return COLS[k]; });
  var used = keys.map(function (k) { return COLS[k]; });
  var minCol = Math.min.apply(null, used), maxCol = Math.max.apply(null, used);
  var values = sheet.getRange(startRow, minCol, lastRow - startRow + 1, maxCol - minCol + 1).getValues();

  var NO_WORDS = ['false', 'khong', 'no', '0'];
  values.forEach(function (row, rowOffset) {
    var v = {};
    keys.forEach(function (k) { v[k] = WA_giaTriRaClient_(row[COLS[k] - minCol]); });
    var s = function (k) { var x = v[k]; return (x === undefined || x === null) ? '' : x.toString().trim(); };

    var maKM = s('maKM');
    var ten = s('fullName') || s('hoTenVN');
    if (!maKM && !ten) return;
    var dt = COLS.daiTho ? row[COLS.daiTho - minCol] : '';
    var dtNorm = WA_chuanHoaLoc_(dt);

    base.rows.push({
      maKM: maKM,
      ref: WA_taoRef_(maKM, startRow + rowOffset),
      rowIndex: startRow + rowOffset,
      hoTen: ten,
      donVi: s('org') || s('donViVN'),
      chucVu: s('position'),
      email: s('email'),
      sdt: s('sdt'),
      doiTuong: s('doiTuong'),
      phanLoai: s('phanLoai'),
      daiTho: dt === true || (dtNorm !== '' && NO_WORDS.indexOf(dtNorm) === -1),
      pic: s('pic'),
      quocGia: s('quocGia'),
      linhVuc: s('linhVuc'),
      subSector: s('subSector'),
      kenhMoi: s('kenhMoi'),
      xacNhan1: s('xacNhan1'),
      xacNhan2: s('xacNhan2'),
      tienDo1: s('tienDo1'),
      tienDo2: s('tienDo2'),
      phanHoi1: s('phanHoi1'),
      phanHoi2: s('phanHoi2'),
      v: v
    });
  });
  return base;
}

// Dropdown bộ lọc lấy ĐÚNG giá trị đang có trong sheet, kèm SỐ KHÁCH của từng giá trị.
// Luôn thêm một lựa chọn "(chưa điền)" để tìm nhanh các ô còn trống.
// Kèm cấu hình cột cho bảng sửa nhanh (grid).
function WA_getFilterOptions() {
  var data = WA_readFilterTable_();

  function dem(field) {
    var multi = WA_LOC_DA_GIATRI[field] || false;    
    var m = {}, trong = 0;
    data.rows.forEach(function (r) {
      var parts = WA_tachGiaTri_(r[field], multi);
      if (!parts.length) { trong++; return; }
      parts.forEach(function (p) { m[p] = (m[p] || 0) + 1; });
    });
    var out = Object.keys(m).map(function (v) { return { v: v, n: m[v] }; })
      .sort(function (a, b) { return a.v.localeCompare(b.v, 'vi'); });
    if (trong) out.push({ v: WA_LOC_TRONG, n: trong, trong: true });
    return out;
  }
  function themChuan(arr, chuan) {
    var co = {};
    arr.forEach(function (x) { co[WA_chuanHoaLoc_(x.v)] = true; });
    (chuan || []).forEach(function (v) {
      if (v && !co[WA_chuanHoaLoc_(v)]) arr.push({ v: v, n: 0 });
    });
    return arr;
  }
  function tuSetup(ten) {
    var L = WA_getSetupLists_();
    return L && L[ten] ? L[ten] : [];
  }

  var grid = WA_GRID_DEF.map(function (d) {
    var col = data.cols[d.key];
    var m = { key: d.key, label: d.label, group: d.group, batch: d.batch || 0, co: !!col, type: 'text', options: null };
    if (!col) return m;
    if (d.kind === 'log') { m.type = 'log'; return m; }
    if (d.kind === 'longtext') { m.type = 'longtext'; return m; }
    if (d.kind === 'phone') { m.type = 'phone'; return m; }
    var k = WA_kieuNhapCot_(data.sheet, col, data.labels[col - 1]);
    if (d.kind === 'multi') {
      m.type = 'multi';
      m.options = WA_optsLinhVuc_(d.key) || (k && k.options) || WA_CONFIG.SUGGEST_PHANHOI_THAMDU;      
    } else if (k) {
      m.type = k.type;
      m.options = k.options || null;
    }
    return m;
  });

  return {
    tienDo1:   themChuan(dem('tienDo1'),  tuSetup('Tiến độ').length ? tuSetup('Tiến độ') : WA_CONFIG.OPT_TIENDO_LIENHE),
    tienDo2:   themChuan(dem('tienDo2'),  tuSetup('Tiến độ').length ? tuSetup('Tiến độ') : WA_CONFIG.OPT_TIENDO_LIENHE),
    xacNhan1:  themChuan(dem('xacNhan1'), tuSetup('Phản hồi 1')),
    xacNhan2:  themChuan(dem('xacNhan2'), tuSetup('Phản hồi 2')),
    doiTuong:  themChuan(dem('doiTuong'), tuSetup('ĐÔI TƯỢNG')),
    phanLoai:  themChuan(dem('phanLoai'), tuSetup('Loại khách mời')),
    kenhMoi:   themChuan(dem('kenhMoi'),  tuSetup('Kênh mời')),
    quocGia:   themChuan(dem('quocGia'),  []),
    linhVuc:   themChuan(dem('linhVuc'),  WA_optsLinhVuc_('linhVuc') || []),
    subSector: themChuan(dem('subSector'), WA_optsLinhVuc_('subSector') || []),    
    pic:       themChuan(dem('pic'),      tuSetup('Phụ trách')),
    lienHe: (function () {
      var o = { mot: 0, email: 0, emailSai: 0, sdt: 0, ca2: 0 };
      data.rows.forEach(function (r) {
        var e = WA_rong_(r.email), s = WA_rong_(r.sdt);
        if (e) o.email++; else if (!WA_emailHopLe_(r.email)) o.emailSai++;
        if (s) o.sdt++;
        if (e || s) o.mot++;
        if (e && s) o.ca2++;
      });
      return o;
    })(),
    grid: grid,
    gridGroups: WA_GRID_GROUPS,
    missing: data.missing,
    total: data.rows.length,
    thieuMa: data.rows.filter(function (r) { return !r.maKM; }).length
  };
}

// DATA MAIL có thể rất dài; đọc lại ở MỖI lần bấm "Lọc" là nguyên nhân chính làm bộ lọc chậm.
// Cache theo số dòng hiện có của DATA MAIL: có mail mới -> số dòng đổi -> cache tự hết hiệu lực.
function WA_getLatestIncomingMapCached_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var logSheet = ss.getSheetByName(WA_CONFIG.SHEET_LOG);
  if (!logSheet) return {};
  var moc = 'WA_MM_' + logSheet.getLastRow() + '_';
  var cache = CacheService.getScriptCache();

  try {
    var head = cache.get(moc + 'n');
    if (head) {
      var n = parseInt(head, 10), keys = [], i;
      for (i = 0; i < n; i++) keys.push(moc + i);
      var got = cache.getAll(keys), s = '';
      for (i = 0; i < n; i++) { if (got[moc + i] === undefined) { s = null; break; } s += got[moc + i]; }
      if (s) return JSON.parse(s);
    }
  } catch (e) { /* cache hỏng thì đọc lại từ sheet */ }

  var map = WA_getLatestIncomingMap_();
  try {
    var json = JSON.stringify(map);
    if (json.length <= 90000 * 20) {
      var obj = {}, so = 0;
      for (var p = 0; p < json.length; p += 90000) { obj[moc + so] = json.substr(p, 90000); so++; }
      obj[moc + 'n'] = String(so);
      cache.putAll(obj, 600);
    }
  } catch (e2) { /* không cache được vẫn chạy bình thường */ }
  return map;
}

function WA_locKhach_(criteria) {
  criteria = criteria || {};
  var data = WA_readFilterTable_();
  var mailMap = WA_getLatestIncomingMapCached_();

  var fromKey = WA_parseDateInput_(criteria.from, false);
  var toKey = WA_parseDateInput_(criteria.to, true);
  var mode = criteria.replyMode || 'all';
  var join = criteria.batchJoin === 'or' ? 'or' : 'and';
  var kw = WA_chuanHoaLoc_(criteria.keyword);

  var has1 = (criteria.tienDo1 || []).length || (criteria.xacNhan1 || []).length || !!criteria.note1;
  var has2 = (criteria.tienDo2 || []).length || (criteria.xacNhan2 || []).length || !!criteria.note2;

  function noteOk(value, rule) {
    if (!rule) return true;
    return rule === 'has' ? !WA_rong_(value) : WA_rong_(value);
  }

  var rows = [], mailInRange = 0, guestInRange = 0;

  // Đếm riêng từng tiêu chí: khi kết quả = 0, web nói được "bỏ tiêu chí X thì còn N khách".
  var NHAN = {
    doiTuong: 'Đối tượng', phanLoai: 'Phân loại khách', kenhMoi: 'Kênh mời',
    quocGia: 'Quốc gia', linhVuc: 'Lĩnh vực', subSector: 'Sub-sector', pic: 'Phụ trách (PIC)',
    daiTho: 'Đài thọ', keyword: 'Từ khoá',
    tienDo1: 'Tiến độ Đợt 1', xacNhan1: 'Phản hồi tham dự Đợt 1', note1: 'Ghi chú Đợt 1',
    tienDo2: 'Tiến độ Đợt 2', xacNhan2: 'Phản hồi tham dự Đợt 2', note2: 'Ghi chú Đợt 2',
    lienHe: 'Thông tin liên hệ',
    replyMode: 'Tình trạng phản hồi'
  };
  var demRieng = {};
  var boMotCai = {};
  Object.keys(NHAN).forEach(function (k) { demRieng[k] = 0; boMotCai[k] = 0; });

  function hopLe(r, k) {
    switch (k) {
      case 'doiTuong':  return WA_khopDanhSach_(r.doiTuong, criteria.doiTuong, false);
      case 'phanLoai':  return WA_khopDanhSach_(r.phanLoai, criteria.phanLoai, false);
      case 'kenhMoi':   return WA_khopDanhSach_(r.kenhMoi, criteria.kenhMoi, false);
      case 'quocGia':   return WA_khopDanhSach_(r.quocGia, criteria.quocGia, false);
      case 'linhVuc':   return WA_khopDanhSach_(r.linhVuc, criteria.linhVuc, WA_LOC_DA_GIATRI.linhVuc);
      case 'subSector': return WA_khopDanhSach_(r.subSector, criteria.subSector, WA_LOC_DA_GIATRI.subSector);       
      case 'pic':       return WA_khopDanhSach_(r.pic, criteria.pic, false);
      case 'tienDo1':   return WA_khopDanhSach_(r.tienDo1, criteria.tienDo1, false);
      case 'tienDo2':   return WA_khopDanhSach_(r.tienDo2, criteria.tienDo2, false);
      case 'xacNhan1':  return WA_khopDanhSach_(r.xacNhan1, criteria.xacNhan1, true);
      case 'xacNhan2':  return WA_khopDanhSach_(r.xacNhan2, criteria.xacNhan2, false);
      case 'note1':     return noteOk(r.phanHoi1, criteria.note1);
      case 'note2':     return noteOk(r.phanHoi2, criteria.note2);
      case 'lienHe':
        var thieuE = WA_rong_(r.email), thieuS = WA_rong_(r.sdt);
        switch (criteria.lienHe) {
          case 'email': return thieuE;
          case 'emailSai': return !thieuE && !WA_emailHopLe_(r.email);
          case 'sdt': return thieuS;
          case 'mot': return thieuE || thieuS;
          case 'ca2': return thieuE && thieuS;
        }
        return true;
      case 'daiTho':
        if (criteria.daiTho === 'yes') return !!r.daiTho;
        if (criteria.daiTho === 'no') return !r.daiTho;
        return true;
      case 'keyword':
        if (!kw) return true;
        return WA_chuanHoaLoc_(r.maKM + ' ' + r.hoTen + ' ' + r.donVi + ' ' + r.email + ' ' + r.chucVu).indexOf(kw) !== -1;
    }
    return true;
  }
  function dangBat(k) {
    if (k === 'daiTho') return criteria.daiTho === 'yes' || criteria.daiTho === 'no';
    if (k === 'keyword') return !!kw;
    if (k === 'lienHe') return !!criteria.lienHe;
    if (k === 'note1' || k === 'note2') return !!criteria[k];
    if (k === 'replyMode') return mode !== 'all';
    return (criteria[k] || []).length > 0;
  }

  var dangBatKeys = Object.keys(NHAN).filter(function (k) { return k !== 'replyMode' && dangBat(k); });

  data.rows.forEach(function (r) {
    var truot = [];
    dangBatKeys.forEach(function (k) {
      if (hopLe(r, k)) demRieng[k]++; else truot.push(k);
    });
    if (truot.length === 1) boMotCai[truot[0]]++;

    // --- Nhóm hồ sơ (luôn AND) ---
    if (!hopLe(r, 'doiTuong')) return;
    if (!hopLe(r, 'phanLoai')) return;
    if (!hopLe(r, 'kenhMoi')) return;
    if (!hopLe(r, 'quocGia')) return;
    if (!hopLe(r, 'linhVuc')) return;
    if (!hopLe(r, 'subSector')) return;
    if (!hopLe(r, 'pic')) return;
    if (!hopLe(r, 'daiTho')) return;
    if (!hopLe(r, 'keyword')) return;
    if (!hopLe(r, 'lienHe')) return;

    // --- Nhóm theo đợt (AND hoặc OR tuỳ lựa chọn) ---
    var ok1 = hopLe(r, 'tienDo1') && hopLe(r, 'xacNhan1') && hopLe(r, 'note1');
    var ok2 = hopLe(r, 'tienDo2') && hopLe(r, 'xacNhan2') && hopLe(r, 'note2');
    if (join === 'or' && has1 && has2) { if (!ok1 && !ok2) return; }
    else if (!ok1 || !ok2) return;

    // --- Tình trạng phản hồi ---
    var mail = mailMap[(r.maKM || '').toLowerCase()] || null;
    var countInRange = 0;
    if (mail) {
      mail.times.forEach(function (k) {
        if (fromKey && k < fromKey) return;
        if (toKey && k > toKey) return;
        countInRange++;
      });
    }
    var chuaPH1 = WA_rong_(r.phanHoi1) && WA_rong_(r.xacNhan1);
    var chuaPH2 = WA_rong_(r.phanHoi2) && WA_rong_(r.xacNhan2);
    var tuChoi = WA_coChuoi_(r.xacNhan1, 'Từ chối') || WA_coChuoi_(r.xacNhan2, 'Từ chối');

    if (mode === 'inRange' && countInRange === 0) return;
    if (mode === 'noReply1' && !chuaPH1) return;
    if (mode === 'noReply2' && !chuaPH2) return;
    if (mode === 'noReplyBoth' && !(chuaPH1 && chuaPH2)) return;
    if (mode === 'declined' && !tuChoi) return;

    if (countInRange > 0) { mailInRange += countInRange; guestInRange++; }

    rows.push({
      maKM: r.maKM, ref: r.ref, rowIndex: r.rowIndex,
      hoTen: r.hoTen, chucVu: r.chucVu, donVi: r.donVi, email: r.email, sdt: r.sdt,
      doiTuong: r.doiTuong, phanLoai: r.phanLoai, daiTho: r.daiTho, pic: r.pic,
      quocGia: r.quocGia, linhVuc: r.linhVuc, subSector: r.subSector, kenhMoi: r.kenhMoi,
      tienDo1: r.tienDo1, tienDo2: r.tienDo2, xacNhan1: r.xacNhan1, xacNhan2: r.xacNhan2,
      phanHoi1: r.phanHoi1, phanHoi2: r.phanHoi2,
      hasNote1: !WA_rong_(r.phanHoi1), hasNote2: !WA_rong_(r.phanHoi2),
      tuChoi: tuChoi,
      v: r.v,
      lastReply: mail && mail.dateStr ? (mail.dateStr + (mail.timeStr ? ' ' + mail.timeStr : '')) : '',
      replyInRange: countInRange,
      replyTotal: mail ? mail.count : 0,
      _key: mail ? mail.key : 0
    });
  });

  rows.sort(function (a, b) { return b._key - a._key; });

  // Gợi ý gỡ rối: tiêu chí nào đang siết chặt nhất.
  var goiY = [];
  if (!rows.length && data.rows.length) {
    dangBatKeys.forEach(function (k) {
      goiY.push({ key: k, nhan: NHAN[k], rieng: demRieng[k], boRaCon: boMotCai[k] });
    });
    goiY.sort(function (a, b) { return b.boRaCon - a.boRaCon || a.rieng - b.rieng; });
  }

  return {
    rows: rows, total: rows.length, tongKhach: data.rows.length,
    mailInRange: mailInRange, guestInRange: guestInRange,
    hasRange: !!(fromKey || toKey), goiY: goiY, missing: data.missing
  };
}

// Trả về từng trang kết quả (mặc định 100 dòng), web bấm "Hiện thêm" để lấy trang kế tiếp.
function WA_filterGuests(criteria, offset, limit) {
  var res = WA_locKhach_(criteria);
  offset = Math.max(0, parseInt(offset, 10) || 0);
  limit = Math.min(500, Math.max(1, parseInt(limit, 10) || 100));
  return {
    tongKhach: res.tongKhach, goiY: res.goiY, missing: res.missing,
    total: res.total, offset: offset,
    mailInRange: res.mailInRange, guestInRange: res.guestInRange, hasRange: res.hasRange,
    rows: res.rows.slice(offset, offset + limit)
  };
}

// Đọc lại vài khách theo ref (sau khi lưu) để bảng hiện đúng giá trị mới nhất trên sheet.
function WA_getGridRows(refs) {
  var want = {};
  (refs || []).forEach(function (m) {
    m = (m || '').toString().trim().toLowerCase();
    if (m) want[m] = true;
  });
  return WA_locKhach_({}).rows.filter(function (r) { return want[String(r.ref).toLowerCase()]; });
}

// ---------- LƯU CHỈNH SỬA TỪ BẢNG ----------
// edits = [{ ref, hoTen, key, oldValue, newValue }]
//  - Cột thường: chỉ ghi nếu ô trên sheet VẪN bằng oldValue (giá trị lúc tải). Nếu người khác đã
//    đổi ô đó thì KHÔNG ghi đè, trả về trong "conflicts" để người sửa xem rồi quyết định.
//  - Cột nhật ký (Phản hồi của khách, Tiến độ BTC): thêm "dd.MM - nội dung" lên đầu giá trị
//    HIỆN TẠI trên sheet, nên không bao giờ mất ghi chú của người khác.
//  - Khách chưa có Mã KM (ref '#<dòng>'): kiểm tra thêm tên ở dòng đó, lệch tên (dòng bị chèn/xoá/
//    sắp xếp) thì từ chối, không ghi nhầm sang người khác.
function WA_saveGridEdits(edits) {
  if (!edits || !edits.length) throw new Error('Không có thay đổi nào để lưu.');
  return TB_chayCoKhoa_('Lưu chỉnh sửa trên bảng lọc', 30000, function () {
    return WA_saveGridEdits_NoiBo_(edits);
  });
}

function WA_saveGridEdits_NoiBo_(edits) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_DATA + '".');
  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var map = WA_buildHeaderMap_(labels);
  var cols = WA_colsBoLoc_(sheet, labels);
  if (!cols.maKM) throw new Error('Không tìm thấy cột "MÃ KM".');

  var defByKey = {};
  WA_GRID_DEF.forEach(function (d) { defByKey[d.key] = d; });

  var rowCache = {};
  function timDong(e) {
    var ref = (e.ref || '').toString().trim();
    if (!(ref in rowCache)) {
      var row = WA_giaiMaRef_(sheet, ref, map);
      if (row !== -1 && ref.charAt(0) === '#' && e.hoTen) {
        var tenCol = cols.fullName || cols.hoTenVN;
        var tenCo = tenCol ? String(sheet.getRange(row, cols.fullName || cols.hoTenVN).getValue() || '').trim() : '';
        var tenVN = cols.hoTenVN ? String(sheet.getRange(row, cols.hoTenVN).getValue() || '').trim() : '';
        var mong = WA_chuanHoaLoc_(e.hoTen);
        if (mong && WA_chuanHoaLoc_(tenCo) !== mong && WA_chuanHoaLoc_(tenVN) !== mong) row = -2;
      }
      rowCache[ref] = row;
    }
    return rowCache[ref];
  }

  var saved = 0, conflicts = [], errors = [], jobs = [];
  edits.forEach(function (e) {
    var d = defByKey[e.key];
    var ten = e.hoTen || e.ref || '';
    var nhan = ten + (d ? ' · ' + d.label : ' · ' + e.key);
    if (!d) { errors.push({ ref: e.ref, key: e.key, msg: nhan + ': cột này không được sửa từ bảng.' }); return; }
    var col = cols[e.key];
    if (!col) { errors.push({ ref: e.ref, key: e.key, msg: nhan + ': không tìm thấy cột trên sheet.' }); return; }
    var row = timDong(e);
    if (row === -2) { errors.push({ ref: e.ref, key: e.key, msg: nhan + ': dòng trên TEST đã đổi chỗ (khách chưa có Mã KM). Bấm Lọc lại rồi sửa.' }); return; }
    if (row < 0) { errors.push({ ref: e.ref, key: e.key, msg: nhan + ': không còn tìm thấy khách này trên sheet.' }); return; }
    jobs.push({ e: e, d: d, row: row, col: col });
  });
  if (!jobs.length) return { saved: 0, conflicts: conflicts, errors: errors };

  // Đọc 1 lần khối ô bao trùm mọi ô cần sửa.
  var minR = Math.min.apply(null, jobs.map(function (j) { return j.row; }));
  var maxR = Math.max.apply(null, jobs.map(function (j) { return j.row; }));
  var minC = Math.min.apply(null, jobs.map(function (j) { return j.col; }));
  var maxC = Math.max.apply(null, jobs.map(function (j) { return j.col; }));
  var block = sheet.getRange(minR, minC, maxR - minR + 1, maxC - minC + 1).getValues();

  var dateStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM');
  var user = (Session.getActiveUser().getEmail() || 'không rõ');
  var now = new Date();
  var logRows = [];

  jobs.forEach(function (j) {
    var e = j.e, d = j.d;
    var cell = sheet.getRange(j.row, j.col);
    var cur = block[j.row - minR][j.col - minC];
    var tenLog = e.ref || ('#' + j.row);

    if (d.kind === 'log') {
      var text = (e.newValue === null || e.newValue === undefined ? '' : e.newValue).toString().trim();
      if (!text) return;
      var old = (cur === null || cur === undefined ? '' : cur).toString().trim();
      var moi = dateStr + ' - ' + text + (old ? '\n' + old : '');
      cell.setValue(moi);
      block[j.row - minR][j.col - minC] = moi;
      logRows.push([now, user, tenLog, d.label + ' (bảng lọc)', old, moi]);
      saved++;
      return;
    }

    var curClient = WA_giaTriRaClient_(cur);
    var oldClient = (e.oldValue === null || e.oldValue === undefined) ? '' : e.oldValue;
    if (String(curClient) !== String(oldClient)) {
      conflicts.push({ ref: e.ref, hoTen: e.hoTen || '', key: e.key, label: d.label, current: curClient, attempted: e.newValue });
      return;
    }

    var val = e.newValue;
    if (d.kind === 'phone') {
      var kqS = WA_chuanHoaSdt_(val);
      if (kqS.loi.length) { errors.push({ ref: e.ref, key: e.key, msg: (e.hoTen || e.ref) + ' · ' + d.label + ': ' + kqS.loi.join(' · ') }); return; }
      val = kqS.giaTri;
      cell.setNumberFormat('@');
    }
    cell.clearContent();    
    if (typeof val === 'boolean') {
      cell.setValue(val);
    } else {
      val = (val === null || val === undefined) ? '' : val.toString();
      if (val !== '') cell.setValue(val);
    }
    block[j.row - minR][j.col - minC] = val;
    logRows.push([now, user, tenLog, d.label + ' (bảng lọc)', cur, val]);
    saved++;
  });

  if (logRows.length) {
    var logSheet = WA_getOrCreateEditLog_(ss);
    logSheet.getRange(logSheet.getLastRow() + 1, 1, logRows.length, 6).setValues(logRows);
  }
  return { saved: saved, conflicts: conflicts, errors: errors };
}

function WA_exportFilterToSheet(criteria) {
