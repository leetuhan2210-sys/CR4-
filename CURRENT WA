// kieu: 'ten' (K, L) | 'tuVN' (M, O) | 'tuEN' (N, P). Bản giống hệt ở WA_Index.html (nmVietHoa).
var WA_GIU_IN_HOA_ = {}, WA_TU_NOI_EN_ = {}, WA_TU_NOI_VN_ = {};
('CEO CFO CTO COO CIO CMO CHRO CSO VP SVP EVP GM MD HR PR IT ICT AI ESG FDI SME SMES WEF C4IR C4IRS UN UNDP UNESCO UNICEF UNIDO UNCTAD WTO WB IMF ADB AIIB OECD ASEAN APEC EU UK US USA UAE VN JSC LLC LTD PLC NGO JICA KOICA USAID GIZ KOTRA JETRO VCCI HCMC HCM TP UBND HĐND MTTQ ĐHQG ĐH TW CMU MIT NUS II III IV')
  .split(' ').forEach(function (w) { WA_GIU_IN_HOA_[w] = true; });
'of and the for in on at to by with de du des la'.split(' ').forEach(function (w) { WA_TU_NOI_EN_[w] = true; });
'và của tại về cho với'.split(' ').forEach(function (w) { WA_TU_NOI_VN_[w] = true; });

function WA_vietHoa_(s, kieu) {
  s = (s === null || s === undefined) ? '' : s.toString().replace(/\s+/g, ' ').trim();
  if (!s || !/\p{L}/u.test(s)) return s;
  var toanHoa = (s === s.toUpperCase()), toanThuong = (s === s.toLowerCase());
  // Chức vụ / đơn vị đã gõ hỗn hợp (VD "CEO of Vingroup") thì giữ nguyên.
  if (kieu !== 'ten' && !toanHoa && !toanThuong) return s;
  var noi = (kieu === 'tuEN') ? WA_TU_NOI_EN_ : (kieu === 'tuVN' ? WA_TU_NOI_VN_ : {});
  var dem = 0;
  return s.replace(/[\p{L}\p{M}\p{N}]+/gu, function (w) {
    var dau = (dem++ === 0);
    var thuong = w.toLowerCase(), hoa = w.toUpperCase();
    var cap = hoa.charAt(0) + thuong.slice(1);
    if (kieu === 'ten') {
      if (w === hoa || w === thuong) return cap;
      return (w.charAt(0) === w.charAt(0).toLowerCase()) ? cap : w;   // giữ "McDonald"
    }
    if (WA_GIU_IN_HOA_[hoa] || /\d/.test(w)) return hoa;
    if (!dau && noi[thuong]) return thuong;
    return cap;
  });
}

