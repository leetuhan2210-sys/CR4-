    var opts = (options || []).map(function (o) {
      return '<label class="fm-opt"><input type="checkbox" value="' + escapeHtml(o) + '" onchange="fmUpdate(\'' + key + '\')"><span>' + escapeHtml(o) + '</span></label>';
    }).join('') || '<div style="padding:6px;font-size:12.5px;color:var(--ink-soft)">Không có dữ liệu</div>';
    return '<div class="fm" id="fm-' + key + '">' +
      '<label>' + escapeHtml(label) + '</label>' +
      '<button type="button" class="fm-btn" id="fmbtn-' + key + '" onclick="fmToggle(\'' + key + '\')">— tất cả —</button>' +
      '<div class="fm-pop" id="fmpop-' + key + '">' + opts + '</div>' +
    '</div>';
  }
  function fmToggle(key) {
    var p = document.getElementById('fmpop-' + key);
    document.querySelectorAll('.fm-pop.show').forEach(function (x) { if (x !== p) x.classList.remove('show'); });
    p.classList.toggle('show');
  }
  function fmValues(key) {
    return Array.prototype.map.call(document.querySelectorAll('#fmpop-' + key + ' input:checked'), function (cb) { return cb.value; });
  }
  function fmUpdate(key) {
    var v = fmValues(key), btn = document.getElementById('fmbtn-' + key);
    if (!btn) return;
    btn.textContent = v.length ? (v.length === 1 ? v[0] : 'Đã chọn ' + v.length) : '— tất cả —';
    btn.classList.toggle('active', v.length > 0);
  }
  function fmSet(key, vals) {
    vals = vals || [];
    document.querySelectorAll('#fmpop-' + key + ' input').forEach(function (cb) { cb.checked = vals.indexOf(cb.value) !== -1; });
    fmUpdate(key);
  }
  // Chọn sẵn các option khớp từ khoá (đã bỏ dấu) — dùng cho nút lọc nhanh, không phụ thuộc emoji trong sheet.
  function fmPick(key, patterns) {
    var vals = [];
    document.querySelectorAll('#fmpop-' + key + ' input').forEach(function (cb) {
      var n = fNorm(cb.value);
      for (var i = 0; i < patterns.length; i++) if (n.indexOf(patterns[i]) !== -1) { vals.push(cb.value); break; }
    });
    fmSet(key, vals);
    return vals;
  }
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.fm')) document.querySelectorAll('.fm-pop.show').forEach(function (x) { x.classList.remove('show'); });
  });

  function noteSelect(id, label) {
    return '<div class="ff"><label>' + label + '</label><select class="ui-select" id="' + id + '">' +
      '<option value="">Tất cả</option>' +
      '<option value="has">Đã có ghi chú phản hồi</option>' +
      '<option value="empty">Chưa có ghi chú phản hồi</option>' +
    '</select></div>';
  }

  function renderFilterForm(o) {
    document.getElementById('fgridTime').innerHTML =
      '<div class="ff"><label>Nhận phản hồi TỪ ngày</label><input type="date" class="ui-input" id="fltFrom"></div>' +
      '<div class="ff"><label>ĐẾN ngày</label><input type="date" class="ui-input" id="fltTo"></div>' +
      '<div class="ff wide"><label>Tình trạng phản hồi</label><select class="ui-select" id="fltMode" onchange="onModeChange()">' +
        '<option value="all">Tất cả</option>' +
        '<option value="inRange">Có mail nhận về trong khoảng ngày</option>' +
        '<option value="noReply1">Chưa phản hồi — Đợt 1</option>' +
        '<option value="noReply2">Chưa phản hồi — Đợt 2</option>' +
        '<option value="noReplyBoth">Chưa phản hồi — cả 2 đợt</option>' +
        '<option value="declined">Đã từ chối tham dự</option>' +
      '</select></div>' +
      '<div class="ff"><label>Từ khoá (tên / đơn vị / email)</label><input type="text" class="ui-input" id="fltKeyword" onkeydown="if(event.key===\'Enter\') runFilter()"></div>';

    document.getElementById('fgridB1').innerHTML =
      fmBlock('tienDo1', 'Tiến độ liên hệ', o.tienDo1) +
      fmBlock('xacNhan1', 'Phản hồi tham dự', o.xacNhan1) +
      noteSelect('fltNote1', 'Ghi chú phản hồi (AL)');

    document.getElementById('fgridB2').innerHTML =
      fmBlock('tienDo2', 'Tiến độ liên hệ', o.tienDo2) +
      fmBlock('xacNhan2', 'Phản hồi tham dự', o.xacNhan2) +
      noteSelect('fltNote2', 'Ghi chú phản hồi (AQ)');

    document.getElementById('fgridProfile').innerHTML =
      fmBlock('doiTuong', 'Đối tượng', o.doiTuong) +
      fmBlock('phanLoai', 'Phân loại khách', o.phanLoai) +
      '<div class="ff"><label>Đài thọ</label><select class="ui-select" id="fltDaiTho">' +
        '<option value="">Tất cả</option><option value="yes">Có đài thọ</option><option value="no">Không đài thọ</option></select></div>' +
      fmBlock('kenhMoi', 'Kênh mời', o.kenhMoi) +
      fmBlock('quocGia', 'Quốc gia', o.quocGia) +
      fmBlock('linhVuc', 'Lĩnh vực', o.linhVuc) +
      fmBlock('pic', 'Phụ trách (PIC)', o.pic);

    if (o.missing && o.missing.length) {
      document.getElementById('filterWarn').innerHTML =
        '<div class="error-box">Không dò được các cột: <strong>' + escapeHtml(o.missing.join(', ')) +
        '</strong>. Lọc theo những cột này sẽ luôn ra 0 kết quả — kiểm tra lại tiêu đề dòng 4/5 của sheet TEST.</div>';
    }
  }

  // Khi chọn "Chưa phản hồi — Đợt X", tự tick tiến độ "Đã gửi Mail" đúng đợt đó cho khỏi phải chọn tay.
  function onModeChange() {
    var mode = document.getElementById('fltMode').value;
    if (mode === 'noReply1') { fmSet('tienDo2', []); fmPick('tienDo1', ['da gui mail']); }
    else if (mode === 'noReply2') { fmSet('tienDo1', []); fmPick('tienDo2', ['da gui mail']); }
    else if (mode === 'noReplyBoth') { fmPick('tienDo1', ['da gui mail']); fmPick('tienDo2', ['da gui mail']); }
  }

  function collectCriteria() {
    var c = {
      from: document.getElementById('fltFrom').value,
      to: document.getElementById('fltTo').value,
      replyMode: document.getElementById('fltMode').value,
      batchJoin: document.getElementById('fltBatchJoin').value,
      note1: document.getElementById('fltNote1').value,
      note2: document.getElementById('fltNote2').value,
      daiTho: document.getElementById('fltDaiTho').value,
      keyword: document.getElementById('fltKeyword').value
    };
    window.WA_FILTER_MULTI.forEach(function (k) { c[k] = fmValues(k); });
    return c;
  }

  function ymd(d) {
    return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
  }

  function resetFilter() {
    if (!window.WA_FILTER_OPTIONS) return;
    ['fltFrom','fltTo','fltKeyword'].forEach(function (id) { document.getElementById(id).value = ''; });
    document.getElementById('fltMode').value = 'all';
    document.getElementById('fltBatchJoin').value = 'and';
    document.getElementById('fltNote1').value = '';
    document.getElementById('fltNote2').value = '';
    document.getElementById('fltDaiTho').value = '';
    window.WA_FILTER_MULTI.forEach(function (k) { fmSet(k, []); });
    document.getElementById('filterStats').innerHTML = '';
    document.getElementById('filterResult').innerHTML = '<div class="empty-state">Chọn điều kiện rồi bấm “Lọc”.</div>';
  }

  function applyPreset(kind) {
    if (!window.WA_FILTER_OPTIONS) { initFilterTab(); showToast('Đang tải bộ lọc, bấm lại sau 1 giây.'); return; }
    resetFilter();
    if (kind === 'week') {
      var to = new Date(), from = new Date(); from.setDate(from.getDate() - 6);
      document.getElementById('fltFrom').value = ymd(from);
      document.getElementById('fltTo').value = ymd(to);
      document.getElementById('fltMode').value = 'inRange';
    } else if (kind === 'resend') {
      document.getElementById('fltMode').value = 'noReply1';
      onModeChange();
      showToast('Đang tính theo Đợt 1 — đổi dropdown “Tình trạng phản hồi” nếu muốn Đợt 2.');
    } else if (kind === 'contactissue') {
      document.getElementById('fltBatchJoin').value = 'or';
      fmPick('tienDo1', ['bi loi', 'chua lien he']);
      fmPick('tienDo2', ['bi loi', 'chua lien he']);
    } else if (kind === 'declined') {
      document.getElementById('fltMode').value = 'declined';
    }
    runFilter();
  }

  function runFilter() {
    document.getElementById('filterError').innerHTML = '';
    document.getElementById('filterResult').innerHTML = '<div class="spinner">Đang lọc dữ liệu...</div>';
    window.WA_LAST_CRITERIA = collectCriteria();
    gs('WA_filterGuests', window.WA_LAST_CRITERIA).then(renderFilterTable).catch(function (err) {
      document.getElementById('filterResult').innerHTML = '';
      showError('filterError', err);
    });
  }

  function renderFilterTable(res) {
    document.getElementById('filterStats').innerHTML =
      '<strong>' + res.total + '</strong> khách khớp' +
      (res.hasRange ? ' · <strong>' + res.guestInRange + '</strong> khách có mail nhận về trong khoảng · <strong>' + res.mailInRange + '</strong> mail nhận về' : '') +
      (res.total > res.shown ? ' · chỉ hiện ' + res.shown + ' dòng đầu, ghi ra sheet để xem đủ' : '');

    var el = document.getElementById('filterResult');
    if (!res.rows.length) { el.innerHTML = '<div class="empty-state">Không có khách nào khớp bộ lọc.</div>'; return; }

    function pill(v, cls) { return v ? '<span class="fpill' + (cls ? ' ' + cls : '') + '">' + escapeHtml(v) + '</span>' : ''; }
    function dot(has) { return has ? '<span class="fdot yes">✓</span>' : '<span class="fdot no">—</span>'; }
    function warnCls(v) { return fNorm(v).indexOf('bi loi') !== -1 || fNorm(v).indexOf('chua lien he') !== -1 ? 'warn' : ''; }

    el.innerHTML = '<div class="ftable-wrap"><table class="ftable"><thead><tr>' +
      '<th>Mã KM</th><th>Họ tên</th><th>Đơn vị</th><th>PIC</th>' +
      '<th class="b1">Tiến độ Đ1</th><th class="b1">Tham dự Đ1</th><th class="b1">GC Đ1</th>' +
      '<th class="b2">Tiến độ Đ2</th><th class="b2">Tham dự Đ2</th><th class="b2">GC Đ2</th>' +
      '<th>Phản hồi gần nhất</th><th>Mail nhận</th><th>Phân loại</th><th>Đài thọ</th>' +
      '</tr></thead><tbody>' +
      res.rows.map(function (r) {
        return '<tr onclick="jumpToGuest(\'' + r.maKM.replace(/'/g, "\\'") + '\')">' +
          '<td class="nowrap"><strong>' + escapeHtml(r.maKM) + '</strong></td>' +
          '<td>' + escapeHtml(r.hoTen) + '</td>' +
          '<td>' + escapeHtml(r.donVi) + '</td>' +
          '<td class="nowrap">' + escapeHtml(r.pic) + '</td>' +
          '<td>' + pill(r.tienDo1, warnCls(r.tienDo1)) + '</td>' +
          '<td>' + escapeHtml(r.xacNhan1) + '</td>' +
          '<td>' + dot(r.hasNote1) + '</td>' +
          '<td>' + pill(r.tienDo2, warnCls(r.tienDo2)) + '</td>' +
          '<td>' + escapeHtml(r.xacNhan2) + '</td>' +
          '<td>' + dot(r.hasNote2) + '</td>' +
          '<td class="nowrap">' + (r.lastReply ? escapeHtml(r.lastReply) : '<span style="color:var(--ink-soft);font-style:italic">chưa có</span>') + '</td>' +
          '<td class="nowrap">' + (r.replyInRange ? r.replyInRange + '/' : '') + r.replyTotal + '</td>' +
          '<td>' + pill(r.phanLoai) + '</td>' +
          '<td>' + (r.daiTho ? '<span class="fpill gold">💰</span>' : '') + '</td>' +
        '</tr>';
      }).join('') + '</tbody></table></div>';
  }

  function exportFilter() {
    var btn = document.getElementById('btnExportFilter');
    var label = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = 'Đang ghi sheet…';
    gs('WA_exportFilterToSheet', window.WA_LAST_CRITERIA || collectCriteria()).then(function (res) {
      btn.disabled = false; btn.innerHTML = label;
      showToast('Đã ghi ' + res.count + ' dòng vào sheet "' + res.sheetName + '".');
      document.getElementById('filterError').innerHTML =
        '<div class="note-box">Đã tạo sheet <strong>' + escapeHtml(res.sheetName) + '</strong> (' + res.count + ' dòng). ' +
        '<a class="link" href="' + res.url + '" target="_blank" rel="noopener">Mở sheet ↗</a></div>';
    }).catch(function (err) {
      btn.disabled = false; btn.innerHTML = label;
      showError('filterError', err);
    });
  }

  
  // ---------- KHỞI ĐỘNG ----------
  loadReplies();  
  loadProcessing();
  loadUnknown();
</script>
 
<!-- Nút tròn góc phải dưới -->
<button class="mini-lookup-btn" onclick="toggleMiniLookup()" title="Tra cứu nhanh mã KM">
  🔍
</button>
 
<!-- Panel tra cứu nhanh -->
<div class="mini-lookup-panel" id="miniLookupPanel">
  <h4>Tra cứu nhanh Mã KM</h4>
  <div style="display: flex; flex-direction: column; gap: 8px;">
    <input type="text" id="miniSearchName" placeholder="Nhập tên (VD: Nguyễn Văn A)..." onkeyup="if(event.key === 'Enter') runMiniLookup()">
    <input type="text" id="miniSearchOrg" placeholder="Nhập tổ chức (VD: World Economic Forum)..." onkeyup="if(event.key === 'Enter') runMiniLookup()">
  </div>
  <button class="btn btn-primary btn-sm" onclick="runMiniLookup()">Tìm kiếm</button>
  <div class="mini-results" id="miniResults"></div>
</div>
 
<script>
function toggleMiniLookup() {
  const panel = document.getElementById('miniLookupPanel');
  panel.classList.toggle('show');
  if(panel.classList.contains('show')) {
    document.getElementById('miniSearchName').focus();
  }
}
 
function runMiniLookup() {
  const nameQuery = document.getElementById('miniSearchName').value.trim();
  const orgQuery = document.getElementById('miniSearchOrg').value.trim();
  const resDiv = document.getElementById('miniResults');
  
  if(!nameQuery && !orgQuery) return; // Không nhập gì thì không tìm
 
  resDiv.innerHTML = '<div style="text-align:center; padding: 10px;">Đang tìm...</div>';
  
  // Gửi cả 2 tham số nameQuery và orgQuery xuống backend
  google.script.run.withSuccessHandler(function(data) {
    resDiv.innerHTML = '';
    
    if (data.exact.length > 0) {
      renderMiniItems(data.exact, resDiv);
    } else if (data.fuzzy.length > 0) {
      resDiv.innerHTML = '<div class="mini-fuzzy-msg">⚠️ Không tìm thấy chính xác. Có phải bạn muốn tìm:</div>';
      renderMiniItems(data.fuzzy, resDiv);
    } else {
      resDiv.innerHTML = '<div style="color:red; text-align:center; padding: 10px;">Không tìm thấy kết quả nào phù hợp.</div>';
    }
  }).withFailureHandler(function(err) {
    resDiv.innerHTML = '<div style="color:red;">Lỗi: ' + err.message + '</div>';
  }).WA_miniLookup(nameQuery, orgQuery);
}
 
 
</script>
</body>
</html>
