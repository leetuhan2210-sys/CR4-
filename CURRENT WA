  // ---------- THÊM LOG GHI CHÚ (TỰ GẮN BADGE NGÀY & GỘP STRING CHO SHEET) ----------
  function addVisualLog(col, inputId, listId, targetCols, isPic) {
    var input = document.getElementById(inputId);
    var val = (input.value || '').trim();
    if (!val) return;
 
    var wrapper = document.getElementById('field-' + col);
    var hidden = wrapper.querySelector('input[type=hidden]');
    var list = document.getElementById(listId);
 
    // Xóa empty state nếu có
    var empty = list.querySelector('.empty-state-log');
    if (empty) empty.remove();
 
    var now = new Date();
    var d = ('0' + now.getDate()).slice(-2);
    var m = ('0' + (now.getMonth() + 1)).slice(-2);
    var dateStr = d + '.' + m; // Ví dụ: 09.09 hoặc 10.8
 
    // Chuẩn bị dòng mới theo cấu trúc chuẩn: "10.8 - ghi chú..."
    var newLine = dateStr + ' - ' + val;
 
    // Gộp string ngược vào hidden input để gửi về Sheets
    var origVal = hidden.value ? hidden.value.trim() : '';
    hidden.value = origVal ? (newLine + '\n' + origVal) : newLine;
    markChanged(hidden);
 
    // Tạo visual badge mới trên giao diện
    var badgeCls = isPic ? 'badge-date pic' : 'badge-date';
    var itemEl = document.createElement('div');
    itemEl.className = 'log-item';
    itemEl.innerHTML = '<span class="' + badgeCls + '">' + dateStr + '</span><span class="log-text">' + escapeHtml(val) + '</span>';
    list.prepend(itemEl);
 
    input.value = '';
 
    // Cập nhật trường tự động (Phản hồi gần nhất) nếu có liên kết targetCols
    if (targetCols && targetCols.length === 2 && targetCols[0] && targetCols[1]) {
      setAutoField(targetCols[0], now.getDate());
      setAutoField(targetCols[1], now.getMonth() + 1);
    }
  }
 
  function setAutoField(col, val) {
    var wrapper = document.getElementById('field-' + col);
    if (!wrapper) return;
    var hidden = wrapper.querySelector('input[type=hidden]');
    var display = document.getElementById('auto-' + col);
    if (!hidden) return;
    hidden.value = val;
    markChanged(hidden);
    if (display) display.innerHTML = val + ' <span style="color:var(--ink-soft);font-weight:400;font-size:12.5px;">(tự cập nhật)</span>';
  }
 
    function onMultiSelectChange(col) {
    var wrapper = document.getElementById('field-' + col);
    if (!wrapper) return;
    var checked = Array.prototype.map.call(
      wrapper.querySelectorAll('.ms-group input[type=checkbox]:checked'),
      function (cb) { return cb.value; }
    );
    var hidden = wrapper.querySelector('input[type=hidden]');
    if (!hidden) return;
    hidden.value = checked.join(', ');
    markChanged(hidden);
  }

  function markChanged(el) {
    var wrapper = el.closest('.f');
    if (!wrapper) return;
    var col = el.dataset.col;
    var orig = currentGuest.original[col] || '';
    if (el.value !== orig) wrapper.classList.add('changed'); else wrapper.classList.remove('changed');
  }
 
  function saveChanges() {
    if (!currentGuest) return;
        var sel = '#detailPanel .f.changed input[data-col]:not([type=checkbox]), #detailPanel .f.changed textarea[data-col], #detailPanel .f.changed select[data-col]';
    var changedEls = document.querySelectorAll(sel);
    if (!changedEls.length) { showToast('Không có gì thay đổi.'); return; }
    var updates = Array.prototype.map.call(changedEls, function (el) { return { col: parseInt(el.dataset.col, 10), value: el.value }; });

    var btn = document.getElementById('btnSave');
    var originalLabel = btn.innerHTML;
    btn.classList.remove('done');
    btn.classList.add('btn-saving');
    btn.innerHTML = 'Đang lưu…';

    gs('WA_updateGuestFields', currentGuest.maKM, updates).then(function () {
      btn.classList.add('done');
      btn.innerHTML = '✅ Đã lưu — có thể thoát trang';
      showToast('Đã lưu ' + updates.length + ' trường thành công.');
      setTimeout(function () { selectGuest(currentGuest.maKM); }, 600);
    }).catch(function (err) {
      btn.classList.remove('btn-saving', 'done');
      btn.innerHTML = originalLabel;
      showError('saveError', err);
      document.getElementById('saveError').scrollIntoView({behavior:'smooth', block:'center'});
    });
  }

