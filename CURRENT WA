// CÙNG MỘT HÀNG = MỘT CẶP. Muốn "Bà" đi được với cả "Ms." và "Mrs." thì ghi "Bà" ở 2 hàng.
function WA_getCapDanhXungTitle() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(WA_CONFIG.SHEET_SETUP);
  if (!sheet) return [];
  var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return [];
  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  var norm = function (v) { return (v === null || v === undefined ? '' : v).toString().replace(/\s+/g, ' ').trim(); };
  var cDx = -1, cTt = -1;
  values[0].forEach(function (h, i) {
    var t = norm(h).toLowerCase();
    if (t === 'danh xưng' && cDx === -1) cDx = i;
    if (t === 'title' && cTt === -1) cTt = i;
  });
  if (cDx === -1 || cTt === -1) return [];
  var out = [], seen = {};
  for (var r = 1; r < values.length; r++) {
    var dx = norm(values[r][cDx]), tt = norm(values[r][cTt]);
    if (!dx || !tt) continue;
    if (!seen[dx + '|' + tt]) { seen[dx + '|' + tt] = true; out.push([dx, tt]); }
  }
  return out;
}

// Chặn lưu hồ sơ nếu Danh xưng và Title không đúng cặp (tính cả giá trị đang có trên sheet).
function WA_kiemTraCapDanhXung_(sheet, map, rowIndex, updates) {
  var cDx = WA_firstCol_(map, WA_CONFIG.COL_DANHXUNG), cTt = WA_firstCol_(map, WA_CONFIG.COL_TITLE);
  if (!cDx || !cTt) return;
  var moi = {};
  updates.forEach(function (u) { moi[u.col] = u.value; });
  if (!(cDx in moi) && !(cTt in moi)) return;
  var dx = (cDx in moi) ? moi[cDx] : sheet.getRange(rowIndex, cDx).getValue();
  var tt = (cTt in moi) ? moi[cTt] : sheet.getRange(rowIndex, cTt).getValue();
  if (!WA_chuanHoaLoc_(dx) || !WA_chuanHoaLoc_(tt)) return;
  var hopLe = WA_getCapDanhXungTitle()
    .filter(function (p) { return WA_chuanHoaLoc_(p[0]) === WA_chuanHoaLoc_(dx); })
    .map(function (p) { return p[1]; });
  if (!hopLe.length) return;
  if (hopLe.some(function (t) { return WA_chuanHoaLoc_(t) === WA_chuanHoaLoc_(tt); })) return;
  throw new Error('Danh xưng "' + dx + '" phải đi với Title: ' + hopLe.join(' / ') + ' (đang chọn "' + tt + '"). Chưa lưu thay đổi nào.');
}
// ================== ĐỌC DROPDOWN TRỰC TIẾP TỪ DATA VALIDATION CỦA SHEET ==================
// Đọc đúng quy tắc "Xác thực dữ liệu" đang áp dụng tại ô mẫu (sampleRow) của cột (col).
// Hỗ trợ cả 2 kiểu: danh sách gõ cứng trong rule, và danh sách tham chiếu tới 1 vùng khác (VD: THIẾT LẬP FILE).
// Nếu ô không có validation (hoặc lỗi đọc) → trả về null để nơi gọi tự dùng danh sách dự phòng trong WA_CONFIG.
function WA_getColumnDropdownOptions_(sheet, sampleRow, col) {
  if (!sheet || !col) return null;
  try {
    var rule = sheet.getRange(sampleRow, col).getDataValidation();
    if (!rule) return null;
    var criteria = rule.getCriteriaType();
    var values = rule.getCriteriaValues();

    if (criteria === SpreadsheetApp.DataValidationCriteria.VALUE_IN_LIST) {
      return values[0]; // mảng string liệt kê trực tiếp trong rule
    }
    if (criteria === SpreadsheetApp.DataValidationCriteria.VALUE_IN_RANGE) {
      var srcRange = values[0]; // Range object, VD: THIẾT LẬP FILE!B2:B3721
      var flat = srcRange.getValues().reduce(function (a, r) { return a.concat(r); }, []);
      var seen = {}, out = [];
      flat.forEach(function (v) {
        var s = (v || '').toString().trim();
        if (s && !seen[s]) { seen[s] = true; out.push(s); }
      });
      return out;
    }
  } catch (e) {
    return null;
  }
  return null;
}

// Tiêu đề nhóm gộp không phải lúc nào cũng nằm ở dòng truyền vào: trên TEST, "ĐỢT 1 - THƯ SAVE
// THE DATE" nằm ở DÒNG 2 (ô gộp AK2:AN3) còn nhãn cột con ở dòng 4/5. Vì vậy nếu dòng chỉ định
// không có, hàm dò tiếp các dòng 1..5 rồi mới chịu thua.
function WA_findMergedGroupRange_(sheet, row, groupTitle) {
  var found = WA_findMergedGroupRangeTaiDong_(sheet, row, groupTitle);
  if (found) return found;
  for (var r = 1; r <= WA_CONFIG.HEADER_ROW_DATA_2; r++) {
    if (r === row) continue;
    found = WA_findMergedGroupRangeTaiDong_(sheet, r, groupTitle);
    if (found) return found;
  }
  return null;
}

function WA_findMergedGroupRangeTaiDong_(sheet, row, groupTitle) {
  var lastCol = sheet.getLastColumn();
  var range = sheet.getRange(row, 1, 1, lastCol);
  var values = range.getValues()[0];
  var merges = range.getMergedRanges();
  for (var i = 0; i < merges.length; i++) {
    var mr = merges[i];
    if (mr.getNumColumns() > 1) {
      var startCol = mr.getColumn();
      var text = (values[startCol - 1] || '').toString().replace(/\n/g, ' ').trim();
      if (text === groupTitle) {
        return { startCol: startCol, endCol: startCol + mr.getNumColumns() - 1 };
      }
    }
  }
  return null;
}

function WA_findColInRange_(labels, rangeInfo, targetLabel) {
  if (!rangeInfo) return null;
  for (var c = rangeInfo.startCol; c <= rangeInfo.endCol; c++) {
    if (labels[c - 1] === targetLabel) return c;
  }
  return null;
}

function WA_findRowByValue_(sheet, col, startRow, value) {
  var lastRow = sheet.getLastRow();
  if (lastRow < startRow) return -1;
  var values = sheet.getRange(startRow, col, lastRow - startRow + 1, 1).getValues();
  var target = value.toString().trim().toLowerCase();
  for (var i = 0; i < values.length; i++) {
    var v = values[i][0];
    if (v !== '' && v !== null && v.toString().trim().toLowerCase() === target) {
      return startRow + i;
    }
  }
  return -1;
}

// ================== THAM CHIẾU KHÁCH MỜI (REF) ==================
// Trước đây web chỉ mở được hồ sơ khi khách CÓ Mã KM. Dòng chưa kịp sinh mã thì bấm vào báo
// 'Không tìm thấy khách mời với Mã KM ""'. Nay mọi nơi (tra cứu, bộ lọc, thẻ phản hồi) đều dùng
// "ref": hoặc là Mã KM, hoặc là '#<số dòng>' khi khách chưa có mã. Cả hai đều mở & sửa được.
function WA_taoRef_(maKM, rowIndex) {
  maKM = (maKM === null || maKM === undefined) ? '' : maKM.toString().trim();
  return maKM || ('#' + rowIndex);
}

// Trả về số dòng trên TEST, hoặc -1. Thứ tự dò: #dòng -> Mã KM -> Full name -> Họ và tên.
function WA_giaiMaRef_(sheet, ref, map) {
  ref = (ref === null || ref === undefined) ? '' : ref.toString().trim();
  if (!ref) return -1;

  var startRow = WA_CONFIG.DATA_START_ROW;
  var lastRow = sheet.getLastRow();
  if (lastRow < startRow) return -1;

  if (ref.charAt(0) === '#') {
    var r = parseInt(ref.slice(1), 10);
    if (!r || r < startRow || r > lastRow) return -1;
    return r;
  }

  if (!map) map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2));
  var maKMCol = WA_firstCol_(map, WA_CONFIG.COL_MAKM);
  if (maKMCol) {
    var found = WA_findRowByValue_(sheet, maKMCol, startRow, ref);
    if (found !== -1) return found;
  }
  // Dự phòng: khách chưa có mã nhưng liên kết cũ lưu theo tên.
  var nameCols = [WA_firstCol_(map, WA_CONFIG.COL_FULLNAME), WA_firstCol_(map, WA_CONFIG.COL_HOTEN)].filter(Boolean);
  for (var i = 0; i < nameCols.length; i++) {
    var f = WA_findRowByValue_(sheet, nameCols[i], startRow, ref);
    if (f !== -1) return f;
  }
  return -1;
}

