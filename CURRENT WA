    .replace(/[\u200B-\u200D\u2060\uFEFF]/g, '').replace(/[\u00A0\u2007\u202F]/g, ' ')
    .replace(/^(tel|sđt|sdt|đt|dt|phone|mobile|mob|cell)\s*[:.]?\s*/i, '').trim();
  if (!t) return null;
  var cc = '', so = '', m, giaDinh = false;
  var gon = t.replace(/[\s.\-]/g, '');
  if ((m = t.match(/^\(\s*\+?\s*(\d{1,4})\s*\)\s*(.+)$/)) || (m = t.match(/^(?:\+|00)\s*(\d{1,4})[\s.\-]+(.+)$/))) {
    cc = m[1]; so = m[2];
  } else if ((m = gon.match(/^(?:\+|00)(\d+)$/))) {
    for (var n = 1; n <= 3 && !cc; n++) {
      if (WA_SDT_MA_QG.indexOf(m[1].slice(0, n)) !== -1) { cc = m[1].slice(0, n); so = m[1].slice(n); }
    }
    if (!cc) return { loi: '"' + t + '": không nhận ra mã quốc gia, hãy ghi dạng (+mã) số' };
  } else if (/^0\d/.test(gon)) {
    cc = '84'; so = gon; giaDinh = true;
  } else {
    return { loi: '"' + t + '": thiếu mã quốc gia, hãy ghi dạng (+84) 903123456' };
  }
  so = so.replace(/[\s.\-()]/g, '');
  if (!/^\d+$/.test(so)) return { loi: '"' + t + '": phần số chỉ được chứa chữ số' };
  if (cc !== '39') so = so.replace(/^0+/, '');
  if (so.length < 4 || cc.length + so.length > 15) return { loi: '"' + t + '": độ dài số không hợp lệ' };
  return { v: '(+' + cc + ') ' + so, cc: cc, so: so, giaDinh: giaDinh };
}
function WA_chuanHoaSdt_(raw) {
  var out = { vals: [], loi: [], giaDinh: [], giaTri: '' };
  String(raw === null || raw === undefined ? '' : raw)
    .split(/\r?\n|[;,\/|]|\s+(?:hoặc|hoac|or)\s+/i)
    .forEach(function (p) {
      var r = WA_chuanHoaMotSdt_(p);
      if (!r) return;
      if (r.loi) { out.loi.push(r.loi); return; }
      if (out.vals.indexOf(r.v) === -1) out.vals.push(r.v);
      if (r.giaDinh) out.giaDinh.push(p.trim());
    });
  out.giaTri = out.vals.join('\n');
  return out;
}
