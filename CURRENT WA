  // ---------- LƯU CHUNG cho cả "Phản hồi mới" và "Mail đang xử lý" ----------
  function saveReplyStatus(rowIndex, btnEl) {
    var entry = window.WA_MAIL_BY_ROW[rowIndex];
    var r = entry ? entry.data : null;
    var status = document.getElementById('status-' + rowIndex).value;
    var handler = document.getElementById('handler-' + rowIndex).value;
    var note = document.getElementById('note-' + rowIndex).value;
    var batch = window.WA_ACTIVE_BATCH[rowIndex] || '1';
    var phanHoiKhach = document.getElementById('phanhoi-' + rowIndex).value;
    var tienDoBtc = document.getElementById('btc-' + rowIndex).value;
    var errorId = (entry && entry.listKind === 'processing') ? 'processingError' : 'repliesError';

    if (status !== 'Mới' && !handler) {
      showError(errorId, 'Vui lòng chọn "Người xử lý" trước khi lưu trạng thái "' + status + '".');
      return;
    }

    // Cảnh báo nếu Người xử lý không thuộc đúng nhóm PIC hiện ghi trên hồ sơ khách.
    if (handler && r && r.pic && window.WA_PIC_GROUPS && window.WA_PIC_GROUPS[r.pic] && window.WA_PIC_GROUPS[r.pic].indexOf(handler) === -1) {
      var targetPic = '';
      Object.keys(window.WA_PIC_GROUPS).forEach(function (p) {
        if (!targetPic && window.WA_PIC_GROUPS[p].indexOf(handler) !== -1) targetPic = p;
      });
      window.WA_PENDING_SAVE = { rowIndex: rowIndex, status: status, handler: handler, note: note, batch: batch, phanHoiKhach: phanHoiKhach, tienDoBtc: tienDoBtc, btnEl: btnEl };
      document.getElementById('mismatchText').innerHTML =
        '<strong>' + escapeHtml(handler) + '</strong> không thuộc nhóm phụ trách <strong>' + escapeHtml(r.pic) + '</strong> của Mã KM ' + escapeHtml(r.maKM) + '.' +
        (targetPic ? ' Nếu tiếp tục, hệ thống sẽ đổi Phụ trách (PIC) của khách sang nhóm <strong>' + escapeHtml(targetPic) + '</strong>.' : '');
      document.getElementById('mismatchModal').classList.add('show');
      return;
    }

    doSaveReplyStatus(rowIndex, status, handler, note, batch, phanHoiKhach, tienDoBtc, errorId, btnEl);
  }

  function doSaveReplyStatus(rowIndex, status, handler, note, batch, phanHoiKhach, tienDoBtc, errorId, btnEl) {
    var originalLabel = btnEl ? btnEl.innerHTML : null;
    if (btnEl) { btnEl.disabled = true; btnEl.innerHTML = 'Đang lưu…'; }
    gs('WA_updateReplyStatus', rowIndex, status, handler, note, batch, phanHoiKhach, tienDoBtc).then(function () {
      showToast('Đã lưu');
      loadReplies();
      loadProcessing();
    }).catch(function (err) {
      if (btnEl) { btnEl.disabled = false; btnEl.innerHTML = originalLabel; }
      showError(errorId || 'repliesError', err);
    });
  }
  
  function resolveMismatch(confirmed) {
    document.getElementById('mismatchModal').classList.remove('show');
    var pending = window.WA_PENDING_SAVE;
    window.WA_PENDING_SAVE = null;
    if (!pending) return;
    if (confirmed) {
      var entry = window.WA_MAIL_BY_ROW[pending.rowIndex];
      var errorId = (entry && entry.listKind === 'processing') ? 'processingError' : 'repliesError';
      doSaveReplyStatus(pending.rowIndex, pending.status, pending.handler, pending.note, pending.batch, pending.phanHoiKhach, pending.tienDoBtc, errorId, pending.btnEl);
    } else {
      showToast('Đã huỷ, giữ nguyên Người xử lý cũ.');
    }
  }

