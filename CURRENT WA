// Đọc THIẾT LẬP FILE cột B (Nhân sự phụ trách / PIC) + C (Nhân sự hỗ trợ) THEO TỪNG HÀNG.
// Luôn đọc trực tiếp từ sheet mỗi lần gọi (không cache) vì danh sách này có thể đổi bất kỳ lúc nào.
// Trả về { "Nhật Minh": ["Nhật Minh","Tư Hân","Phương Lâm","Thanh Mai"], "Wendy": ["Wendy","Nhật Vy"], ... }
function WA_getPicGroupsFromSetupSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('THIẾT LẬP FILE');
  var groups = {};
  if (!sheet) return groups;

  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return groups;

  var values = sheet.getRange(2, 2, lastRow - 1, 2).getValues(); // B2:C(lastRow)
  values.forEach(function (row) {
    var pic = (row[0] || '').toString().trim();
    var support = (row[1] || '').toString().trim();
    if (!pic) return; // bỏ hàng trống cột B
    if (!groups[pic]) groups[pic] = [pic];
    if (support && groups[pic].indexOf(support) === -1) groups[pic].push(support);
  });
  return groups;
}

// Tìm PIC thật sự của 1 người (có thể là PIC hoặc nhân sự hỗ trợ) bằng cách quét groups.
// Trả về '' nếu không tìm thấy ở nhóm nào (tên lạ, gõ sai...).
function WA_findPicOfPerson_(name, groups) {
  name = (name || '').toString().trim();
  if (!name) return '';
  groups = groups || WA_getPicGroupsFromSetupSheet_();
  var found = '';
  Object.keys(groups).forEach(function (pic) {
    if (found) return;
    if (groups[pic].indexOf(name) !== -1) found = pic;
  });
  return found;
}

// Danh sách "Người xử lý" dạng phẳng (dùng cho chỗ nào chưa cần tách theo PIC) — build lại từ groups.
function WA_getHandlerOptionsFromSetupSheet_() {
  var groups = WA_getPicGroupsFromSetupSheet_();
  var seen = {}, names = [];
  Object.keys(groups).forEach(function (pic) {
    groups[pic].forEach(function (n) { if (!seen[n]) { seen[n] = true; names.push(n); } });
  });
  return names.length ? names : WA_CONFIG.OPT_NGUOI_XU_LY;
}

