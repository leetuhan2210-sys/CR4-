// Ghép ô "Ngày" + "Giờ" của DATA MAIL thành { key(ms), dateStr 'dd/MM/yyyy', timeStr 'HH:mm' }.
// Dùng displayValue cho ô Giờ vì ô time trong Sheets trả về Date gốc 30/12/1899 (lệch múi giờ LMT).
function WA_ghepNgayGio_(ngayVal, ngayDisp, gioVal, gioDisp, tz) {
  var key = 0, dateStr = '', timeStr = '';
  if (ngayVal instanceof Date) {
    dateStr = Utilities.formatDate(ngayVal, tz, 'dd/MM/yyyy');
    key = new Date(ngayVal.getFullYear(), ngayVal.getMonth(), ngayVal.getDate()).getTime();
  } else {
    dateStr = (ngayDisp || '').toString().trim();
    var p = dateStr.match(/(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{4})/);
    if (p) key = new Date(+p[3], +p[2] - 1, +p[1]).getTime();
  }
  var t = (gioDisp || '').toString().match(/(\d{1,2}):(\d{2})/);
  if (t) timeStr = ('0' + t[1]).slice(-2) + ':' + t[2];
  else if (gioVal instanceof Date) timeStr = ('0' + gioVal.getHours()).slice(-2) + ':' + ('0' + gioVal.getMinutes()).slice(-2);
  var tm = timeStr.match(/^(\d{2}):(\d{2})$/);
  if (tm && key) key += (+tm[1]) * 3600000 + (+tm[2]) * 60000;
  return { key: key, dateStr: dateStr, timeStr: timeStr };
}

// Bản đồ phản hồi NHẬN VỀ theo Mã KM — đọc DATA MAIL đúng 1 lần cho toàn bộ khách.
// { 'w3.1': { key, dateStr, timeStr, count, times: [ms,...] } }
function WA_getLatestIncomingMap_() {
  var out = {};
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var logSheet = ss.getSheetByName(WA_CONFIG.SHEET_LOG);
  if (!logSheet) return out;

  var headerRow = WA_CONFIG.HEADER_ROW_LOG;
  var lastRow = logSheet.getLastRow();
  if (lastRow <= headerRow) return out;

  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(logSheet, headerRow, null));
  var maKMCol  = WA_firstCol_(map, WA_CONFIG.LOG_COL_MAKM);
  var ngayCol  = WA_firstCol_(map, WA_CONFIG.LOG_COL_NGAY);
  var gioCol   = WA_firstCol_(map, WA_CONFIG.LOG_COL_GIO);
  var chieuCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_CHIEU);
  if (!maKMCol || !chieuCol || !ngayCol) return out;

  var cols = [maKMCol, ngayCol, gioCol, chieuCol].filter(Boolean);
  var minCol = Math.min.apply(null, cols), maxCol = Math.max.apply(null, cols);
  var range = logSheet.getRange(headerRow + 1, minCol, lastRow - headerRow, maxCol - minCol + 1);
  var values = range.getValues();
  var disp = range.getDisplayValues();
  var tz = Session.getScriptTimeZone();

  for (var i = 0; i < values.length; i++) {
    var row = values[i], drow = disp[i];
    var g = function (c) { return c ? row[c - minCol] : ''; };
    var d = function (c) { return c ? (drow[c - minCol] || '').toString() : ''; };

    var maKM = g(maKMCol).toString().trim();
    if (!maKM) continue;
    if (g(chieuCol).toString().trim() !== WA_CONFIG.DIR_INCOMING) continue;

    var info = WA_ghepNgayGio_(g(ngayCol), d(ngayCol), g(gioCol), d(gioCol), tz);
    var k = maKM.toLowerCase();
    if (!out[k]) out[k] = { key: 0, dateStr: '', timeStr: '', count: 0, times: [] };
    out[k].count++;
    out[k].times.push(info.key);
    if (info.key >= out[k].key) {
      out[k].key = info.key;
      out[k].dateStr = info.dateStr;
      out[k].timeStr = info.timeStr;
    }
  }
  return out;
}

function WA_getLatestIncomingReply_(maKM) {
  var empty = { dateStr: '', timeStr: '' };
  if (!maKM) return empty;
  var e = WA_getLatestIncomingMap_()[maKM.toString().trim().toLowerCase()];
  return e ? { dateStr: e.dateStr, timeStr: e.timeStr } : empty;
}

function WA_getGuestDetail(ref) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_DATA + '".');

  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var map = WA_buildHeaderMap_(labels);
  var col = function (name) { return WA_firstCol_(map, name); };

  var maKMCol = col(WA_CONFIG.COL_MAKM);
  if (!maKMCol) throw new Error('Không tìm thấy cột "MÃ KM".');

  var rowIndex = WA_giaiMaRef_(sheet, ref, map);
