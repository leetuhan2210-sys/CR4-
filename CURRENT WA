function WA_getUnclassifiedMail() {  
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_OTHER);
  if (!sheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_OTHER + '".');

  var headerRow = WA_timDongHeaderOther_(sheet);  
  var lastRow = sheet.getLastRow();
  if (lastRow <= headerRow) return [];

  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(sheet, headerRow, null));
  var threadCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_THREAD);
  var ngayCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_NGAY);
  var gioCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_GIO);
  var chieuCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_CHIEU);
  var senderEmailCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_SENDER_EMAIL);
  var senderNameCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_SENDER_NAME);
  var subjectCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_SUBJECT);
  var contentCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_CONTENT);
  var statusCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_STATUS);

  if (!threadCol || !statusCol) {
    throw new Error('Không tìm thấy cột "Thread ID" hoặc "Trạng thái xử lý" trong sheet "' + WA_CONFIG.SHEET_OTHER + '".');
  }

  var numRows = lastRow - headerRow;
  var readCols = [threadCol, ngayCol, gioCol, chieuCol, senderEmailCol, senderNameCol, subjectCol, contentCol, statusCol].filter(Boolean);
  var minCol = Math.min.apply(null, readCols);
  var maxCol = Math.max.apply(null, readCols);
  var values = sheet.getRange(headerRow + 1, minCol, numRows, maxCol - minCol + 1).getValues();

  var results = [];
  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var g = function (col) { return col ? row[col - minCol] : ''; };
    var direction = chieuCol ? g(chieuCol).toString() : '';
    var status = statusCol ? g(statusCol).toString().trim() : '';
    var isUnclassified = !status || status === WA_CONFIG.OTHER_STATUS_UNCLASSIFIED;
    
    if (direction !== WA_CONFIG.DIR_INCOMING || !isUnclassified) continue;

    var ngay = g(ngayCol), gio = g(gioCol);
    var dateStr = ngay instanceof Date ? Utilities.formatDate(ngay, Session.getScriptTimeZone(), 'dd/MM/yyyy') : ngay.toString();
    if (gio) dateStr += ' ' + (gio instanceof Date ? Utilities.formatDate(gio, Session.getScriptTimeZone(), 'HH:mm') : gio.toString());

    results.push({
      rowIndex: headerRow + 1 + i,
      threadId: threadCol ? g(threadCol).toString() : '',
      time: dateStr,
      senderEmail: senderEmailCol ? g(senderEmailCol).toString() : '',
      senderName: senderNameCol ? g(senderNameCol).toString() : '',
      subject: subjectCol ? g(subjectCol).toString() : '',
      content: contentCol ? g(contentCol).toString() : ''
    });
  }

  results.sort(function (a, b) { return b.rowIndex - a.rowIndex; });
  return results;
}

