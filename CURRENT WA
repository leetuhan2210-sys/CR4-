function WA_debugPrintHeaders() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  WA_printSheetHeaders_(ss, WA_CONFIG.SHEET_DATA, [WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2]);
  WA_printSheetHeaders_(ss, WA_CONFIG.SHEET_LOG, [WA_CONFIG.HEADER_ROW_LOG]);
  WA_printSheetHeaders_(ss, WA_CONFIG.SHEET_OTHER, [WA_CONFIG.HEADER_ROW_OTHER]);
}

function WA_printSheetHeaders_(ss, sheetName, headerRows) {
  Logger.log('=== SHEET "%s" (dòng tiêu đề: %s) ===', sheetName, headerRows.join(', '));
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    Logger.log('>>> KHÔNG TÌM THẤY sheet "%s" — kiểm tra lại tên trong WA_CONFIG.', sheetName);
    return;
  }
  var labels = headerRows.length > 1 
    ? WA_getCombinedHeaderLabels_(sheet, headerRows[0], headerRows[1])
    : WA_getCombinedHeaderLabels_(sheet, headerRows[0], null);
  for (var i = 0; i < labels.length; i++) {
    if (labels[i]) Logger.log('Cột %s (%s): "%s"', i + 1, WA_colLetter_(i + 1), labels[i]);
  }
}

function WA_colLetter_(col) {
  var letter = '';
  while (col > 0) {
    var rem = (col - 1) % 26;
    letter = String.fromCharCode(65 + rem) + letter;
    col = Math.floor((col - 1) / 26);
  }
  return letter;
}

// ================== HELPER DÙNG CHUNG ==================
function WA_getCombinedHeaderLabels_(sheet, primaryRow, secondaryRow) {
  var lastCol = sheet.getLastColumn();
  var primaryRange = sheet.getRange(primaryRow, 1, 1, lastCol);
  var primary = primaryRange.getValues()[0];
  var secondary = secondaryRow ? sheet.getRange(secondaryRow, 1, 1, lastCol).getValues()[0] : [];

  var isGroupTitleCol = {};
  primaryRange.getMergedRanges().forEach(function (mr) {
    if (mr.getNumColumns() > 1) {
      var startCol = mr.getColumn();
      var numCols = mr.getNumColumns();
      for (var c = startCol; c < startCol + numCols; c++) isGroupTitleCol[c] = true;
    }
  });

  var labels = [];
  for (var i = 0; i < lastCol; i++) {
    var col = i + 1;
    var p = (primary[i] || '').toString().replace(/\n/g, ' ').trim();
    var s = secondaryRow ? (secondary[i] || '').toString().replace(/\n/g, ' ').trim() : '';
    if (isGroupTitleCol[col]) {
      labels.push(s || p || '');
    } else {
      labels.push(p || s || '');
    }
  }
  return labels;
}

function WA_buildHeaderMap_(labels) {
  var map = {};
  for (var i = 0; i < labels.length; i++) {
    var text = labels[i];
    if (!text) continue;
    if (!map[text]) map[text] = [];
    map[text].push(i + 1);
  }
  return map;
}

function WA_firstCol_(map, name) {
  var arr = map[name];
  return (arr && arr.length) ? arr[0] : null;
}

