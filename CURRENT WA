// Thay thế WA_markReplySeen: cập nhật Trạng thái xử lý + Người xử lý + Ghi chú (ghi cả DATA MAIL và TEST)
function WA_updateReplyStatus(rowIndex, status, handler, note, batch, phanHoiKhach, tienDoBtc) {
  return TB_chayCoKhoa_('Lưu phản hồi', 30000, function () {
    return WA_updateReplyStatus_NoiBo_(rowIndex, status, handler, note, batch, phanHoiKhach, tienDoBtc);
  });
}

function WA_updateReplyStatus_NoiBo_(rowIndex, status, handler, note, batch, phanHoiKhach, tienDoBtc) {
  var validStatuses = WA_CONFIG.OPT_TRANG_THAI_MAIL;  
  if (validStatuses.indexOf(status) === -1) {
    throw new Error('Trạng thái không hợp lệ. Chỉ chấp nhận: ' + validStatuses.join(', '));
  }
  if (status !== WA_CONFIG.STATUS_NEW && (!handler || !handler.toString().trim())) {
    throw new Error('Vui lòng chọn "Người xử lý" trước khi lưu trạng thái "' + status + '".');
  }

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var logSheet = ss.getSheetByName(WA_CONFIG.SHEET_LOG);
  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(logSheet, WA_CONFIG.HEADER_ROW_LOG, null));
  var statusCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_STATUS);
  var handlerCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_HANDLER);
  var ghiChuCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_GHICHU);
  var maKMCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_MAKM);

  if (!statusCol) throw new Error('Không tìm thấy cột "' + WA_CONFIG.LOG_COL_STATUS + '".');

  var statusCell = logSheet.getRange(rowIndex, statusCol);
  statusCell.clearContent();
  statusCell.setValue(status);

  if (handlerCol && handler) {
    var handlerCell = logSheet.getRange(rowIndex, handlerCol);
    handlerCell.clearContent();
    handlerCell.setValue(handler.toString().trim());
  }

  // Đồng bộ PIC: nếu "Người xử lý" vừa chọn thuộc 1 nhóm PIC khác với "Phụ trách" đang ghi trên hồ sơ khách
  // (Mã KM) trong TEST, cập nhật lại cột "Phụ trách" của khách theo đúng nhóm mới.
  // Web app đã hỏi xác nhận phía client trước khi gọi hàm này, nên ở đây áp dụng luôn không hỏi lại.
  if (handlerCol && handler && maKMCol) {
    var maKMForPic = logSheet.getRange(rowIndex, maKMCol).getValue().toString().trim();
    if (maKMForPic) {
      var picGroups = WA_getPicGroupsFromSetupSheet_();
      var targetPic = WA_findPicOfPerson_(handler.toString().trim(), picGroups);
      if (targetPic) {
        var testSheetPic = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
        var testMapPic = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(testSheetPic, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2));
        var testMaKMColPic = WA_firstCol_(testMapPic, WA_CONFIG.COL_MAKM);
        var testPhuTrachCol = WA_firstCol_(testMapPic, WA_CONFIG.COL_PHUTRACH);
        var testRowPic = WA_findRowByValue_(testSheetPic, testMaKMColPic, WA_CONFIG.DATA_START_ROW, maKMForPic);
        if (testRowPic !== -1 && testPhuTrachCol) {
          var phuTrachCell = testSheetPic.getRange(testRowPic, testPhuTrachCol);
          var currentPic = (phuTrachCell.getValue() || '').toString().trim();
          if (currentPic !== targetPic) {
            phuTrachCell.clearContent();
            phuTrachCell.setValue(targetPic);
          }
        }
      }
    }
  }

  var dateStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM');

  if (note && note.toString().trim()) {
    var newLine = dateStr + ' - ' + note.toString().trim();

    // 1) Ghi vào DATA MAIL cột "Ghi chú" (S) — log riêng của dòng mail này
    if (ghiChuCol) {
      var ghiChuCell = logSheet.getRange(rowIndex, ghiChuCol);
      var oldGhiChu = ghiChuCell.getValue() ? ghiChuCell.getValue().toString().trim() : '';
      ghiChuCell.setValue(oldGhiChu ? (newLine + '\n' + oldGhiChu) : newLine);
    }

    // 2) Ghi độc lập vào TEST cột "Ghi chú" (AF) — ghi chú chung của khách mời
    if (maKMCol) {
      var maKMVal = logSheet.getRange(rowIndex, maKMCol).getValue().toString().trim();
      if (maKMVal) {
        var testSheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
        var testLabels = WA_getCombinedHeaderLabels_(testSheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
        var testMap = WA_buildHeaderMap_(testLabels);
        var testMaKMCol = WA_firstCol_(testMap, WA_CONFIG.COL_MAKM);
        var testGhiChuCol = WA_firstCol_(testMap, WA_CONFIG.COL_GHICHU);
        var testRow = WA_findRowByValue_(testSheet, testMaKMCol, WA_CONFIG.DATA_START_ROW, maKMVal);
        if (testRow !== -1 && testGhiChuCol) {
          var testCell = testSheet.getRange(testRow, testGhiChuCol);
          var oldTestVal = testCell.getValue() ? testCell.getValue().toString().trim() : '';
          testCell.setValue(oldTestVal ? (newLine + '\n' + oldTestVal) : newLine);
        }
      }
    }
  }

  // 3) Note tiến độ: ghi vào Đợt 1 (Phản hổi của Khách (1) / Tiến độ làm việc của BTC (1))
  //    hoặc Đợt 2 (Phản hồi của Khách (2) / Tiến độ làm việc của BTC (2)) tuỳ lựa chọn của user
  if (batch && ((phanHoiKhach && phanHoiKhach.toString().trim()) || (tienDoBtc && tienDoBtc.toString().trim()))) {
    var maKMValBatch = maKMCol ? logSheet.getRange(rowIndex, maKMCol).getValue().toString().trim() : '';
    if (maKMValBatch) {
      var testSheetBatch = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
      var testLabelsBatch = WA_getCombinedHeaderLabels_(testSheetBatch, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
      var testMapBatch = WA_buildHeaderMap_(testLabelsBatch);
      var testMaKMColBatch = WA_firstCol_(testMapBatch, WA_CONFIG.COL_MAKM);
      var testRowBatch = WA_findRowByValue_(testSheetBatch, testMaKMColBatch, WA_CONFIG.DATA_START_ROW, maKMValBatch);

      if (testRowBatch !== -1) {
        var groupName = (batch.toString() === '2') ? WA_CONFIG.GROUP_DOT2 : WA_CONFIG.GROUP_DOT1;
        var phanHoiLabel = (batch.toString() === '2') ? WA_CONFIG.DOT2_COL_PHANHOI_KHACH : WA_CONFIG.DOT1_COL_PHANHOI_KHACH;
        var btcLabel = (batch.toString() === '2') ? WA_CONFIG.DOT2_COL_TIENDO_BTC : WA_CONFIG.DOT1_COL_TIENDO_BTC;
        var groupRange = WA_findMergedGroupRange_(testSheetBatch, WA_CONFIG.HEADER_ROW_DATA_1, groupName);
        var phanHoiColBatch = WA_findColInRange_(testLabelsBatch, groupRange, phanHoiLabel);
        var btcColBatch = WA_findColInRange_(testLabelsBatch, groupRange, btcLabel);

        if (phanHoiColBatch && phanHoiKhach && phanHoiKhach.toString().trim()) {
          var pCell = testSheetBatch.getRange(testRowBatch, phanHoiColBatch);
          var pOld = pCell.getValue() ? pCell.getValue().toString().trim() : '';
          var pLine = dateStr + ' - ' + phanHoiKhach.toString().trim();
          pCell.setValue(pOld ? (pLine + '\n' + pOld) : pLine);
        }
        if (btcColBatch && tienDoBtc && tienDoBtc.toString().trim()) {
          var bCell = testSheetBatch.getRange(testRowBatch, btcColBatch);
          var bOld = bCell.getValue() ? bCell.getValue().toString().trim() : '';
          var bLine = dateStr + ' - ' + tienDoBtc.toString().trim();
          bCell.setValue(bOld ? (bLine + '\n' + bOld) : bLine);
        }
      }
    }
  }

  return { success: true };
}

