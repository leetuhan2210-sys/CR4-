    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var name = 'LỌC ' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM HH.mm.ss');
    var sheet = ss.insertSheet(name);

    var header = ['Mã KM', 'Dòng trên TEST', 'Họ tên', 'Chức vụ', 'Đơn vị', 'Email', 'SĐT', 'PIC',
      'Tiến độ Đợt 1', 'Phản hồi tham dự Đợt 1', 'Phản hồi của khách Đợt 1',
      'Tiến độ Đợt 2', 'Phản hồi tham dự Đợt 2', 'Phản hồi của khách Đợt 2',
      'Phản hồi gần nhất', 'Mail nhận trong khoảng', 'Tổng mail nhận',
      'Đối tượng', 'Phân loại', 'Đài thọ', 'Kênh mời', 'Quốc gia', 'Lĩnh vực', 'Sub-sector'];
    var body = res.rows.map(function (r) {
      return [r.maKM, r.rowIndex, r.hoTen, r.chucVu, r.donVi, r.email, r.sdt, r.pic,
        r.tienDo1, r.xacNhan1, r.phanHoi1,
        r.tienDo2, r.xacNhan2, r.phanHoi2,
        r.lastReply, r.replyInRange, r.replyTotal,
        r.doiTuong, r.phanLoai, r.daiTho ? 'Có' : '', r.kenhMoi, r.quocGia, r.linhVuc, r.subSector];
    });

    sheet.getRange(1, 1, 1, header.length).setValues([header])
      .setFontWeight('bold').setBackground('#1B4B43').setFontColor('#FFFFFF');
    sheet.getRange(2, 1, body.length, header.length).setValues(body);
    sheet.setFrozenRows(1);
    sheet.autoResizeColumns(1, header.length);

    return { success: true, sheetName: name, count: body.length, url: ss.getUrl() + '#gid=' + sheet.getSheetId() };
  });
}

