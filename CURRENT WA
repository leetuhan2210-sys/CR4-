function WA_search(query) {
  query = (query || '').toString().trim().toLowerCase();
  if (!query) return [];

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) return [];

  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var map = WA_buildHeaderMap_(labels);

  var maKMCol = WA_firstCol_(map, WA_CONFIG.COL_MAKM);
  var hoTenCol = WA_firstCol_(map, WA_CONFIG.COL_HOTEN);
  var fullNameCol = WA_firstCol_(map, WA_CONFIG.COL_FULLNAME);
  var emailCol = WA_firstCol_(map, WA_CONFIG.COL_EMAIL);
  var donViCol = WA_firstCol_(map, WA_CONFIG.COL_ORGANIZATION);
  var chucVuCol = WA_firstCol_(map, WA_CONFIG.COL_POSITION);

  var startRow = WA_CONFIG.DATA_START_ROW;
  var lastRow = sheet.getLastRow();
  var cols = [maKMCol, hoTenCol, fullNameCol, emailCol, donViCol, chucVuCol].filter(Boolean);
  var values = sheet.getRange(startRow, Math.min.apply(null, cols), lastRow - startRow + 1, Math.max.apply(null, cols) - Math.min.apply(null, cols) + 1).getValues();

  var exactMatches = [], allRecords = [];

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var get = function (col) { return col ? (row[col - Math.min.apply(null, cols)] || '') : ''; };
    var maKM = get(maKMCol), hoTen = get(fullNameCol) || get(hoTenCol);
    var email = get(emailCol), donVi = get(donViCol), chucVu = get(chucVuCol);

    if (!maKM && !hoTen) continue;
    var rowSo = startRow + i;
    var record = {
      maKM: maKM.toString(), ref: WA_taoRef_(maKM, rowSo), rowIndex: rowSo,
      hoTen: hoTen.toString(), chucVu: chucVu.toString(), donVi: donVi.toString(), email: email.toString()
    };
    var hay = (maKM + ' ' + hoTen + ' ' + email + ' ' + donVi + ' ' + chucVu).toString().toLowerCase();
    
    if (hay.indexOf(query) !== -1) {
      if (exactMatches.length < 30) exactMatches.push(record);
    } else {
      allRecords.push({ data: record, searchStr: hoTen.toString().toLowerCase() });
    }
  }

  if (exactMatches.length > 0) return exactMatches;

  var scoredRecords = allRecords.map(function(r) {
    return { record: r.data, score: WA_levenshteinDistance_(query, r.searchStr.substring(0, query.length)) };
  }).filter(function(r) { return r.score <= 4; }).sort(function(a, b) { return a.score - b.score; });

  return scoredRecords.slice(0, 5).map(function(r) {
    r.record.hoTen = "⚠️ Gợi ý: " + r.record.hoTen;
    return r.record;
  });
}

