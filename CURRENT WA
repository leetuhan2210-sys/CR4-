// Đọc toàn bộ danh sách ở THIẾT LẬP FILE: tiêu đề dòng 1 -> mảng giá trị của cột đó.
var WA_SETUP_CACHE_ = null;
function WA_getSetupLists_() {
  if (WA_SETUP_CACHE_) return WA_SETUP_CACHE_;
  WA_SETUP_CACHE_ = {};
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(WA_CONFIG.SHEET_SETUP);
  if (!sheet) return WA_SETUP_CACHE_;
  var lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return WA_SETUP_CACHE_;
  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  for (var c = 0; c < lastCol; c++) {
    var ten = (values[0][c] || '').toString().replace(/\s+/g, ' ').trim();
    if (!ten) continue;
    var seen = {}, list = [];
    for (var r = 1; r < lastRow; r++) {
      var v = (values[r][c] === null || values[r][c] === undefined) ? '' : values[r][c].toString().replace(/\s+/g, ' ').trim();
      if (v && !seen[v]) { seen[v] = true; list.push(v); }
    }
    if (list.length && !WA_SETUP_CACHE_[ten]) WA_SETUP_CACHE_[ten] = list;
  }
  return WA_SETUP_CACHE_;
}

// Danh sách Full name của khách đang có trên TEST (dùng cho cột "Thuộc nhóm KM chính của").
var WA_TEN_KM_CACHE_ = null;
function WA_getDanhSachTenKM_() {
  if (WA_TEN_KM_CACHE_) return WA_TEN_KM_CACHE_;
  WA_TEN_KM_CACHE_ = [];
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(WA_CONFIG.SHEET_DATA);
  if (!sheet) return WA_TEN_KM_CACHE_;
  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2));
  var col = WA_firstCol_(map, WA_CONFIG.COL_FULLNAME);
  var lastRow = sheet.getLastRow();
  if (!col || lastRow < WA_CONFIG.DATA_START_ROW) return WA_TEN_KM_CACHE_;
  var seen = {};
  sheet.getRange(WA_CONFIG.DATA_START_ROW, col, lastRow - WA_CONFIG.DATA_START_ROW + 1, 1).getValues()
    .forEach(function (r) {
      var v = (r[0] || '').toString().replace(/\s+/g, ' ').trim();
      if (v && !seen[v]) { seen[v] = true; WA_TEN_KM_CACHE_.push(v); }
    });
  return WA_TEN_KM_CACHE_;
}

// Trả về { options: [...], multi: bool } cho 1 tiêu đề cột của TEST, hoặc null nếu cột đó gõ tự do.
function WA_dropdownTheoTieuDe_(tieuDe) {
  var cfg = WA_DROPDOWN_MAP[(tieuDe || '').toString().replace(/\s+/g, ' ').trim()];
  if (!cfg) return null;
  var options = cfg.cotTen ? WA_getDanhSachTenKM_() : (WA_getSetupLists_()[cfg.list] || []);
  if (!options.length) return null;
  return { options: options, multi: !!cfg.multi };
}

// Danh sách tên Lĩnh vực + Sub-sector đã biết (THIẾT LẬP FILE), dùng để tách ô nhiều lựa chọn
// mà không cắt đôi tên có dấu phẩy. Đọc 1 lần mỗi lượt chạy.
var WA_LV_BIET_ = null;
function WA_lvBiet_() {
  if (WA_LV_BIET_) return WA_LV_BIET_;
  WA_LV_BIET_ = {};
  if (typeof NM_docBangLinhVuc_ !== 'function') return WA_LV_BIET_;
  try {
    var b = NM_docBangLinhVuc_();
    if (b && b.ok) b.sectors.concat(b.allSubs).forEach(function (x) { WA_LV_BIET_[WA_chuanHoaLoc_(x)] = true; });
  } catch (e) {}
  return WA_LV_BIET_;
}
function WA_tachThongMinh_(raw) {
  var p = (raw === null || raw === undefined ? '' : raw).toString().split(',')
    .map(function (x) { return x.replace(/\s+/g, ' ').trim(); }).filter(Boolean);
  var biet = WA_lvBiet_();
  if (!Object.keys(biet).length) return p;
  var dai = function (i) {
    for (var j = p.length; j > i; j--) if (biet[WA_chuanHoaLoc_(p.slice(i, j).join(', '))]) return j;
    return -1;
  };
  var out = [], i = 0;
  while (i < p.length) {
    var j = dai(i);
    if (j !== -1) { out.push(p.slice(i, j).join(', ')); i = j; continue; }
    var k = i + 1;
    while (k < p.length && dai(k) === -1) k++;
    out.push(p.slice(i, k).join(', '));
    i = k;
  }
  return out;
}
// Gộp giá trị nhiều lựa chọn theo đúng định dạng dropdown nhiều lựa chọn của Sheets: "A, B, C" (bỏ trùng).
function WA_gopDaGiaTri_(v) {
  var seen = {}, out = [];
  WA_tachThongMinh_(v).forEach(function (p) {
    var k = p.toLowerCase();
    if (p && !seen[k]) { seen[k] = true; out.push(p); }
  });
  return out.join(', ');
}

// Danh sách Lĩnh vực / Sub-sector chuẩn, đọc mới từ THIẾT LẬP FILE mỗi lần gọi (qua WA_getSectorMap).
function WA_optsLinhVuc_(key) {
  if (key !== 'linhVuc' && key !== 'subSector') return null;
  if (typeof WA_getSectorMap !== 'function') return null;
  try {
    var m = WA_getSectorMap();
    if (!m || !m.sectors) return null;
    if (key === 'linhVuc') return m.sectors.slice();
    var out = [], seen = {};
    m.sectors.forEach(function (s) {
      (m.subs[s] || []).forEach(function (x) { if (!seen[x]) { seen[x] = true; out.push(x); } });
    });
    return out;
  } catch (e) { return null; }
}

