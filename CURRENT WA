function WA_getNewReplies() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var logSheet = ss.getSheetByName(WA_CONFIG.SHEET_LOG);
  if (!logSheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_LOG + '".');

  var headerRow = WA_CONFIG.HEADER_ROW_LOG;
  var lastRow = logSheet.getLastRow();
  if (lastRow <= headerRow) return [];

  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(logSheet, headerRow, null));
  var maKMCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_MAKM);
  var ngayCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_NGAY);
  var gioCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_GIO);
  var chieuCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_CHIEU);
  var subjectCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_SUBJECT);
  var contentCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_CONTENT);
  var statusCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_STATUS);
  var handlerCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_HANDLER);
  var threadCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_THREAD);
  var senderNameCol = WA_firstCol_(map, WA_CONFIG.LOG_COL_SENDER_NAME);
  
  if (!maKMCol || !chieuCol || !statusCol) {
    throw new Error('Không tìm thấy cột "MÃ KM" / "Chiều" / "Trạng thái xử lý" trong sheet "' + WA_CONFIG.SHEET_LOG + '".');
  }

  var numRows = lastRow - headerRow;
  var readCols = [maKMCol, ngayCol, gioCol, chieuCol, subjectCol, contentCol, statusCol, handlerCol, threadCol, senderNameCol].filter(Boolean);  
  var minCol = Math.min.apply(null, readCols);
  var maxCol = Math.max.apply(null, readCols);
  var values = logSheet.getRange(headerRow + 1, minCol, numRows, maxCol - minCol + 1).getValues();

  var guestNames = WA_getGuestNameMap_();
  var batchLogsMap = WA_getBatchLogsMap_();
  var results = [];

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var g = function (col) { return col ? row[col - minCol] : ''; };
    var direction = g(chieuCol).toString();
    if (direction !== WA_CONFIG.DIR_INCOMING) continue;

    var status = statusCol ? g(statusCol).toString().trim() : '';
    var handlerVal = handlerCol ? g(handlerCol).toString().trim() : '';
    // Ẩn khỏi "Phản hồi mới" khi đã "Đã xử lý", HOẶC khi đã "Cần follow-up" VÀ đã có Người xử lý
    // (2 trường hợp đó chuyển sang tab "Mail đang xử lý" — xem WA_getMailDangXuLy()).
    if (status === WA_CONFIG.STATUS_PROCESSED) continue;
    if (status === WA_CONFIG.STATUS_FOLLOWUP && handlerVal) continue;

    var maKMVal = g(maKMCol).toString();
    var guest = guestNames[maKMVal.trim().toLowerCase()] || {};
    var ngay = g(ngayCol), gio = g(gioCol);
    var dateStr = ngay instanceof Date ? Utilities.formatDate(ngay, Session.getScriptTimeZone(), 'dd/MM/yyyy') : ngay.toString();
    if (gio) dateStr += ' ' + (gio instanceof Date ? Utilities.formatDate(gio, Session.getScriptTimeZone(), 'HH:mm') : gio.toString());

    results.push({
      rowIndex: headerRow + 1 + i,
      maKM: maKMVal,
      senderName: senderNameCol ? g(senderNameCol).toString() : '',
      hoTen: guest.hoTen || '',
      donVi: guest.donVi || '',
      kmChinh: guest.kmChinh || '',
      pic: guest.phuTrach || '',
      time: dateStr,
      subject: subjectCol ? g(subjectCol).toString() : '',
      content: contentCol ? g(contentCol).toString() : '',
      status: status || WA_CONFIG.STATUS_NEW,
      handler: handlerVal,
      threadId: threadCol ? g(threadCol).toString().trim() : '',
      batchLogs: batchLogsMap[maKMVal.trim().toLowerCase()] || WA_EMPTY_BATCH_LOGS_
    });    
  }

  results.sort(function (a, b) { return b.rowIndex - a.rowIndex; });
  return results;
}

