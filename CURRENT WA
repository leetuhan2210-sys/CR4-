function WA_ignoreMailBatch(threadIds) {
  if (!threadIds || !threadIds.length) throw new Error('Chưa chọn mail nào để bỏ qua.');

  var wanted = {};
  threadIds.forEach(function (id) {
    id = (id || '').toString().trim();
    if (id) wanted[id] = true;
  });
  var wantedList = Object.keys(wanted);
  if (!wantedList.length) throw new Error('Chưa chọn mail nào để bỏ qua.');

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_OTHER);
  if (!sheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_OTHER + '".');

  var headerRow = WA_CONFIG.HEADER_ROW_OTHER;
  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(sheet, headerRow, null));
  var threadCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_THREAD);
  var statusCol = WA_firstCol_(map, WA_CONFIG.OTHER_COL_STATUS);

  if (!threadCol || !statusCol) {
    throw new Error('Thiếu cột "Thread ID" / "Trạng thái xử lý" trong sheet "' + WA_CONFIG.SHEET_OTHER + '".');
  }

  var lastRow = sheet.getLastRow();
  var numRows = lastRow - headerRow;
  if (numRows <= 0) throw new Error('Sheet "' + WA_CONFIG.SHEET_OTHER + '" chưa có dữ liệu.');

  var threadValues = sheet.getRange(headerRow + 1, threadCol, numRows, 1).getValues();
  var statusRange = sheet.getRange(headerRow + 1, statusCol, numRows, 1);
  var statusValues = statusRange.getValues();

  var matched = {};
  var updated = 0;
  for (var i = 0; i < threadValues.length; i++) {
    var tid = (threadValues[i][0] || '').toString().trim();
    if (tid && wanted[tid]) {
      statusValues[i][0] = WA_CONFIG.OTHER_STATUS_IGNORED;
      matched[tid] = true;
      updated++;
    }
  }
  statusRange.setValues(statusValues);

  var notFound = wantedList.filter(function (id) { return !matched[id]; });
  return { success: true, updated: updated, notFound: notFound };
}

// ================== TÌM KIẾM MỜ (MINI LOOKUP & FUZZY) ==================
// Thuật toán Levenshtein đo khoảng cách chuỗi để gợi ý gõ sai
function WA_levenshteinDistance_(a, b) {
  if (a.length === 0) return b.length; 
  if (b.length === 0) return a.length; 
  var matrix = [];
  for (var i = 0; i <= b.length; i++) { matrix[i] = [i]; }
  for (var j = 0; j <= a.length; j++) { matrix[0][j] = j; }
  for (var i = 1; i <= b.length; i++) {
    for (var j = 1; j <= a.length; j++) {
      if (b.charAt(i - 1) === a.charAt(j - 1)) {
        matrix[i][j] = matrix[i - 1][j - 1];
      } else {
        matrix[i][j] = Math.min(matrix[i - 1][j - 1] + 1, Math.min(matrix[i][j - 1] + 1, matrix[i - 1][j] + 1));
      }
    }
  }
  return matrix[b.length][a.length];
}

// Hàm tìm kiếm Mini Lookup (hỗ trợ Fuzzy Search với 2 trường riêng biệt)
// Hàm tìm kiếm Mini Lookup (hỗ trợ Fuzzy Search song ngữ Anh - Việt)
function WA_miniLookup(nameQuery, orgQuery) {
  nameQuery = (nameQuery || '').toString().trim().toLowerCase();
  orgQuery = (orgQuery || '').toString().trim().toLowerCase();
  
  if (!nameQuery && !orgQuery) return { exact: [], fuzzy: [] };

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  var labels = WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2);
  var map = WA_buildHeaderMap_(labels);
  
  // Nạp index của cả cột tiếng Anh và tiếng Việt
  var maKMCol = WA_firstCol_(map, WA_CONFIG.COL_MAKM);
  var hoTenCol = WA_firstCol_(map, WA_CONFIG.COL_HOTEN);         // Tiếng Việt
  var fullNameCol = WA_firstCol_(map, WA_CONFIG.COL_FULLNAME);   // Tiếng Anh
  var donViCol = WA_firstCol_(map, WA_CONFIG.COL_DONVI);         // Tiếng Việt
  var orgCol = WA_firstCol_(map, WA_CONFIG.COL_ORGANIZATION);    // Tiếng Anh (Lưu ý config ghi là 'Organizagtion')
  
  var startRow = WA_CONFIG.DATA_START_ROW;
  var lastRow = sheet.getLastRow();
  
  var cols = [maKMCol, hoTenCol, fullNameCol, donViCol, orgCol].filter(Boolean);
  var minCol = Math.min.apply(null, cols);
  var maxCol = Math.max.apply(null, cols);
  var values = sheet.getRange(startRow, minCol, lastRow - startRow + 1, maxCol - minCol + 1).getValues();
  
  var exactMatches = [];
  var allRecords = [];

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var get = function(c) { return c ? (row[c - minCol] || '').toString() : ''; };
    
    var maKM = get(maKMCol);
    var nameVn = get(hoTenCol);
    var nameEn = get(fullNameCol);
    var orgVn = get(donViCol);
    var orgEn = get(orgCol);
    
    // Nếu cả mã KM và 2 tên đều trống thì bỏ qua
    if (!maKM && !nameVn && !nameEn) continue;
    
    // Ưu tiên hiển thị tiếng Anh, nếu trống mới hiển thị tiếng Việt
    var displayName = nameEn || nameVn || '(Không có tên)';
    var displayOrg = orgEn || orgVn || '(Không có tổ chức)';
    
    var record = { maKM: maKM, ref: WA_taoRef_(maKM, startRow + i), rowIndex: startRow + i, hoTen: displayName, donVi: displayOrg };

    // 1. Kiểm tra tìm kiếm chính xác (Match trên cả Anh và Việt)
    var matchName = true;
    var matchOrg = true;
    
    if (nameQuery) {
      matchName = (nameEn.toLowerCase().indexOf(nameQuery) !== -1) || 
                  (nameVn.toLowerCase().indexOf(nameQuery) !== -1) || 
                  (maKM.toLowerCase().indexOf(nameQuery) !== -1);
    }
    if (orgQuery) {
      matchOrg = (orgEn.toLowerCase().indexOf(orgQuery) !== -1) || 
                 (orgVn.toLowerCase().indexOf(orgQuery) !== -1);
    }
    
    if (matchName && matchOrg) {
      if (exactMatches.length < 10) exactMatches.push(record);
    } else {
      // 2. Lưu lại để xét tìm kiếm mờ nếu tìm chính xác không ra
      allRecords.push({
        data: record,
        nameEnStr: nameEn.toLowerCase(),
        nameVnStr: nameVn.toLowerCase(),
        orgEnStr: orgEn.toLowerCase(),
        orgVnStr: orgVn.toLowerCase()
      });
    }
  }

  // Nếu có kết quả chính xác, trả về ngay
  if (exactMatches.length > 0) return { exact: exactMatches, fuzzy: [] };

  // 3. Tìm kiếm mờ (Tính điểm cho cả bản Anh và Việt, lấy độ lệch tốt nhất)
  var scoredRecords = allRecords.map(function(r) {
    var scoreName = 0;
    var scoreOrg = 0;
    
    if (nameQuery) {
      var distEnName = WA_levenshteinDistance_(nameQuery, r.nameEnStr.substring(0, nameQuery.length));
      var distVnName = WA_levenshteinDistance_(nameQuery, r.nameVnStr.substring(0, nameQuery.length));
      scoreName = Math.min(distEnName, distVnName); // Lấy khoảng cách nhỏ nhất giữa tên Anh và tên Việt
    }
    
    if (orgQuery) {
      var distEnOrg = WA_levenshteinDistance_(orgQuery, r.orgEnStr.substring(0, orgQuery.length));
      var distVnOrg = WA_levenshteinDistance_(orgQuery, r.orgVnStr.substring(0, orgQuery.length));
      scoreOrg = Math.min(distEnOrg, distVnOrg); // Lấy khoảng cách nhỏ nhất giữa đơn vị Anh và Việt
    }
    
    return { record: r.data, score: scoreName + scoreOrg };
  });

  // Lọc lấy các kết quả có độ sai sót thấp (nhỏ hơn hoặc bằng 5)
  scoredRecords = scoredRecords.filter(function(r) { return r.score <= 5; });
  scoredRecords.sort(function(a, b) { return a.score - b.score; });

  var fuzzyMatches = scoredRecords.slice(0, 3).map(function(r) { return r.record; });
  return { exact: [], fuzzy: fuzzyMatches };
}

// ================== TAB BỘ LỌC ==================
// (Bản gộp: giữ toàn bộ tính năng bộ lọc đang chạy — đếm số khách mỗi lựa chọn, "(chưa điền)",
//  lọc thiếu liên hệ, gợi ý gỡ rối khi ra 0 kết quả, cache DATA MAIL, khách chưa có Mã KM (ref) —
//  và thêm: Sub-sector, phân trang 100 dòng, bảng sửa nhanh + lưu hàng loạt có chống ghi đè.)

// Chuẩn hoá trước khi so khớp: bỏ emoji và mọi ký tự không phải chữ/số, gộp khoảng trắng, hạ chữ thường.
// Nhờ vậy "❌ Chưa liên hệ" trong sheet vẫn khớp "Chưa liên hệ" và ngược lại.
function WA_chuanHoaLoc_(s) {
  return (s === null || s === undefined ? '' : s).toString()
    .replace(/[^\p{L}\p{N}]+/gu, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
}

// Dò cột trong 1 nhóm gộp theo 4 mức, dừng ở mức đầu tiên tìm thấy:
//   1) khớp nguyên văn nhãn  2) khớp sau chuẩn hoá (bỏ emoji/dấu/hoa-thường)
//   3) nhãn chứa đủ từ khoá bắt buộc và không chứa từ loại trừ
//   4) cột đầu tiên trong nhóm không thuộc nhóm nhãn đã biết (boQua)
function WA_timCotTheoNhan_(labels, rangeInfo, candidates, chuaTu, khongChuaTu, boQua) {
  if (!rangeInfo) return null;
  var i, c, s;

  for (i = 0; i < (candidates || []).length; i++) {
    c = WA_findColInRange_(labels, rangeInfo, candidates[i]);
    if (c) return c;
  }
  for (i = 0; i < (candidates || []).length; i++) {
    var target = WA_chuanHoaLoc_(candidates[i]);
    if (!target) continue;
    for (c = rangeInfo.startCol; c <= rangeInfo.endCol; c++) {
      if (WA_chuanHoaLoc_(labels[c - 1]) === target) return c;
    }
  }
  if (chuaTu && chuaTu.length) {
    for (c = rangeInfo.startCol; c <= rangeInfo.endCol; c++) {
      s = WA_chuanHoaLoc_(labels[c - 1]);
      if (!s) continue;
      var du = chuaTu.every(function (t) { return s.indexOf(WA_chuanHoaLoc_(t)) !== -1; });
      if (du && khongChuaTu && khongChuaTu.length) {
        du = !khongChuaTu.some(function (t) { return s.indexOf(WA_chuanHoaLoc_(t)) !== -1; });
      }
      if (du) return c;
    }
  }
  if (boQua && boQua.length) {
    for (c = rangeInfo.startCol; c <= rangeInfo.endCol; c++) {
      s = WA_chuanHoaLoc_(labels[c - 1]);
      if (!s) continue;
      if (!boQua.some(function (t) { return s.indexOf(WA_chuanHoaLoc_(t)) !== -1; })) return c;
    }
  }
  return null;
}

// Cột nhiều lựa chọn (chỉ AE - Phản hồi tham dự Save the day) mới được tách theo dấu phẩy.
// Các cột đơn trị KHÔNG tách: "3. Tổ chức Quốc tế, Định chế Quốc tế" là MỘT giá trị.
var WA_LOC_DA_GIATRI = { xacNhan1: true, linhVuc: 'lv', subSector: 'lv' };   // 'lv' = tách thông minh theo THIẾT LẬP FILE
// Lựa chọn giả trong dropdown bộ lọc để tìm đúng những khách CHƯA ĐIỀN cột đó.
var WA_LOC_TRONG = '(chưa điền)';

function WA_tachGiaTri_(cellValue, multi) {
  var raw = (cellValue === null || cellValue === undefined) ? '' : cellValue.toString().trim();
  if (!raw) return [];
  if (!multi) return [raw];
  if (multi === 'lv') return WA_tachThongMinh_(raw);
  return raw.split(',').map(function (s) { return s.trim(); }).filter(Boolean);  
}

function WA_khopDanhSach_(cellValue, selected, multi) {
  if (!selected || !selected.length) return true;
  var parts = WA_tachGiaTri_(cellValue, multi).map(WA_chuanHoaLoc_).filter(Boolean);
  var coTrong = selected.some(function (s) { return s === WA_LOC_TRONG; });
  if (!parts.length) return coTrong;                  // ô trống chỉ khớp khi chọn "(chưa điền)"
  for (var i = 0; i < selected.length; i++) {
    var s = WA_chuanHoaLoc_(selected[i]);
    if (!s) continue;
    if (parts.indexOf(s) !== -1) return true;
  }
  return false;
}

function WA_coChuoi_(cellValue, keyword) {
  return WA_chuanHoaLoc_(cellValue).indexOf(WA_chuanHoaLoc_(keyword)) !== -1;
}

function WA_rong_(v) { return !(v || '').toString().trim(); }

function WA_emailHopLe_(s) {
  var parts = (s || '').toString().split(/[,;\s]+/).filter(Boolean);
  if (!parts.length) return false;
  return parts.every(function (p) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(p); });
}

function WA_parseDateInput_(s, endOfDay) {
  s = (s || '').toString().trim();
  var m = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return 0;
  return endOfDay
    ? new Date(+m[1], +m[2] - 1, +m[3], 23, 59, 59).getTime()
    : new Date(+m[1], +m[2] - 1, +m[3], 0, 0, 0).getTime();
}

