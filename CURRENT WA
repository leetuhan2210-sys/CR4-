  function renderThread(data, containerId) {
    var el = document.getElementById(containerId || 'threadContent');
    el.className = ''; // gỡ class "spinner" (text-align:center) còn sót lại từ trạng thái "Đang tải...", nếu không toàn bộ nội dung thread bên dưới sẽ bị kế thừa canh giữa
    if (!data.threads || !data.threads.length) {
      el.innerHTML = '<div class="empty-state">Chưa có hội thoại mail nào được ghi nhận cho khách mời này.</div>';
      return;
    }
    el.innerHTML = '<p style="font-size:12.5px;color:var(--ink-soft);margin:0 0 12px">' + data.threads.length + ' thread riêng biệt được tìm thấy:</p>' +
      data.threads.map(function (t, idx) {
        var proxyTag = t.isProxy ? '<span class="tag-proxy">Trả lời qua liên hệ đại diện' + (t.proxyName ? ' — ' + escapeHtml(t.proxyName) : '') + (t.proxyRelation ? ' (' + escapeHtml(t.proxyRelation) + ')' : '') + '</span>' : '';
        var newTag = t.isNewThreadNotYetLinked ? '<span class="tag-newthread">Thread mới — cần lưu Mã Gmail</span>' : '';
        var msgsHtml = '<div class="chat-thread">' + t.messages.map(function (m) {
          var isIn = m.direction && m.direction.indexOf('Nhận') !== -1;
          var raw = (m.content || '').toString();
          var isLong = raw.length > 600;
          return '<div class="chat-row ' + (isIn ? 'in' : 'out') + '">' +
            '<div class="chat-bubble">' +
              '<div class="chat-meta">' +
                '<span class="dir">' + (isIn ? '↙ Nhận về' : '↗ Gửi đi') + '</span>' +
                '<span class="who">' + escapeHtml(m.senderName || m.senderEmail || '') + '</span>' +
                '<span>· ' + escapeHtml(m.dateStr || '') + '</span>' +
              '</div>' +
              '<div class="chat-body' + (isLong ? ' clamped' : '') + '">' + escapeHtml(raw) + '</div>' +
              (isLong ? '<button type="button" class="chat-more" onclick="toggleChatBody(this)">Xem thêm ▾</button>' : '') +
            '</div>' +
          '</div>';
        }).join('') + '</div>';        
        return '<div class="thread-block">' +
          '<button type="button" class="thread-head" onclick="toggleThreadBlock(this)">' +
            '<span class="thread-idx">Thread ' + (idx + 1) + '</span>' +
            '<span class="thread-meta"><div class="subject">' + escapeHtml(t.subject) + '</div>' + proxyTag + newTag + '</span>' +
            '<span class="thread-side">' + t.messages.length + ' tin &middot; ' + escapeHtml(t.lastActivityStr) + '</span>' +
          '</button>' +
          '<div class="thread-body">' +
            (t.gmailUrl ? '<div style="padding:10px 14px 4px"><a class="link" href="' + t.gmailUrl + '" target="_blank">Mở thread này trong Gmail ↗</a></div>' : '') +
            msgsHtml +
          '</div>' +
        '</div>';
      }).join('');
  }
 
