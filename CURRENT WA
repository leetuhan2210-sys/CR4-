function WA_getEmailThread(maKM) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var logSheet = ss.getSheetByName(WA_CONFIG.SHEET_LOG);
  if (!logSheet) throw new Error('Không tìm thấy sheet "' + WA_CONFIG.SHEET_LOG + '".');

  var headerRow = WA_CONFIG.HEADER_ROW_LOG;
  var lastRow = logSheet.getLastRow();
  if (lastRow <= headerRow) return WA_getEmailThreadFallbackFromGmail_(maKM);

  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(logSheet, headerRow, null));
  var c = function (name) { return WA_firstCol_(map, name); };

  var maKMCol = c(WA_CONFIG.LOG_COL_MAKM);
  var threadCol = c(WA_CONFIG.LOG_COL_THREAD);
  var ngayCol = c(WA_CONFIG.LOG_COL_NGAY);
  var gioCol = c(WA_CONFIG.LOG_COL_GIO);
  var chieuCol = c(WA_CONFIG.LOG_COL_CHIEU);
  var senderEmailCol = c(WA_CONFIG.LOG_COL_SENDER_EMAIL);
  var senderNameCol = c(WA_CONFIG.LOG_COL_SENDER_NAME);
  var subjectCol = c(WA_CONFIG.LOG_COL_SUBJECT);
  var contentCol = c(WA_CONFIG.LOG_COL_CONTENT);
  var khopCol = c(WA_CONFIG.LOG_COL_KHOP_EMAIL);
  var trangThaiKhopCol = c(WA_CONFIG.LOG_COL_TRANGTHAI_KHOP);
  var tenThayCol = c(WA_CONFIG.LOG_COL_TEN_THAY);
  var quanHeCol = c(WA_CONFIG.LOG_COL_QUANHE);

  if (!maKMCol) {
    throw new Error('Không tìm thấy cột "' + WA_CONFIG.LOG_COL_MAKM + '" trong sheet "' + WA_CONFIG.SHEET_LOG + '". Chạy WA_debugPrintHeaders() để kiểm tra.');
  }

  var numRows = lastRow - headerRow;
  var readCols = [maKMCol, threadCol, ngayCol, gioCol, chieuCol, senderEmailCol, senderNameCol, subjectCol, contentCol, khopCol, trangThaiKhopCol, tenThayCol, quanHeCol].filter(Boolean);
  var minCol = Math.min.apply(null, readCols);
  var maxCol = Math.max.apply(null, readCols);
  var values = logSheet.getRange(headerRow + 1, minCol, numRows, maxCol - minCol + 1).getValues();

  var target = maKM.toString().trim().toLowerCase();
  var threadMap = {};
  var threadOrder = [];

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var g = function (col) { return col ? row[col - minCol] : ''; };
    if (g(maKMCol).toString().trim().toLowerCase() !== target) continue;

    var tId = threadCol ? g(threadCol).toString().trim() : '';
    if (!tId) tId = '__no_thread_' + i;

    if (!threadMap[tId]) {
      threadMap[tId] = [];
      threadOrder.push(tId);
    }

    var ngay = g(ngayCol), gio = g(gioCol);
    var dateStr = '';
    var sortKey = 0;

    if (ngay instanceof Date) {
      dateStr = Utilities.formatDate(ngay, Session.getScriptTimeZone(), 'dd/MM/yyyy');
      sortKey = ngay.getTime();
    } else if (ngay) {
      dateStr = ngay.toString();
    }
    if (gio) {
      var gioStr = gio instanceof Date ? Utilities.formatDate(gio, Session.getScriptTimeZone(), 'HH:mm') : gio.toString();
      dateStr = (dateStr ? dateStr + ' ' : '') + gioStr;
      if (gio instanceof Date) sortKey += gio.getHours() * 3600000 + gio.getMinutes() * 60000;
    }

    threadMap[tId].push({
      dateStr: dateStr,
      sortKey: sortKey,
      direction: chieuCol ? g(chieuCol).toString() : '',
      senderEmail: senderEmailCol ? g(senderEmailCol).toString() : '',
      senderName: senderNameCol ? g(senderNameCol).toString() : '',
      subject: subjectCol ? g(subjectCol).toString() : '',
      content: contentCol ? g(contentCol).toString().substring(0, 3000) : '',
      matchStatus: trangThaiKhopCol ? g(trangThaiKhopCol).toString() : '',
      khopEmail: khopCol ? g(khopCol).toString() : '',
      proxyName: tenThayCol ? g(tenThayCol).toString() : '',
      relation: quanHeCol ? g(quanHeCol).toString() : ''
    });
  }

  if (!threadOrder.length) return WA_getEmailThreadFallbackFromGmail_(maKM);

  var threads = threadOrder.map(function (tId) {
    var msgs = threadMap[tId].slice().sort(function (a, b) { return a.sortKey - b.sortKey; });
    var first = msgs[0], last = msgs[msgs.length - 1];
    var proxyMsg = msgs.filter(function (m) {
      return m.proxyName || (m.matchStatus && m.matchStatus.indexOf('liên hệ thay') !== -1) || (m.khopEmail && m.khopEmail.indexOf('liên hệ thay') !== -1);
    })[0];
    var isNewThreadNotYetLinked = msgs.some(function (m) {
      return m.matchStatus && m.matchStatus.indexOf('thread mới') !== -1;
    });
    return {
      threadId: tId,
      subject: first.subject || last.subject || '(Không có chủ đề)',
      messages: msgs,
      lastActivitySort: last.sortKey,
      lastActivityStr: last.dateStr,
      isProxy: !!proxyMsg,
      proxyName: proxyMsg ? proxyMsg.proxyName : '',
      proxyRelation: proxyMsg ? proxyMsg.relation : '',
      isNewThreadNotYetLinked: isNewThreadNotYetLinked,
      gmailUrl: tId.indexOf('__no_thread_') === 0 ? '' : ('https://mail.google.com/mail/u/0/#all/' + tId)      
    };
  });

  threads.sort(function (a, b) { return b.lastActivitySort - a.lastActivitySort; });
  return { threads: threads };
}

function WA_getEmailThreadFallbackFromGmail_(maKM) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(WA_CONFIG.SHEET_DATA);
  var map = WA_buildHeaderMap_(WA_getCombinedHeaderLabels_(sheet, WA_CONFIG.HEADER_ROW_DATA_1, WA_CONFIG.HEADER_ROW_DATA_2));
  var maKMCol = WA_firstCol_(map, WA_CONFIG.COL_MAKM);
  var threadCol = WA_firstCol_(map, WA_CONFIG.COL_GMAIL_THREAD); 
  
  if (!maKMCol || !threadCol) return { threads: [] };

  var rowIndex = WA_findRowByValue_(sheet, maKMCol, WA_CONFIG.DATA_START_ROW, maKM);
  if (rowIndex === -1) return { threads: [] };

  var threadId = sheet.getRange(rowIndex, threadCol).getValue().toString().trim();
  if (!threadId) return { threads: [] };

  var thread;
  try { thread = GmailApp.getThreadById(threadId); } catch (e) { return { threads: [] }; }
  if (!thread) return { threads: [] };

  var messages = thread.getMessages().map(function (m) {
    return {
      dateStr: m.getDate().toLocaleString('vi-VN'),
      sortKey: m.getDate().getTime(),
      direction: m.isDraft() ? 'Nháp' : '',
      senderEmail: m.getFrom(),
      senderName: m.getFrom(),
      subject: m.getSubject(),
      content: m.getPlainBody().substring(0, 3000)
    };
  });

  return {
    threads: [{
      threadId: threadId,
      subject: messages.length ? messages[0].subject : '',
      messages: messages,
      lastActivitySort: messages.length ? messages[messages.length - 1].sortKey : 0,
      lastActivityStr: '',
      isProxy: false,
      proxyName: '',
      proxyRelation: '',
      isNewThreadNotYetLinked: false,
      gmailUrl: 'https://mail.google.com/mail/u/0/#all/' + threadId
    }]
  };
}

